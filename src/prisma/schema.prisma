// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id                       String                     @id @default(uuid())
  name                     String
  address                  String?
  accountNumber            String                     @unique
  penaltyPolicyTiers       PenaltyTier[]
  spaces                   Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                 User[]                     @relation("ManagedBuildings")
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime?                  @updatedAt
}

model Space {
  id                    String      @id @default(uuid())
  buildingId            String
  buildingName          String // Denormalized for convenience
  spaceIdName           String
  area                  Decimal     @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal     @db.Decimal(5, 4) // e.g., 0.0500 for 5%
  monthlyRentalPrice    Decimal     @db.Decimal(12, 2)
  isOccupied            Boolean     @default(false)
  tenantId              String?     @unique
  building              Building    @relation(fields: [buildingId], references: [id])
  tenant                Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements            Agreement[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime?   @updatedAt
}

model Tenant {
  id                  String      @id @default(uuid())
  name                String
  email               String      @unique
  phone               String?     @unique
  alternativePhone    String?
  nationalId          String?     @unique
  representativeName  String?
  representativePhone String?
  rentedSpaceId       String?     @unique
  rentedSpace         Space?
  agreements          Agreement[]
  bills               Bill[]
  user                User?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime?   @updatedAt
}

model Agreement {
  id                               String    @id @default(uuid())
  tenantId                         String
  spaceId                          String
  agreementText                    String
  startDate                        DateTime
  monthlyRentalPrice               Decimal   @db.Decimal(12, 2)
  additionalTerms                  String?
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime? @updatedAt
  paymentTermMonths                Int
  initialPaymentMonths             Int
  nextPaymentDueDate               DateTime
  initialPaymentAmount             Decimal?  @db.Decimal(14, 2)
  initialPaymentDate               DateTime?
  endDate                          DateTime?
  tenant                           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space                            Space     @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  bills                            Bill[]
}

model Bill {
  id                      String             @id @default(uuid())
  agreementId             String
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal            @db.Decimal(12, 2)
  utilityBreakdown        Json?
  penaltyAmount           Decimal?           @db.Decimal(10, 2)
  totalAmount             Decimal            @db.Decimal(14, 2)
  status                  BillStatus
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  bankOrWalletName        String?
  paymentProofUrl         String?
  adminVerifiedPayment    Boolean?
  tenantPaymentNotes      String?
  adminVerificationNotes  String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime?          @updatedAt
  agreement               Agreement          @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  arifPayments            ArifPayment[]
}

model BuildingMonthlyUtilities {
  id           String                  @id @default(uuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int
  building     Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  utilities    BuildingUtilityItem[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime?               @updatedAt

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String    @id @default(uuid())
  name                   String
  totalCost              Decimal   @db.Decimal(12, 2)
  appliesToScope         String // e.g., 'Building', 'Floor', 'SpecificSpaces'
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                       String        @id @default(uuid())
  buildingId               String
  fromDay                  Int
  toDay                    Int?
  penaltyType              PenaltyType // "Fixed" or "Percentage"
  frequency                FrequencyType // "OneTime" or "Daily"
  feeValue                 Decimal       @db.Decimal(10, 2)
  scope                    String // e.g., 'Building', 'Floor', 'SpecificSpaces'
  applicableFloor          String?
  applicableSpaceIdNames   String[]
  building                 Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model User {
  id               String      @id @default(uuid())
  userId           String      @unique // External ID from the identity provider (e.g., JWT 'sub' claim)
  email            String      @unique
  name             String?
  firstName        String
  lastName         String
  phoneNumber      String      @unique
  tempPassword     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime?   @updatedAt
  roles            Role[]
  managedBuildings Building[]  @relation("ManagedBuildings")
  tenant           Tenant?     @relation(fields: [tenantId], references: [id])
  tenantId         String?     @unique
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
}

// Stores encrypted secrets
model Secret {
  key   String @id
  value String
}

model AgreementTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArifPayment {
  id              String    @id @default(uuid())
  sessionId       String    @unique
  transactionId   String?
  status          String // e.g., 'Pending', 'Success', 'Failed'
  amount          Decimal   @db.Decimal(14, 2)
  paymentUrl      String
  billId          String
  createdAt       DateTime  @default(now())
  paymentMethod   String?
  bill            Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
}

enum BillStatus {
  Pending
  Paid
  Overdue
}

enum PenaltyType {
  Fixed
  Percentage
}

enum FrequencyType {
  OneTime
  Daily
}
