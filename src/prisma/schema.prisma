// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id                      String                    @id @default(cuid())
  name                    String
  address                 String?
  accountNumber           String                    @unique
  penaltyPolicyTiers      PenaltyTier[]
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                User[]                    @relation("BuildingManagers")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
}

model Space {
  id                      String         @id @default(cuid())
  buildingId              String
  buildingName            String
  spaceIdName             String
  area                    Decimal        @db.Decimal(10, 2)
  floor                   String
  utilityProrationShare   Decimal        @db.Decimal(5, 4) // e.g., 0.0150 for 1.50%
  monthlyRentalPrice      Decimal        @db.Decimal(10, 2)
  isOccupied              Boolean        @default(false)
  tenantId                String?        @unique
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  building                Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                  Tenant?
  agreements              Agreement[]
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String?
  alternativePhone    String?
  nationalId          String?     @unique
  representativeName  String?
  representativePhone String?
  userId              String?     @unique
  rentedSpaceId       String?     @unique
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  rentedSpace         Space?      @relation(fields: [rentedSpaceId], references: [id], onDelete: SetNull)
  agreements          Agreement[]
  bills               Bill[]
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Agreement {
  id                          String    @id @default(cuid())
  tenantId                    String
  spaceId                     String
  agreementText               String
  startDate                   DateTime
  endDate                     DateTime?
  monthlyRentalPrice          Decimal   @db.Decimal(10, 2)
  additionalTerms             String?
  paymentTermMonths           Int
  initialPaymentMonths        Int
  nextPaymentDueDate          DateTime
  initialPaymentAmount        Decimal?  @db.Decimal(12, 2)
  initialPaymentMethod        String?
  initialPaymentReference     String?
  initialPaymentBankOrWalletName String?
  initialPaymentDate          DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  tenant                      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space                       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  bills                       Bill[]
}

model Bill {
  id                       String                 @id @default(cuid())
  agreementId              String
  tenantId                 String
  billDate                 DateTime
  dueDate                  DateTime
  rentAmount               Decimal                @db.Decimal(10, 2)
  utilityBreakdown         Json?
  penaltyAmount            Decimal?               @db.Decimal(10, 2)
  totalAmount              Decimal                @db.Decimal(12, 2)
  status                   String // e.g., 'Pending', 'Paid', 'Overdue', 'PendingVerification'
  paymentDate              DateTime?
  paymentMethod            String? // e.g., 'Cash', 'Bank Transfer', 'ArifPay'
  paymentReference         String? // e.g., Transaction ID, Check No.
  bankOrWalletName         String?
  paymentProofUrl          String?
  adminVerifiedPayment     Boolean?
  tenantPaymentNotes       String?
  adminVerificationNotes   String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  agreement                Agreement              @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  arifPayments             ArifPayment[]
}

// Stores monthly utility costs for an entire building
model BuildingMonthlyUtilities {
  id           String                  @id @default(cuid())
  buildingId   String
  buildingName String // Denormalized for easier display
  year         Int
  month        Int // 0-11 for Jan-Dec
  utilities    BuildingUtilityItem[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  building     Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

// Represents a single utility item for a specific month
model BuildingUtilityItem {
  id                      String   @id @default(cuid())
  name                    String
  totalCost               Decimal  @db.Decimal(12, 2)
  appliesToScope          String // 'Building', 'Floor', or 'SpecificSpaces'
  applicableFloor         String?
  applicableSpaceIdNames  String[]
  monthlyUtilitiesId      String
  monthlyUtilities        BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                     String  @id @default(cuid())
  fromDay                Int
  toDay                  Int?
  feeType                String // 'Fixed' or 'Percentage'
  feeValue               Decimal @db.Decimal(10, 2) // Either a fixed amount or a percentage value
  scope                  String  // 'Building', 'Floor', or 'SpecificSpaces'
  applicableFloor        String?
  applicableSpaceIdNames String[]
  buildingId             String
  building               Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model User {
  id                  String      @id @default(cuid())
  userId              String      @unique // External ID from the identity provider
  email               String      @unique
  name                String
  firstName           String
  lastName            String
  phoneNumber         String?
  tempPassword        String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  roles               Role[]      @relation("UserRoles")
  managedBuildings    Building[]  @relation("BuildingManagers")
  tenants             Tenant[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
}

model Secret {
  key       String @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgreementTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArifPayment {
  id              String      @id @default(cuid())
  sessionId       String      @unique
  status          String      // e.g., 'Pending', 'Success', 'Failed'
  amount          Decimal     @db.Decimal(12, 2)
  transactionId   String?
  paymentMethod   String?
  paymentUrl      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  billId          String
  bill            Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)
}
