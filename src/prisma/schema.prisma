// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                @id @default(cuid())
  userId                  String                @unique // This is the external user ID from the identity provider (e.g., Auth0 sub)
  email                   String                @unique
  name                    String?
  firstName               String?
  lastName                String?
  phoneNumber             String?               @unique
  password                String?
  tempPassword            String?
  failedLoginAttempts     Int                   @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  roles                   Role[]
  managedBuildings        Building[]
  createdUsers            User[]                @relation("UserCreatedBy")
  createdBy               User?                 @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdById             String?
  createdTenants          Tenant[]              @relation("TenantCreatedBy")
  createdAgreementTemplates AgreementTemplate[] @relation("TemplateCreatedBy")
  DisabledAgreement       DisabledAgreement[]
  Tenant                  Tenant[]
}

model Role {
  id           String @id @default(cuid())
  name         String @unique // e.g., SUPER_ADMIN, PROPERTY_MANAGER, ACCOUNTANT
  description  String?
  permissions  String[]
  users        User[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    User?    @relation(fields: [createdById], references: [id])
  createdById  String?
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String      @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  status              TenantStatus @default(Active)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User?       @relation(fields: [userId], references: [id])
  userId              String?     @unique
  rentedSpace         Space?      @relation("TenantSpaces", fields: [rentedSpaceId], references: [id])
  rentedSpaceId       String?     @unique
  agreements          Agreement[]
  bills               Bill[]
  createdBy           User?       @relation("TenantCreatedBy", fields: [createdById], references: [id])
  createdById         String?
}

model Building {
  id                        String                     @id @default(cuid())
  name                      String                     @unique
  address                   String?
  accountNumber             String
  status                    BuildingStatus             @default(Active)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  spaces                    Space[]
  managers                  User[]
  penaltyPolicyTiers        PenaltyTier[]
  buildingMonthlyUtilities  BuildingMonthlyUtilities[]
}

model Space {
  id                    String      @id @default(cuid())
  buildingId            String
  buildingName          String
  spaceIdName           String
  area                  Decimal     @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal     @default(0) @db.Decimal(5, 4)
  monthlyRentalPrice    Decimal     @db.Decimal(12, 2)
  isOccupied            Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                Tenant?     @relation("TenantSpaces")
  agreements            Agreement[]

  @@unique([buildingId, spaceIdName])
}

model Agreement {
  id                    String      @id @default(cuid())
  tenantId              String
  spaceId               String
  agreementText         String      @db.Text
  startDate             DateTime
  monthlyRentalPrice    Decimal     @db.Decimal(12, 2)
  additionalTerms       String?     @db.Text
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  paymentTermMonths     Int
  initialPaymentMonths  Int
  nextPaymentDueDate    DateTime
  initialPaymentAmount  Decimal?    @db.Decimal(12, 2)
  initialPaymentDate    DateTime?
  endDate               DateTime?
  tenant                Tenant      @relation(fields: [tenantId], references: [id])
  space                 Space       @relation(fields: [spaceId], references: [id])
  bills                 Bill[]
  disabledAgreements    DisabledAgreement[]

  @@index([tenantId])
  @@index([spaceId])
}

// Model to track which admin has disabled which agreement
model DisabledAgreement {
  agreementId  String
  disabledById String
  disabledAt   DateTime @default(now())
  agreement    Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  disabledBy   User      @relation(fields: [disabledById], references: [id], onDelete: Cascade)

  @@id([agreementId, disabledById])
}


model Bill {
  id                       String      @id @default(cuid())
  agreementId              String
  tenantId                 String
  billDate                 DateTime
  dueDate                  DateTime
  rentAmount               Decimal     @db.Decimal(12, 2)
  utilityBreakdown         Json?
  penaltyAmount            Decimal?    @db.Decimal(12, 2)
  totalAmount              Decimal     @db.Decimal(12, 2)
  status                   BillStatus  @default(Pending)
  paymentDate              DateTime?
  paymentMethod            String?
  paymentReference         String?
  paymentProofDataUri      String? // For storing payment proof as a data URI
  adminVerifiedPayment     Boolean     @default(false)
  tenantPaymentNotes       String?
  adminVerificationNotes   String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  agreement                Agreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                   Tenant      @relation(fields: [tenantId], references: [id])
  ArifPayment              ArifPayment[]

  @@index([agreementId])
  @@index([tenantId])
  @@index([status])
}

model BuildingMonthlyUtilities {
  id           String                 @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int // 0-11 for Jan-Dec
  utilities    BuildingUtilityItem[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  building     Building               @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String    @id @default(cuid())
  name                   String
  totalCost              Decimal   @db.Decimal(12, 2)
  appliesToScope         String    // "Building", "Floor", "SpecificSpaces"
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilities       BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
  monthlyUtilitiesId     String
}

model PenaltyTier {
  id                     String       @id @default(cuid())
  fromDay                Int
  toDay                  Int?
  penaltyType            PenaltyType  // "Fixed" or "Percentage"
  frequency              PenaltyFrequency @default(OneTime) // "OneTime" or "Daily"
  feeValue               Decimal      @db.Decimal(12, 2)
  scope                  PenaltyScope @default(Building) // "Building", "Floor", "SpecificSpaces"
  applicableFloor        String?
  applicableSpaceIdNames String[]
  building               Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId             String
}

model Secret {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model AgreementTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("TemplateCreatedBy", fields: [createdById], references: [id])
  createdById String
}

model ArifPayment {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  billId        String
  transactionId String?
  status        String   @default("Pending")
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bill          Bill     @relation(fields: [billId], references: [id])
}

enum TenantStatus {
  Active
  Inactive
}

enum BuildingStatus {
  Active
  Inactive
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyFrequency {
  OneTime
  Daily
}

enum PenaltyScope {
    Building
    Floor
    SpecificSpaces
}
