// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id                      String                    @id @default(cuid())
  name                    String
  address                 String?
  accountNumber           String                    @unique
  penaltyPolicyTiers      PenaltyTier[]
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                User[]                    @relation("BuildingManagers")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
}

model Space {
  id                      String                   @id @default(cuid())
  buildingId              String
  buildingName            String
  spaceIdName             String
  area                    Decimal                  @db.Decimal(10, 2)
  floor                   String
  utilityProrationShare   Decimal                  @db.Decimal(5, 4) // e.g., 0.1234 for 12.34%
  monthlyRentalPrice      Decimal                  @db.Decimal(12, 2)
  isOccupied              Boolean                  @default(false)
  tenantId                String?                  @unique
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  building                Building                 @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                  Tenant?
  agreements              Agreement[]
  availabilityDate        DateTime?
}


model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String
  phone               String
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  rentedSpaceId       String?     @unique
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  rentedSpace         Space?      @relation(fields: [rentedSpaceId], references: [id], onDelete: SetNull)
  agreements          Agreement[]
  bills               Bill[]
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId              String?     @unique
}


model Agreement {
  id                           String    @id @default(cuid())
  tenantId                     String
  spaceId                      String
  agreementText                String
  startDate                    DateTime
  monthlyRentalPrice           Decimal   @db.Decimal(12, 2)
  additionalTerms              String?
  paymentTermMonths            Int
  initialPaymentMonths         Int
  nextPaymentDueDate           DateTime
  initialPaymentAmount         Decimal?  @db.Decimal(12, 2)
  initialPaymentMethod         String?
  initialPaymentReference      String?
  initialPaymentBankOrWalletName String?
  initialPaymentDate           DateTime?
  endDate                      DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  tenant                       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  space                        Space     @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  bills                        Bill[]
}

model Bill {
  id                      String               @id @default(cuid())
  agreementId             String
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal              @db.Decimal(12, 2)
  utilityBreakdown        Json?
  penaltyAmount           Decimal?             @db.Decimal(12, 2)
  totalAmount             Decimal              @db.Decimal(12, 2)
  status                  String               @default("Pending") // Pending, Paid, Overdue, PendingVerification
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  bankOrWalletName        String?
  paymentProofUrl         String?
  tenantPaymentNotes      String?
  adminVerifiedPayment    Boolean?             @default(false)
  adminVerificationNotes  String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  agreement               Agreement            @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BuildingMonthlyUtilities {
  id           String                  @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int // 0-11 for Jan-Dec
  utilities    BuildingUtilityItem[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  building     Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                      String                   @id @default(cuid())
  name                    String
  totalCost               Decimal                  @db.Decimal(12, 2)
  appliesToScope          String // Building, Floor, SpecificSpaces
  applicableFloor         String?
  applicableSpaceIdNames  String[]
  monthlyUtilitiesId      String?
  monthlyUtilities        BuildingMonthlyUtilities? @relation(fields: [monthlyUtilitiesId], references: [id])
}

model PenaltyTier {
  id                     String   @id @default(cuid())
  fromDay                Int
  toDay                  Int?
  feeType                String // Fixed, Percentage
  feeValue               Decimal  @db.Decimal(10, 2)
  scope                  String // Building, Floor, SpecificSpaces
  applicableFloor        String?
  applicableSpaceIdNames String[]
  buildingId             String
  building               Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model User {
  id               String     @id @default(cuid())
  userId           String     @unique // External ID from identity provider
  email            String     @unique
  name             String?
  firstName        String?
  lastName         String?
  phoneNumber      String?
  tempPassword     String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  roles            Role[]
  managedBuildings Building[] @relation("BuildingManagers")
  tenantProfile    Tenant?
}


model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
}

model Secret {
  key   String @id
  value String
}

model AgreementTemplate {
  id      String   @id @default(cuid())
  name    String   @unique
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArifPayment {
  id             String    @id @default(cuid())
  sessionId      String    @unique
  status         String // e.g., Pending, Success, Failed, Canceled
  amount         Float
  paymentUrl     String
  transactionId  String?
  paymentMethod  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  billId         String
  bill           Bill      @relation(fields: [billId], references: [id])
}
