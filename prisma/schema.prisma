// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String     @id @default(cuid())
  userId              String     @unique
  email               String     @unique
  name                String?
  firstName           String?
  lastName            String?
  phoneNumber         String?    @unique
  password            String?
  tempPassword        String?    @map("temporary_password")
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?

  roles          Role[]     @relation("UserRoles")
  createdRoles   Role[]     @relation("CreatedRoles")
  managedBuildings Building[]
  createdTenants Tenant[]   @relation("CreatedTenants")
  tenantProfile  Tenant?    @relation("TenantProfile")
  createdUsers   User[]     @relation("UserCreations")
  createdBy      User?      @relation("UserCreations", fields: [createdById], references: [id])
  createdById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("CreatedRoles", fields: [createdById], references: [id])
  createdById String?
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String?     @unique
  alternativePhone    String?
  nationalId          String?     @unique
  representativeName  String?
  representativePhone String?
  rentedSpace         Space?      @relation(fields: [rentedSpaceId], references: [id])
  rentedSpaceId       String?     @unique
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User?       @relation("TenantProfile", fields: [userId], references: [id])
  userId              String?     @unique
  agreements          Agreement[]
  bills               Bill[]
  createdBy           User?       @relation("CreatedTenants", fields: [createdById], references: [id])
  createdById         String?
}

enum BuildingStatus {
  Active
  Inactive
}

model Building {
  id                      String        @id @default(cuid())
  name                    String        @unique
  address                 String?
  accountNumber           String
  status                  BuildingStatus @default(Active)
  spaces                  Space[]
  penaltyPolicyTiers      PenaltyTier[]
  managers                User[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}

model Space {
  id                    String    @id @default(cuid())
  buildingId            String
  buildingName          String
  spaceIdName           String
  area                  Decimal   @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal   @default(0) @db.Decimal(5, 4)
  monthlyRentalPrice    Decimal   @db.Decimal(12, 2)
  isOccupied            Boolean   @default(false)
  tenantId              String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  building              Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements            Agreement[]

  @@unique([buildingId, spaceIdName])
}

model Agreement {
  id                      String    @id @default(cuid())
  tenantId                String
  spaceId                 String
  agreementText           String    @db.Text
  startDate               DateTime
  monthlyRentalPrice      Decimal   @db.Decimal(12, 2)
  additionalTerms         String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  paymentTermMonths       Int       @default(12)
  initialPaymentMonths    Int       @default(1)
  nextPaymentDueDate      DateTime
  initialPaymentAmount    Decimal?  @db.Decimal(12, 2)
  initialPaymentDate      DateTime?
  endDate                 DateTime?

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  space               Space               @relation(fields: [spaceId], references: [id])
  bills               Bill[]
  disabledAgreements  DisabledAgreement[]

  @@index([tenantId])
  @@index([spaceId])
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

model Bill {
  id                      String     @id @default(cuid())
  agreementId             String
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal    @db.Decimal(12, 2)
  utilityBreakdown        Json?
  penaltyAmount           Decimal?   @db.Decimal(12, 2)
  totalAmount             Decimal    @db.Decimal(12, 2)
  status                  BillStatus @default(Pending)
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  paymentProofUrl         String?
  paymentProofDataUri     String?    @db.Text
  adminVerifiedPayment    Boolean?
  tenantPaymentNotes      String?
  adminVerificationNotes  String?
  arifPayment             ArifPayment[]
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  agreement Agreement @relation(fields: [agreementId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([agreementId])
  @@index([tenantId])
  @@index([status])
}

model PenaltyTier {
  id                     String    @id @default(cuid())
  buildingId             String
  fromDay                Int
  toDay                  Int?
  penaltyType            String
  feeValue               Decimal   @db.Decimal(10, 2)
  scope                  String
  applicableFloor        String?
  applicableSpaceIdNames String[]
  frequency              String    @default("OneTime") // e.g., "OneTime", "Daily"

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

enum UtilityScope {
  Building
  Floor
  SpecificSpaces
}

model BuildingUtilityItem {
  id                     String       @id @default(cuid())
  name                   String
  totalCost              Decimal      @db.Decimal(12, 2)
  appliesToScope         UtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model BuildingMonthlyUtilities {
  id           String                @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int
  utilities    BuildingUtilityItem[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  building     Building              @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

model DisabledAgreement {
    id String @id @default(cuid())
    agreementId String
    disabledById String

    agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
    disabledBy User @relation(fields: [disabledById], references: [id], onDelete: Cascade)

    @@unique([agreementId, disabledById])
}


model Secret {
  key   String @unique
  value String
}

model AgreementTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
}

model ArifPayment {
  id             String    @id @default(cuid())
  sessionId      String    @unique
  billId         String
  status         String    @default("Pending") // Pending, Success, Failed
  transactionId  String?
  paymentMethod  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bill           Bill      @relation(fields: [billId], references: [id])

  @@index([billId])
}
