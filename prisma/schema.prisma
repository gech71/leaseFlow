
datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

// --- Enums ---

enum TenantStatus {
  Active
  Inactive
}

enum AgreementStatus {
  Active
  Canceled
}

enum BuildingStatus {
  Pending
  Active
  Rejected
  Inactive
}

// --- Models ---

model Building {
  id               String   @id @default(cuid())
  name             String   @unique
  address          String?
  accountNumber    String
  status           BuildingStatus @default(Pending)
  rejectionReason  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  spaces           Space[]
  penaltyPolicyTiers PenaltyTier[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  
  managers         User[]    @relation("ManagedBuildings")
  createdById      String?
  createdBy        User?     @relation("CreatedBuildings", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById     String?
  approvedBy       User?     @relation("ApprovedBuildings", fields: [approvedById], references: [id], onDelete: SetNull)
}

model Space {
  id                    String   @id @default(cuid())
  buildingId            String
  buildingName          String
  spaceIdName           String
  area                  Decimal  @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal  @db.Decimal(5, 4)
  monthlyRentalPrice    Decimal  @db.Decimal(12, 2)
  isOccupied            Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  building  Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  agreements Agreement[]

  // One-to-one relation with Tenant
  tenantId  String? @unique
  tenant    Tenant?
  
  @@unique([buildingId, spaceIdName])
}

model Tenant {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  phone               String   @unique
  alternativePhone    String?
  nationalId          String?  @unique
  representativeName  String?
  representativePhone String?
  status              TenantStatus @default(Active)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  userId      String? @unique
  user        User?   @relation("TenantProfile", fields: [userId], references: [id], onDelete: SetNull)

  agreements Agreement[]
  bills      Bill[]

  // One-to-one relation with Space
  rentedSpaceId String? @unique
  rentedSpace   Space?  @relation(fields: [rentedSpaceId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("CreatedTenants", fields: [createdById], references: [id], onDelete: SetNull)
}

model Agreement {
  id                   String      @id @default(cuid())
  tenantId             String
  spaceId              String
  agreementTemplateId  String
  agreementText        String      @db.Text
  startDate            DateTime
  monthlyRentalPrice   Decimal     @db.Decimal(12, 2)
  additionalTerms      String?     @db.Text
  paymentTermMonths    Int
  initialPaymentMonths Int
  nextPaymentDueDate   DateTime
  status               AgreementStatus @default(Active)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  
  initialPaymentAmount      Decimal? @db.Decimal(12, 2)
  initialPaymentDate        DateTime?

  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  space             Space           @relation(fields: [spaceId], references: [id])
  agreementTemplate AgreementTemplate @relation(fields: [agreementTemplateId], references: [id])
  bills             Bill[]
  arifPayments      ArifPayment[]
}

model AgreementTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String?
  createdBy   User?    @relation("CreatedTemplates", fields: [createdById], references: [id], onDelete: SetNull)
  Agreement   Agreement[]
}

model Bill {
  id                      String   @id @default(cuid())
  agreementId             String
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal  @db.Decimal(12, 2)
  utilityBreakdown        Json     @default("[]")
  penaltyAmount           Decimal? @db.Decimal(12, 2)
  totalAmount             Decimal  @db.Decimal(12, 2)
  status                  String   @default("Pending") // Pending, Paid, Overdue, PendingVerification
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  paymentProofDataUri     String?  @db.Text // Store base64 data URI
  adminVerifiedPayment    Boolean? @default(false)
  tenantPaymentNotes      String?
  adminVerificationNotes  String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  agreement Agreement @relation(fields: [agreementId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
}

model BuildingMonthlyUtilities {
  id           String   @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int // 0-11
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  building   Building            @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  utilities  BuildingUtilityItem[]
  
  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                      String   @id @default(cuid())
  name                    String
  totalCost               Decimal  @db.Decimal(12, 2)
  appliesToScope          String   // Building, Floor, SpecificSpaces
  applicableFloor         String?
  applicableSpaceIdNames  String[]
  perSpaceAllocation      String?  @db.Text // JSON string for percentage allocation on a floor
  
  monthlyUtilitiesId      String?
  monthlyUtilities        BuildingMonthlyUtilities? @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                      String   @id @default(cuid())
  fromDay                 Int
  toDay                   Int?
  penaltyType             String   // Fixed, Percentage
  frequency               String   // OneTime, Daily
  feeValue                Decimal  @db.Decimal(12, 2)
  scope                   String   // Building, Floor, SpecificSpaces
  applicableFloor         String?
  applicableSpaceIdNames  String[]
  
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  firstName       String?
  lastName        String?
  phoneNumber     String    @unique
  password        String?   // Hashed password
  tempPassword    String?   // Unhashed temporary password
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roles           Role[]
  createdById     String?
  createdBy       User?     @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers    User[]    @relation("CreatedBy")
  
  managedBuildings    Building[] @relation("ManagedBuildings")
  createdBuildings    Building[] @relation("CreatedBuildings")
  approvedBuildings   Building[] @relation("ApprovedBuildings")
  
  tenantProfile       Tenant?    @relation("TenantProfile")
  createdTenants      Tenant[]   @relation("CreatedTenants")
  createdRoles        Role[]     @relation("CreatedRoles")
  createdTemplates    AgreementTemplate[] @relation("CreatedTemplates")
}

model Role {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  permissions  String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  users        User[]
  
  createdById  String?
  createdBy    User?     @relation("CreatedRoles", fields: [createdById], references: [id], onDelete: SetNull)
}

model RateLimit {
  identifier      String   @id
  attempts        Int
  firstAttemptAt  DateTime
}

model ArifPayment {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  amount      Decimal  @db.Decimal(12, 2)
  status      String   @default("Pending") // Pending, Paid, Failed
  agreementId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agreement   Agreement @relation(fields: [agreementId], references: [id])
}
