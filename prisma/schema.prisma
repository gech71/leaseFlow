// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(cuid())
  email            String      @unique
  name             String?
  firstName        String?
  lastName         String?
  phoneNumber      String?     @unique
  password         String?
  tempPassword     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  roles            Role[]
  createdById      String?
  createdBy        User?       @relation("UserCreatesUser", fields: [createdById], references: [id])
  createdUsers     User[]      @relation("UserCreatesUser")
  managedBuildings Building[]  @relation("BuildingManagers")
  createdTenants   Tenant[]
  createdRoles     Role[]
  agreements       Agreement[] @relation("UserAgreements") // If user can also be a tenant
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
}

model Building {
  id              String    @id @default(cuid())
  name            String    @unique
  address         String?
  accountNumber   String
  status          BuildingStatus @default(Active)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  spaces          Space[]
  penaltyPolicyTiers PenaltyTier[]
  managers        User[]    @relation("BuildingManagers")
  createdById     String?
  createdBy       User?     @relation(fields: [createdById], references: [id])
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
}

model Space {
  id                    String    @id @default(cuid())
  buildingId            String
  buildingName          String
  spaceIdName           String
  area                  Decimal   @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal   @db.Decimal(5, 4)
  monthlyRentalPrice    Decimal   @db.Decimal(12, 2)
  isOccupied            Boolean   @default(false)
  tenantId              String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  building              Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements            Agreement[]
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String      @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  rentedSpaceId       String?     @unique
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User?       @relation(fields: [userId], references: [id])
  userId              String?     @unique
  rentedSpace         Space?
  agreements          Agreement[]
  bills               Bill[]
  createdById         String?
  createdBy           User?       @relation(fields: [createdById], references: [id])
}

model Agreement {
  id                      String      @id @default(cuid())
  tenantId                String
  spaceId                 String
  agreementText           String
  startDate               DateTime
  monthlyRentalPrice      Decimal     @db.Decimal(12, 2)
  additionalTerms         String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  paymentTermMonths       Int
  initialPaymentMonths    Int
  nextPaymentDueDate      DateTime
  initialPaymentAmount    Decimal?    @db.Decimal(12, 2)
  initialPaymentDate      DateTime?
  endDate                 DateTime?
  tenant                  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space                   Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  bills                   Bill[]
  user                    User?       @relation("UserAgreements", fields: [userId], references: [id])
  userId                  String?
  disabledAgreements      DisabledAgreement[]
}

model DisabledAgreement {
  agreementId String
  disabledById String
  disabledAt DateTime @default(now())

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@id([agreementId, disabledById])
}


model Bill {
  id                      String   @id @default(cduid())
  agreementId             String
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal  @db.Decimal(12, 2)
  utilityBreakdown        Json?
  penaltyAmount           Decimal? @db.Decimal(12, 2)
  totalAmount             Decimal  @db.Decimal(12, 2)
  status                  BillStatus @default(Pending)
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  paymentProofDataUri     String?
  adminVerifiedPayment    Boolean? @default(false)
  tenantPaymentNotes      String?
  adminVerificationNotes  String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  agreement               Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                  Tenant    @relation(fields: [tenantId], references  : [id], onDelete: Cascade)
  arifPayment             ArifPayment?
}

model BuildingMonthlyUtilities {
  id            String   @id @default(cuid())
  buildingId    String
  buildingName  String
  year          Int
  month         Int // 0-11 for Jan-Dec
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  utilities     BuildingUtilityItem[]
  building      Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                      String   @id @default(cuid())
  name                    String
  totalCost               Decimal  @db.Decimal(12, 2)
  appliesToScope          BuildingUtilityScope
  applicableFloor         String?
  applicableSpaceIdNames  String[]
  perSpacePercentages     Json? // For 'Floor' scope, stores { spaceId: percentage, ... }
  monthlyUtilitiesId      String
  monthlyUtilities        BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                     String      @id @default(cuid())
  fromDay                Int
  toDay                  Int?
  penaltyType            PenaltyType
  feeValue               Decimal     @db.Decimal(12, 2)
  buildingId             String
  scope                  PenaltyScope @default(Building)
  applicableFloor        String?
  applicableSpaceIdNames String[]
  frequency              PenaltyFrequency @default(OneTime)
  building               Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model Secret {
  key   String @id
  value String
}

model AgreementTemplate {
  id String @id @default(cuid())
  name String @unique
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
}

model ArifPayment {
  id String @id @default(cuid())
  sessionId String @unique
  amount Decimal
  status String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  billId String @unique
  bill Bill @relation(fields: [billId], references: [id])
}

model RateLimit {
  identifier String @id
  tokens     Int
  updatedAt  DateTime @updatedAt
}

enum BuildingStatus {
  Active
  Inactive
}

enum BuildingUtilityScope {
  Building
  Floor
  SpecificSpaces
}

enum PenaltyType {
  Fixed
  Percentage
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

enum PenaltyFrequency {
    OneTime
    Daily
}
