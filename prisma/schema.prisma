// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id                        String                     @id @default(cuid())
  name                      String                     @unique
  address                   String?
  accountNumber             String                     @unique
  status                    BuildingStatus             @default(Active)
  spaces                    Space[]
  buildingMonthlyUtilities  BuildingMonthlyUtilities[]
  penaltyPolicyTiers        PenaltyTier[]
  managers                  User[]                     @relation("ManagedBuildings")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime?                  @updatedAt
}

model Space {
  id                      String       @id @default(cuid())
  buildingId              String
  building                Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingName            String
  spaceIdName             String
  area                    Decimal      @db.Decimal(10, 2)
  floor                   String
  utilityProrationShare   Decimal      @db.Decimal(5, 4) // e.g., 0.05 for 5%
  monthlyRentalPrice      Decimal      @db.Decimal(12, 2)
  isOccupied              Boolean      @default(false)
  tenantId                String?      @unique
  tenant                  Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements              Agreement[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime?    @updatedAt

  @@unique([buildingId, spaceIdName])
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String      @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  rentedSpaceId       String?     @unique
  rentedSpace         Space?
  agreements          Agreement[]
  bills               Bill[]
  userId              String      @unique
  user                User        @relation(fields: [userId], references: [id])
  createdById         String?     // Nullable for tenants created before this field existed
  createdBy           User?       @relation("CreatedTenants", fields: [createdById], references: [id])
  createdAt           DateTime    @default(now())
  updatedAt           DateTime?   @updatedAt
}

model Agreement {
  id                   String                 @id @default(cuid())
  tenantId             String
  tenant               Tenant                 @relation(fields: [tenantId], references: [id])
  spaceId              String
  space                Space                  @relation(fields: [spaceId], references: [id])
  agreementText        String                 @db.Text
  startDate            DateTime
  monthlyRentalPrice   Decimal                @db.Decimal(12, 2)
  additionalTerms      String?                @db.Text
  paymentTermMonths    Int
  initialPaymentMonths Int
  nextPaymentDueDate   DateTime
  initialPaymentAmount Decimal?               @db.Decimal(12, 2)
  initialPaymentDate   DateTime?
  endDate              DateTime?
  bills                Bill[]
  disabledAgreements   DisabledAgreement[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime?              @updatedAt
}

model DisabledAgreement {
  id             String    @id @default(cuid())
  agreementId    String
  agreement      Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  disabledById   String
  disabledBy     User      @relation(fields: [disabledById], references: [id], onDelete: Cascade)
  disabledAt     DateTime  @default(now())

  @@unique([agreementId, disabledById])
}


model Bill {
  id                      String      @id @default(cuid())
  agreementId             String
  agreement               Agreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenantId                String
  tenant                  Tenant      @relation(fields: [tenantId], references: [id])
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal     @db.Decimal(12, 2)
  utilityBreakdown        Json        @default("[]")
  penaltyAmount           Decimal?    @db.Decimal(12, 2)
  totalAmount             Decimal     @db.Decimal(12, 2)
  status                  BillStatus  @default(Pending)
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  bankOrWalletName        String?
  paymentProofDataUri     String?     @db.Text
  adminVerifiedPayment    Boolean?
  tenantPaymentNotes      String?     @db.Text
  adminVerificationNotes  String?     @db.Text
  arifPayment             ArifPayment[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime?   @updatedAt
}

model BuildingMonthlyUtilities {
  id           String                 @id @default(cuid())
  buildingId   String
  building     Building               @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingName String
  year         Int
  month        Int // 0-11 for Jan-Dec
  utilities    BuildingUtilityItem[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime?              @updatedAt

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String                    @id @default(cuid())
  name                   String
  totalCost              Decimal                   @db.Decimal(12, 2)
  appliesToScope         UtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities  @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                      String        @id @default(cuid())
  fromDay                 Int
  toDay                   Int?
  penaltyType             PenaltyType
  feeValue                Decimal       @db.Decimal(10, 2)
  frequency               PenaltyFrequency
  scope                   PenaltyScope
  applicableFloor         String?
  applicableSpaceIdNames  String[]
  buildingId              String
  building                Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model User {
  id               String                 @id @default(cuid())
  userId           String                 @unique // From external auth provider
  email            String                 @unique
  name             String?
  firstName        String?
  lastName         String?
  phoneNumber      String?                @unique
  tempPassword     String?
  password         String?
  roles            Role[]
  managedBuildings Building[]             @relation("ManagedBuildings")
  createdTenants   Tenant[]               @relation("CreatedTenants")
  createdUsers     User[]                 @relation("CreatedBy")
  createdById      String?
  createdBy        User?                  @relation("CreatedBy", fields: [createdById], references: [id])
  createdRoles     Role[]                 @relation("CreatedRoles")
  createdAgreementTemplates AgreementTemplate[] @relation("CreatedTemplates")
  disabledAgreements      DisabledAgreement[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime?              @updatedAt
}

model Role {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  permissions String[]
  users       User[]
  createdById String?
  createdBy   User?     @relation("CreatedRoles", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
}

model Secret {
  key       String    @id
  value     String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model AgreementTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  content     String   @db.Text
  createdById String
  createdBy   User     @relation("CreatedTemplates", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ArifPayment {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  billId        String
  bill          Bill     @relation(fields: [billId], references: [id])
  status        String   @default("Pending") // Pending, Success, Failed
  transactionId String?
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


enum BuildingStatus {
  Active
  Inactive
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

enum TenantStatus {
  Active
  Inactive
}

enum UtilityScope {
  Building
  Floor
  SpecificSpaces
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyFrequency {
  OneTime
  Daily
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}
