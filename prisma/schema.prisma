
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BuildingStatus {
  Pending
  Active
  Rejected
  Inactive
}

model Building {
  id                      String                     @id @default(cuid())
  name                    String                     @unique
  address                 String?
  accountNumber           String
  status                  BuildingStatus             @default(Active)
  rejectionReason         String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  penaltyPolicyTiers      PenaltyTier[]
  createdById             String?
  createdBy               User?                      @relation("CreatedBuildings", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById            String?
  approvedBy              User?                      @relation("ApprovedBuildings", fields: [approvedById], references: [id], onDelete: SetNull)
  managers                User[]                     @relation("ManagedBuildings")
}

model Space {
  id                    String      @id @default(cuid())
  buildingId            String
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingName          String
  spaceIdName           String
  area                  Decimal     @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal     @db.Decimal(5, 4) // e.g. 0.05 for 5%
  monthlyRentalPrice    Decimal     @db.Decimal(12, 2)
  isOccupied            Boolean     @default(false)
  tenantId              String?     @unique
  tenant                Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  agreements            Agreement[]

  @@unique([buildingId, spaceIdName])
}

enum TenantStatus {
  Active
  Inactive
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String      @unique
  alternativePhone    String?
  nationalId          String?     @unique
  representativeName  String?
  representativePhone String?
  status              TenantStatus? @default(Active)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  userId              String?     @unique
  user                User?       @relation("TenantProfile", fields: [userId], references: [id], onDelete: SetNull)
  agreements          Agreement[]
  bills               Bill[]
  rentedSpaceId       String?     @unique
  rentedSpace         Space?      @relation(fields: [rentedSpaceId], references: [id], onDelete: SetNull)
  createdById         String?
  createdBy           User?       @relation("CreatedTenants", fields: [createdById], references: [id], onDelete: SetNull)
}

enum AgreementStatus {
  Active
  Canceled
}

model Agreement {
  id                         String             @id @default(cuid())
  tenantId                   String
  tenant                     Tenant             @relation(fields: [tenantId], references: [id])
  spaceId                    String
  space                      Space              @relation(fields: [spaceId], references: [id])
  agreementTemplateId        String
  agreementTemplate          AgreementTemplate  @relation(fields: [agreementTemplateId], references: [id])
  agreementText              String             @db.Text
  startDate                  DateTime
  paymentTermMonths          Int
  initialPaymentMonths       Int
  nextPaymentDueDate         DateTime
  monthlyRentalPrice         Decimal            @db.Decimal(12, 2)
  additionalTerms            String?            @db.Text
  status                     AgreementStatus    @default(Active)
  initialPaymentAmount       Decimal?           @db.Decimal(12, 2)
  initialPaymentDate         DateTime?
  endDate                    DateTime?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  bills                      Bill[]
  ArifPayment                ArifPayment[]
}

model Bill {
  id                       String               @id @default(cuid())
  agreementId              String
  agreement                Agreement            @relation(fields: [agreementId], references: [id])
  tenantId                 String
  tenant                   Tenant               @relation(fields: [tenantId], references: [id])
  billDate                 DateTime
  dueDate                  DateTime
  rentAmount               Decimal              @db.Decimal(12, 2)
  utilityBreakdown         Json?
  penaltyAmount            Decimal?             @db.Decimal(12, 2)
  totalAmount              Decimal              @db.Decimal(12, 2)
  status                   String // Pending, Paid, Overdue, PendingVerification
  paymentDate              DateTime?
  paymentMethod            String?
  paymentReference         String?
  bankOrWalletName         String?
  paymentProofDataUri      String?              @db.Text
  adminVerifiedPayment     Boolean?             @default(false)
  tenantPaymentNotes       String?
  adminVerificationNotes   String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  ArifPayment              ArifPayment[]
}

model BuildingMonthlyUtilities {
  id           String                @id @default(cuid())
  buildingId   String
  building     Building              @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingName String
  year         Int
  month        Int // 0-11
  utilities    BuildingUtilityItem[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String                    @id @default(cuid())
  name                   String
  totalCost              Decimal                   @db.Decimal(12, 2)
  appliesToScope         String // Building, Floor, SpecificSpaces
  applicableFloor        String?
  applicableSpaceIdNames String[]
  perSpaceAllocation     String? // JSON string for floor or space-specific allocations
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities  @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}

enum PenaltyFrequency {
  OneTime
  Daily
}

model PenaltyTier {
  id                     String           @id @default(cuid())
  buildingId             String
  building               Building         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  fromDay                Int
  toDay                  Int?
  penaltyType            PenaltyType
  frequency              PenaltyFrequency
  feeValue               Decimal          @db.Decimal(12, 2)
  scope                  PenaltyScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  name               String?
  firstName          String?
  lastName           String?
  phoneNumber        String       @unique
  password           String?
  tempPassword       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime?    @updatedAt
  roles              Role[]       @relation("UserRoles")
  createdRoles       Role[]       @relation("CreatedRoles")
  createdById        String?
  createdBy          User?        @relation("CreatedUsers", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers       User[]       @relation("CreatedUsers")
  approvedBuildings  Building[]   @relation("ApprovedBuildings")
  createdBuildings   Building[]   @relation("CreatedBuildings")
  managedBuildings   Building[]   @relation("ManagedBuildings")
  createdTenants     Tenant[]     @relation("CreatedTenants")
  tenantProfile      Tenant?      @relation("TenantProfile")
}

model Role {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  permissions  String[]
  users        User[]   @relation("UserRoles")
  createdById  String?
  createdBy    User?    @relation("CreatedRoles", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RateLimit {
  id             String   @id @default(cuid())
  identifier     String   @unique
  attempts       Int
  firstAttemptAt DateTime @default(now())
}

model AgreementTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  Agreement   Agreement[]
}
model ArifPayment {
  id            String @id @default(cuid())
  sessionId      String @unique
  amount        Decimal @db.Decimal(12, 2)
  billIDs       String[] // Array of bill IDs this payment covers
  status        String   // e.g., 'pending', 'completed', 'failed'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  agreementId   String
  agreement     Agreement @relation(fields: [agreementId], references: [id])
  billId        String
  bill          Bill      @relation(fields: [billId], references: [id])
}

