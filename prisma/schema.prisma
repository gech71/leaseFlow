
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String      @id @default(cuid())
  userId              String      @unique // This will store the external user ID from the auth provider
  email               String      @unique
  name                String
  firstName           String
  lastName            String
  phoneNumber         String      @unique
  password            String?
  tempPassword        String?
  failedLoginAttempts Int         @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  roles               Role[]      @relation("UserRoles")
  managedBuildings    Building[]
  createdTenants      Tenant[]    @relation("CreatedTenants")
  createdRoles        Role[]      @relation("CreatedRoles")
  createdByUser       User?       @relation("UserCreations", fields: [createdById], references: [id])
  createdById         String?
  createdUsers        User[]      @relation("UserCreations")
  createdAgreements   AgreementTemplate[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("CreatedRoles", fields: [createdById], references: [id])
  createdById String?
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String      @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User?       @relation("TenantProfile", fields: [userId], references: [id])
  userId              String?     @unique
  rentedSpace         Space?
  agreements          Agreement[]
  bills               Bill[]
  createdBy           User?       @relation("CreatedTenants", fields: [createdById], references: [id])
  createdById         String?
}

model Building {
  id                      String                     @id @default(cuid())
  name                    String                     @unique
  address                 String?
  accountNumber           String
  status                  BuildingStatus             @default(Active)
  penaltyPolicyTiers      PenaltyTier[]
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                User[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
}

model Space {
  id                    String      @id @default(cuid())
  buildingId            String
  buildingName          String
  spaceIdName           String
  area                  Decimal     @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal     @db.Decimal(5, 4)
  monthlyRentalPrice    Decimal     @db.Decimal(12, 2)
  isOccupied            Boolean     @default(false)
  tenantId              String?     @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements            Agreement[]

  @@unique([buildingId, spaceIdName])
}

model Agreement {
  id                          String      @id @default(cuid())
  tenantId                    String
  spaceId                     String
  agreementText               String      @db.Text
  startDate                   DateTime
  monthlyRentalPrice          Decimal     @db.Decimal(12, 2)
  additionalTerms             String?     @db.Text
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  paymentTermMonths           Int
  initialPaymentMonths        Int
  nextPaymentDueDate          DateTime
  initialPaymentAmount        Decimal?    @db.Decimal(12, 2)
  initialPaymentMethod        String?
  initialPaymentReference     String?
  initialPaymentBankOrWalletName String?
  initialPaymentDate          DateTime?
  endDate                     DateTime?
  tenant                      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space                       Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  bills                       Bill[]
  disabledAgreements          DisabledAgreement[]
}

model DisabledAgreement {
  id              String      @id @default(cuid())
  agreementId     String
  disabledById    String // This is a User ID
  disabledAt      DateTime    @default(now())
  agreement       Agreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  // No relation back to User needed here to avoid cluttering the User model

  @@unique([agreementId, disabledById])
}


model Bill {
  id                      String                 @id @default(cuid())
  agreementId             String
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal                @db.Decimal(12, 2)
  utilityBreakdown        Json?
  penaltyAmount           Decimal?               @db.Decimal(12, 2)
  totalAmount             Decimal                @db.Decimal(12, 2)
  status                  BillStatus             @default(Pending)
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  bankOrWalletName        String?
  paymentProofUrl         String? // For file path if stored locally
  paymentProofDataUri     String? @db.Text // For base64 encoded proof
  adminVerifiedPayment    Boolean?               @default(false)
  tenantPaymentNotes      String?                @db.Text
  adminVerificationNotes  String?                @db.Text
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  agreement               Agreement              @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  arifpayPayment          ArifPayment[]
}

model BuildingMonthlyUtilities {
  id           String                  @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int
  utilities    BuildingUtilityItem[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  building     Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String                    @id @default(cuid())
  name                   String
  totalCost              Decimal                   @db.Decimal(12, 2)
  appliesToScope         BuildingUtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities  @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                     String       @id @default(cuid())
  buildingId             String
  fromDay                Int
  toDay                  Int?
  penaltyType            PenaltyType
  feeValue               Decimal      @db.Decimal(10, 2)
  frequency              PenaltyFrequency
  scope                  PenaltyScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  building               Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

// Model for storing encrypted secrets like API keys, etc.
model Secret {
  key   String @id
  value String @db.Text
}

// Model for agreement templates
model AgreementTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  content     String   @db.Text
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Model for ArifPay transactions
model ArifPayment {
  id             String    @id @default(cuid())
  sessionId      String    @unique
  billId         String
  status         ArifPayStatus @default(Pending)
  transactionId  String?
  paymentMethod  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bill           Bill      @relation(fields: [billId], references: [id])
}

enum BuildingUtilityScope {
  Building
  Floor
  SpecificSpaces
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyFrequency {
    OneTime
    Daily
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}

enum TenantStatus {
  Active
  Inactive
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

enum ArifPayStatus {
  Pending
  Success
  Failed
  Cancelled
  Expired
}

enum BuildingStatus {
  Active
  Inactive
}

    