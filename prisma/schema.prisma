
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id                      String                    @id @default(cuid())
  name                    String
  address                 String?
  accountNumber           String                    @unique
  penaltyPolicyTiers      PenaltyTier[]
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime?                 @updatedAt
  managers                User[]                    @relation("BuildingManagers")
}

model Space {
  id                    String      @id @default(cuid())
  buildingId            String
  buildingName          String
  spaceIdName           String
  area                  Decimal
  floor                 String
  utilityProrationShare Decimal
  monthlyRentalPrice    Decimal
  isOccupied            Boolean     @default(false)
  tenantId              String?     @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime?   @updatedAt
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                Tenant?     @relation(fields: [tenantId], references: [id])
  agreements            Agreement[]
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String?     @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  userId              String      @unique
  rentedSpaceId       String?     @unique
  createdAt           DateTime    @default(now())
  updatedAt           DateTime?   @updatedAt
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rentedSpace         Space?      @relation(fields: [rentedSpaceId], references: [id])
  agreements          Agreement[]
  bills               Bill[]
  createdById         String?
  createdBy           User?       @relation("TenantCreator", fields: [createdById], references: [id])
}

model Agreement {
  id                 String     @id @default(cuid())
  tenantId           String
  spaceId            String
  agreementText      String
  startDate          DateTime
  monthlyRentalPrice Decimal
  additionalTerms    String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime?  @updatedAt
  paymentTermMonths  Int
  initialPaymentMonths Int
  nextPaymentDueDate DateTime
  initialPaymentAmount Decimal?
  initialPaymentDate DateTime?
  endDate            DateTime?
  tenant             Tenant     @relation(fields: [tenantId], references: [id])
  space              Space      @relation(fields: [spaceId], references: [id])
  bills              Bill[]
}

model Bill {
  id                     String    @id @default(cuid())
  agreementId            String
  tenantId               String
  billDate               DateTime
  dueDate                DateTime
  rentAmount             Decimal
  utilityBreakdown       Json?
  penaltyAmount          Decimal?
  totalAmount            Decimal
  status                 BillStatus
  paymentDate            DateTime?
  paymentMethod          String?
  paymentReference       String?
  bankOrWalletName       String?
  paymentProofUrl        String?
  adminVerifiedPayment   Boolean?
  tenantPaymentNotes     String?
  adminVerificationNotes String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime? @updatedAt
  agreement              Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                 Tenant    @relation(fields: [tenantId], references: [id])
  ArifPayment            ArifPayment[]
}

enum BillStatus {
  Pending
  Paid
  Overdue
}

model BuildingUtilityItem {
  id                     String   @id @default(cuid())
  name                   String
  totalCost              Decimal
  appliesToScope         String // Building, Floor, SpecificSpaces
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model BuildingMonthlyUtilities {
  id           String                  @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int
  utilities    BuildingUtilityItem[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime?               @updatedAt
  building     Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

model PenaltyTier {
  id                     String   @id @default(cuid())
  fromDay                Int
  toDay                  Int?
  penaltyType            String // Fixed, Percentage
  feeValue               Decimal
  frequency              String   @default("OneTime") // OneTime, Daily
  scope                  String // Building, Floor, SpecificSpaces
  applicableFloor        String?
  applicableSpaceIdNames String[]
  buildingId             String
  building               Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

// --- Auth and RBAC ---

model User {
  id            String    @id @default(cuid())
  userId        String    @unique // From external IdP
  email         String    @unique
  name          String?
  firstName     String?
  lastName      String?
  phoneNumber   String?
  tempPassword  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt
  
  roles         Role[]      @relation("UserRoles")
  createdRoles  Role[]      @relation("RoleCreator")
  createdTenants Tenant[]   @relation("TenantCreator")
  createdAgreementTemplates AgreementTemplate[] @relation("TemplateCreator")
  
  // This is the other side of the Building-User relation
  managedBuildings Building[] @relation("BuildingManagers")
}

model Role {
  id          String    @id @default(cuid())
  name        String
  description String?
  permissions String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  users       User[]    @relation("UserRoles")
  createdById String?
  createdBy   User?     @relation("RoleCreator", fields: [createdById], references: [id])
}

model Secret {
  key       String @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgreementTemplate {
  id String @id @default(cuid())
  name String @unique
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String?
  createdBy User? @relation("TemplateCreator", fields: [createdById], references: [id])
}

// Model for ArifPay payment sessions
model ArifPayment {
  id            String      @id @default(cuid())
  sessionId     String      @unique
  status        String      // Pending, Success, Failed
  amount        Decimal
  paymentUrl    String
  transactionId String?
  paymentMethod String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime?   @updatedAt
  billId        String      @unique // Each bill can have only one ArifPayment session
  bill          Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)
}
