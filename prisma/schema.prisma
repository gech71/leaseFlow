// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String              @id @default(cuid())
  userId                String              @unique // This is the external user ID (e.g., from the identity provider's sub claim)
  email                 String              @unique
  name                  String?
  firstName             String?
  lastName              String?
  phoneNumber           String?             @unique
  password              String?
  tempPassword          String?
  failedLoginAttempts   Int                 @default(0)
  lockedUntil           DateTime?
  roles                 Role[]              @relation("UserRoles")
  tenant                Tenant?             @relation("TenantProfile")
  createdTenants        Tenant[]            @relation("CreatedTenants")
  createdUsers          User[]              @relation("UserCreations")
  createdBy             User?               @relation("UserCreations", fields: [createdById], references: [id])
  createdById           String?
  managedBuildings      Building[]          @relation("BuildingManagers")
  disabledAgreements    DisabledAgreement[]
  createdAgreements     AgreementTemplate[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("CreatedRoles", fields: [createdById], references: [id])
}

model Tenant {
  id                    String        @id @default(cuid())
  name                  String
  email                 String        @unique
  phone                 String?       @unique
  alternativePhone      String?
  nationalId            String?       @unique
  representativeName    String?
  representativePhone   String?
  rentedSpaceId         String?       @unique
  rentedSpace           Space?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User?         @relation("TenantProfile", fields: [userId], references: [id])
  userId                String?       @unique
  agreements            Agreement[]
  bills                 Bill[]
  createdById           String?
  createdBy             User?         @relation("CreatedTenants", fields: [createdById], references: [id])
}

enum BuildingStatus {
  Active
  Inactive
}

model Building {
  id                      String                     @id @default(cuid())
  name                    String                     @unique
  address                 String?
  accountNumber           String
  status                  BuildingStatus             @default(Active)
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  penaltyPolicyTiers      PenaltyTier[]
  managers                User[]                     @relation("BuildingManagers")
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
}

model Space {
  id                    String        @id @default(cuid())
  buildingId            String
  buildingName          String // Denormalized for easier display
  spaceIdName           String
  area                  Decimal
  floor                 String
  utilityProrationShare Decimal       @default(0) // As a decimal, e.g., 0.1 for 10%
  monthlyRentalPrice    Decimal
  isOccupied            Boolean       @default(false)
  tenantId              String?       @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  building              Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements            Agreement[]

  @@unique([buildingId, spaceIdName])
}

model Agreement {
  id                    String              @id @default(cuid())
  tenantId              String
  spaceId               String
  agreementText         String              @db.Text
  startDate             DateTime
  monthlyRentalPrice    Decimal
  additionalTerms       String?
  paymentTermMonths     Int
  initialPaymentMonths  Int
  initialPaymentAmount  Decimal?
  initialPaymentDate    DateTime?
  nextPaymentDueDate    DateTime
  endDate               DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space                 Space               @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  bills                 Bill[]
  disabledAgreements    DisabledAgreement[]
}

// Model to handle soft-deactivation of agreements per admin user
model DisabledAgreement {
  id           String    @id @default(cuid())
  agreementId  String
  disabledById String
  agreement    Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  disabledBy   User      @relation(fields: [disabledById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@unique([agreementId, disabledById])
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

model Bill {
  id                      String      @id @default(cuid())
  agreementId             String
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal
  utilityBreakdown        Json?
  penaltyAmount           Decimal?
  totalAmount             Decimal
  status                  BillStatus  @default(Pending)
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  paymentProofUrl         String?
  paymentProofDataUri     String?     @db.Text
  tenantPaymentNotes      String?
  adminVerifiedPayment    Boolean     @default(false)
  adminVerificationNotes  String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  arifPayments            ArifPayment[]
  agreement               Agreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BuildingMonthlyUtilities {
  id           String                 @id @default(cuid())
  buildingId   String
  buildingName String // Denormalized for easier display
  year         Int
  month        Int // 0-11 for Jan-Dec
  utilities    BuildingUtilityItem[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  building     Building               @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

enum UtilityScope {
  Building
  Floor
  SpecificSpaces
}

model BuildingUtilityItem {
  id                     String                    @id @default(cuid())
  name                   String
  totalCost              Decimal
  appliesToScope         UtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities  @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyFrequency {
  OneTime
  Daily
}

model PenaltyTier {
  id                     String           @id @default(cuid())
  buildingId             String
  fromDay                Int
  toDay                  Int?
  penaltyType            PenaltyType
  frequency              PenaltyFrequency
  feeValue               Decimal
  scope                  UtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  building               Building         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model Secret {
  key   String @id
  value String @db.Text
}

model AgreementTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  content     String   @db.Text
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Model for ArifPay transactions
model ArifPayment {
  id             String    @id @default(cuid())
  billId         String
  sessionId      String    @unique
  paymentUrl     String?
  status         String    @default("Pending") // Pending, Success, Failed, Canceled, Expired
  transactionId  String?
  paymentMethod  String?
  amount         Decimal
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bill           Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
}
