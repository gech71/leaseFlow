// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(cuid())
  userId             String     @unique
  email              String     @unique
  name               String
  firstName          String
  lastName           String
  phoneNumber        String     @unique
  tempPassword       String?
  roles              Role[]
  managedBuildings   Building[]
  tenant             Tenant?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime?  @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
}

model Tenant {
  id                  String     @id @default(cuid())
  name                String
  email               String     @unique
  phone               String     @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  userId              String?    @unique
  user                User?      @relation(fields: [userId], references: [userId])
  rentedSpaceId       String?    @unique
  rentedSpace         Space?     @relation(fields: [rentedSpaceId], references: [id], onDelete: SetNull)
  agreements          Agreement[]
  bills               Bill[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime?  @updatedAt
}

model Building {
  id                        String                     @id @default(cuid())
  name                      String
  address                   String?
  managedByUserId           String?
  manager                   User?                      @relation(fields: [managedByUserId], references: [userId], onDelete: SetNull)
  spaces                    Space[]
  buildingMonthlyUtilities  BuildingMonthlyUtilities[]
  penaltyPolicyTiers        PenaltyTier[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime?                  @updatedAt
}

model Space {
  id                    String      @id @default(cuid())
  buildingId            String
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingName          String
  spaceIdName           String
  area                  Float
  floor                 String
  utilityProrationShare Float       @default(0)
  monthlyRentalPrice    Float
  isOccupied            Boolean     @default(false)
  tenantId              String?
  tenant                Tenant?
  agreements            Agreement[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime?   @updatedAt

  @@unique([buildingId, spaceIdName])
}

model Agreement {
  id                           String    @id @default(cuid())
  tenantId                     String
  tenant                       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaceId                      String
  space                        Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  agreementText                String
  startDate                    DateTime
  monthlyRentalPrice           Float
  paymentTermMonths            Int
  initialPaymentMonths         Int
  nextPaymentDueDate           DateTime
  endDate                      DateTime?
  additionalTerms              String?
  initialPaymentAmount         Float?
  initialPaymentMethod         String?
  initialPaymentReference      String?
  initialPaymentBankOrWalletName String?
  initialPaymentDate           DateTime?
  bills                        Bill[]
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime? @updatedAt
}

model Bill {
  id                       String                 @id @default(cuid())
  agreementId              String
  agreement                Agreement              @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenantId                 String
  tenant                   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billDate                 DateTime
  dueDate                  DateTime
  rentAmount               Float
  utilityBreakdown         Json                   @default("[]")
  penaltyAmount            Float?
  totalAmount              Float
  status                   BillStatus             @default(Pending)
  paymentDate              DateTime?
  paymentMethod            String?
  paymentReference         String?
  bankOrWalletName         String?
  paymentProofUrl          String?
  adminVerifiedPayment     Boolean?
  tenantPaymentNotes       String?
  adminVerificationNotes   String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime?              @updatedAt
}

model BuildingMonthlyUtilities {
  id           String                  @id @default(cuid())
  buildingId   String
  building     Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingName String
  year         Int
  month        Int
  utilities    BuildingUtilityItem[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime?               @updatedAt

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String                    @id @default(cuid())
  name                   String
  totalCost              Float
  appliesToScope         UtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities  @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                     String        @id @default(cuid())
  buildingId             String
  building               Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  fromDay                Int
  toDay                  Int?
  feeType                PenaltyFeeType
  feeValue               Float
  scope                  UtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
}

enum PenaltyFeeType {
  Fixed
  Percentage
}

enum UtilityScope {
  Building
  Floor
  SpecificSpaces
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}
