// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id                      String                    @id @default(cuid())
  name                    String                    @unique
  address                 String?
  accountNumber           String                    @unique
  penaltyPolicyTiers      PenaltyTier[]
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                User[]                    @relation("BuildingManagers")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
}

model Space {
  id                      String   @id @default(cuid())
  buildingId              String
  buildingName            String
  spaceIdName             String
  area                    Decimal  @db.Decimal(10, 2)
  floor                   String
  utilityProrationShare   Decimal  @db.Decimal(10, 5) // e.g., 0.05 for 5%
  monthlyRentalPrice      Decimal  @db.Decimal(10, 2)
  isOccupied              Boolean  @default(false)
  tenantId                String?  @unique
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  building                Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                  Tenant?     @relation("SpaceTenant", fields: [tenantId], references: [id], onDelete: SetNull)
  agreements              Agreement[]
}

model User {
  id               String     @id @default(cuid())
  userId           String     @unique // The external ID from the identity provider
  email            String     @unique
  name             String
  firstName        String?
  lastName         String?
  phoneNumber      String?
  tempPassword     String?    // To store the temporary password
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  roles            Role[]
  managedBuildings Building[] @relation("BuildingManagers")
  tenantProfile    Tenant?    @relation("UserTenant")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String?
  alternativePhone    String?
  nationalId          String?     @unique
  representativeName  String?
  representativePhone String?
  rentedSpaceId       String?     @unique
  userId              String?     @unique
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  rentedSpace         Space?      @relation("SpaceTenant")
  agreements          Agreement[]
  bills               Bill[]
  user                User?       @relation("UserTenant", fields: [userId], references: [id], onDelete: SetNull)
}

model Agreement {
  id                             String   @id @default(cuid())
  tenantId                       String
  spaceId                        String
  agreementText                  String   @db.Text
  startDate                      DateTime
  endDate                        DateTime?
  monthlyRentalPrice             Decimal  @db.Decimal(10, 2)
  additionalTerms                String?
  paymentTermMonths              Int
  initialPaymentMonths           Int
  nextPaymentDueDate             DateTime
  initialPaymentAmount           Decimal? @db.Decimal(10, 2)
  initialPaymentMethod           String?
  initialPaymentReference        String?
  initialPaymentBankOrWalletName String?
  initialPaymentDate             DateTime?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
  tenant                         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space                          Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  bills                          Bill[]
}

model Bill {
  id                      String    @id @default(cuid())
  agreementId             String
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal   @db.Decimal(10, 2)
  utilityBreakdown        Json      @default("[]")
  penaltyAmount           Decimal?  @db.Decimal(10, 2)
  totalAmount             Decimal   @db.Decimal(10, 2)
  status                  String    @default("Pending") // e.g., Pending, Paid, Overdue, PendingVerification
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  bankOrWalletName        String?
  paymentProofUrl         String?
  adminVerifiedPayment    Boolean?
  tenantPaymentNotes      String?
  adminVerificationNotes  String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  agreement               Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  arifPayments            ArifPayment[]

  @@index([status])
}

model BuildingMonthlyUtilities {
  id           String                  @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int
  utilities    BuildingUtilityItem[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  building     Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String   @id @default(cuid())
  name                   String
  totalCost              Decimal  @db.Decimal(10, 2)
  appliesToScope         String // "Building", "Floor", "SpecificSpaces"
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String?
  monthlyUtilities       BuildingMonthlyUtilities? @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                      String   @id @default(cuid())
  fromDay                 Int
  toDay                   Int?
  penaltyType             String   // "Fixed", "Percentage", "DailyPercentage"
  feeValue                Float
  scope                   String   // "Building", "Floor", or "SpecificSpaces"
  applicableFloor         String?
  applicableSpaceIdNames  String[]
  buildingId              String
  building                Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model Secret {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgreementTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArifPayment {
  id            String   @id @default(cuid())
  billId        String
  sessionId     String   @unique
  status        String // e.g., Pending, Success, Failed
  amount        Float
  paymentUrl    String
  transactionId String?
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bill          Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
}
