// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("CreatedRoles", fields: [createdById], references: [id])
  createdById String?
}

model User {
  id                    String                @id @default(cuid())
  userId                String                @unique // External ID, e.g., from an identity provider
  email                 String                @unique
  name                  String?
  firstName             String?
  lastName              String?
  phoneNumber           String?               @unique
  password              String?
  tempPassword          String?
  failedLoginAttempts   Int                   @default(0)
  lockedUntil           DateTime?
  roles                 Role[]                @relation("UserRoles")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  createdUsers          User[]                @relation("UserCreatedBy")
  createdBy             User?                 @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdById           String?
  tenants               Tenant[]
  managedBuildings      Building[]
  createdAgreementTemplates AgreementTemplate[] @relation("CreatedTemplates")
  createdRoles          Role[]                @relation("CreatedRoles")
  disabledAgreements    DisabledAgreement[]
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String?     @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  status              TenantStatus @default(Active)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User?       @relation(fields: [userId], references: [id])
  userId              String?     @unique
  rentedSpace         Space?      @relation("TenantSpace")
  agreements          Agreement[]
  bills               Bill[]
  createdBy           User?       @relation(fields: [createdById], references: [id])
  createdById         String?
}

enum TenantStatus {
  Active
  Inactive
  Pending
}

model Building {
  id                 String                      @id @default(cuid())
  name               String                      @unique
  address            String?
  accountNumber      String
  status             BuildingStatus              @default(Active)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  spaces             Space[]
  penaltyPolicyTiers PenaltyTier[]
  managers           User[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
}

enum BuildingStatus {
  Active
  Inactive
}


model Space {
  id                    String   @id @default(cuid())
  buildingId            String
  buildingName          String
  spaceIdName           String
  area                  Decimal  @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal  @db.Decimal(5, 4) // e.g., 0.05 for 5%
  monthlyRentalPrice    Decimal  @db.Decimal(12, 2)
  isOccupied            Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  building              Building @relation(fields: [buildingId], references: [id])
  tenant                Tenant?  @relation("TenantSpace", fields: [tenantId], references: [id])
  tenantId              String?  @unique
  agreements            Agreement[]

  @@unique([buildingId, spaceIdName])
}

model Agreement {
  id                   String              @id @default(cuid())
  tenantId             String
  spaceId              String
  agreementText        String              @db.Text
  startDate            DateTime
  monthlyRentalPrice   Decimal             @db.Decimal(12, 2)
  paymentTermMonths    Int
  initialPaymentMonths Int
  nextPaymentDueDate   DateTime
  additionalTerms      String?             @db.Text
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  initialPaymentAmount Decimal?            @db.Decimal(12, 2)
  initialPaymentDate   DateTime?
  endDate              DateTime?
  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  space                Space               @relation(fields: [spaceId], references: [id])
  bills                Bill[]
  disabledAgreements   DisabledAgreement[]
}

model DisabledAgreement {
  agreementId  String
  disabledById String
  assignedAt   DateTime @default(now())

  agreement    Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  disabledBy   User      @relation(fields: [disabledById], references: [id], onDelete: Cascade)

  @@id([agreementId, disabledById])
}


model Bill {
  id                      String      @id @default(cuid())
  agreementId             String
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal     @db.Decimal(12, 2)
  utilityBreakdown        Json?
  penaltyAmount           Decimal?    @db.Decimal(12, 2)
  totalAmount             Decimal     @db.Decimal(12, 2)
  status                  BillStatus  @default(Pending)
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  paymentProofUrl         String? // Storing an S3/GCS link for example
  paymentProofDataUri     String?     @db.Text
  adminVerifiedPayment    Boolean?
  tenantPaymentNotes      String?     @db.Text
  adminVerificationNotes  String?     @db.Text
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  agreement               Agreement   @relation(fields: [agreementId], references: [id])
  tenant                  Tenant      @relation(fields: [tenantId], references: [id])
  ArifPayment             ArifPayment[]
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

model ArifPayment {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  billId         String
  status         String
  transactionId  String?
  paymentMethod  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bill           Bill     @relation(fields: [billId], references: [id])
}


model BuildingMonthlyUtilities {
  id           String                  @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int // 0-11 for Jan-Dec
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  building     Building                @relation(fields: [buildingId], references: [id])
  utilities    BuildingUtilityItem[]

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String                    @id @default(cuid())
  name                   String
  totalCost              Decimal                   @db.Decimal(12, 2)
  appliesToScope         BuildingUtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities  @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

enum BuildingUtilityScope {
  Building
  Floor
  SpecificSpaces
}

model PenaltyTier {
  id                     String         @id @default(cuid())
  fromDay                Int
  toDay                  Int?
  penaltyType            PenaltyType
  feeValue               Decimal        @db.Decimal(12, 2)
  frequency              PenaltyFrequency
  scope                  BuildingUtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  buildingId             String
  building               Building       @relation(fields: [buildingId], references: [id])

  @@index([buildingId])
}

enum PenaltyType {
  Fixed
  Percentage
}
enum PenaltyFrequency {
  OneTime
  Daily
}

// Model for storing sensitive information like API keys, SMTP passwords, etc.
model Secret {
  key   String @id
  value String @db.Text
}

// Model for storing agreement templates
model AgreementTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("CreatedTemplates", fields: [createdById], references: [id])
  createdById String
}
