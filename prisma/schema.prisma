// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id                      String                    @id @default(uuid())
  name                    String
  address                 String?
  accountNumber           String                    @unique
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  penaltyPolicyTiers      PenaltyTier[]
  managers                User[]                    @relation("BuildingManagers")
}

model Space {
  id                    String      @id @default(uuid())
  buildingId            String
  buildingName          String // Denormalized for easier display
  spaceIdName           String
  area                  Decimal
  floor                 String
  utilityProrationShare Decimal     @default(0)
  monthlyRentalPrice    Decimal
  isOccupied            Boolean     @default(false)
  availabilityDate      DateTime?
  tenantId              String?     @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                Tenant?     @relation(fields: [tenantId], references: [id])
  agreements            Agreement[]

  @@index([buildingId])
}

model Tenant {
  id                  String      @id @default(uuid())
  name                String
  email               String
  phone               String?
  alternativePhone    String?
  nationalId          String?     @unique
  representativeName  String?
  representativePhone String?
  userId              String?     @unique // Link to the User model
  rentedSpaceId       String?     @unique
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  rentedSpace         Space?      @relation(fields: [rentedSpaceId], references: [id], onDelete: SetNull)
  agreements          Agreement[]
  bills               Bill[]
}

model Agreement {
  id                             String    @id @default(uuid())
  tenantId                       String
  spaceId                        String
  agreementText                  String    @db.Text
  startDate                      DateTime
  endDate                        DateTime?
  monthlyRentalPrice             Decimal
  additionalTerms                String?   @db.Text
  paymentTermMonths              Int
  initialPaymentMonths           Int
  nextPaymentDueDate             DateTime
  initialPaymentAmount           Decimal?
  initialPaymentMethod           String?
  initialPaymentReference        String?
  initialPaymentBankOrWalletName String?
  initialPaymentDate             DateTime?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
  tenant                         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space                          Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  bills                          Bill[]

  @@index([tenantId])
  @@index([spaceId])
}

model Bill {
  id                      String               @id @default(uuid())
  agreementId             String
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal
  utilityBreakdown        Json?
  penaltyAmount           Decimal?
  totalAmount             Decimal
  status                  BillStatus           @default(Pending)
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  bankOrWalletName        String?
  paymentProofUrl         String?
  adminVerifiedPayment    Boolean?             @default(false)
  tenantPaymentNotes      String?
  adminVerificationNotes  String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  agreement               Agreement            @relation(fields: [agreementId], references: [id], onDelete Cascade)
  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ArifPayment             ArifPayment[]
  
  @@index([agreementId])
  @@index([tenantId])
}

model BuildingMonthlyUtilities {
  id           String                  @id @default(uuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int
  utilities    BuildingUtilityItem[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  building     Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
  @@index([buildingId])
}

model BuildingUtilityItem {
  id                     String   @id @default(uuid())
  name                   String
  totalCost              Decimal
  appliesToScope         String // e.g., "Building", "Floor", "SpecificSpaces"
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                     String   @id @default(uuid())
  fromDay                Int
  toDay                  Int?
  feeType                String // "Fixed" or "Percentage"
  feeValue               Decimal
  scope                  String // "Building", "Floor", "SpecificSpaces"
  applicableFloor        String?
  applicableSpaceIdNames String[]
  buildingId             String
  building               Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId])
}

model User {
  id               String      @id @default(uuid())
  userId           String      @unique // This is the 'sub' from the external JWT
  email            String      
  name             String?
  firstName        String?
  lastName         String?
  phoneNumber      String?     
  tempPassword     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  roles            Role[]      @relation("UserRoles")
  managedBuildings Building[]  @relation("BuildingManagers")
  Tenant           Tenant[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
}

model Secret {
  key   String @id
  value String
}

model AgreementTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArifPayment {
  id             String    @id @default(uuid())
  sessionId      String    @unique
  transactionId  String?
  status         String    // e.g., 'Pending', 'Success', 'Failed'
  amount         Decimal
  paymentUrl     String
  billId         String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bill           Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
}


enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}
