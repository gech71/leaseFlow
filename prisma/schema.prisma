// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =================================
//        AUTHENTICATION
// =================================
model User {
  id               String      @id @default(cuid())
  userId           String      @unique // External ID from the identity provider (e.g., Auth0, Firebase Auth)
  email            String      @unique
  name             String?
  firstName        String?
  lastName         String?
  phoneNumber      String?     @unique
  tempPassword     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  roles            Role[]      @relation("UserRoles")
  managedBuildings Building[]  @relation("BuildingManagers")
  // Self-referencing relation to track who created this user
  createdBy        User?       @relation("CreatedUsers", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  createdUsers     User[]      @relation("CreatedUsers")
  createdTenants   Tenant[]    @relation("CreatedTenants")
  createdRoles     Role[]      @relation("CreatedRoles")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation to track who created the role
  createdBy   User?    @relation("CreatedRoles", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
}

// Stores encrypted secrets like API keys or passwords that shouldn't be in .env
model Secret {
  key   String @id
  value String
}

// =================================
//     CORE PROPERTY MANAGEMENT
// =================================

model Building {
  id                      String                    @id @default(cuid())
  name                    String
  address                 String?
  accountNumber           String                    @unique
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime?                 @updatedAt
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  penaltyPolicyTiers      PenaltyTier[]
  managers                User[]                    @relation("BuildingManagers")
}

model Space {
  id                    String      @id @default(cuid())
  buildingId            String
  buildingName          String // Denormalized for easier display
  spaceIdName           String // User-friendly ID, e.g., "Unit 101" or "Office 2B"
  area                  Decimal     @default(0)
  floor                 String
  utilityProrationShare Decimal     @default(0)
  monthlyRentalPrice    Decimal
  isOccupied            Boolean     @default(false)
  availabilityDate      DateTime?
  tenantId              String?     @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime?   @updatedAt
  tenant                Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  agreements            Agreement[]
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String?     @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  rentedSpaceId       String?     @unique
  userId              String      @unique // Link to the User model
  createdAt           DateTime    @default(now())
  updatedAt           DateTime?   @updatedAt
  user                User        @relation(fields: [userId], references: [userId], onDelete: Cascade)
  rentedSpace         Space?      @relation(fields: [rentedSpaceId], references: [id], onDelete: SetNull)
  agreements          Agreement[]
  bills               Bill[]

  createdBy   User?    @relation("CreatedTenants", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
}


model Agreement {
  id                  String     @id @default(cuid())
  tenantId            String
  spaceId             String
  agreementText       String     @db.Text
  startDate           DateTime
  monthlyRentalPrice  Decimal
  additionalTerms     String?    @db.Text
  createdAt           DateTime   @default(now())
  updatedAt           DateTime?  @updatedAt
  paymentTermMonths   Int
  initialPaymentMonths Int
  nextPaymentDueDate  DateTime
  initialPaymentAmount Decimal?
  initialPaymentDate  DateTime?
  endDate             DateTime?
  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space               Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  bills               Bill[]
}

model AgreementTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =================================
//        BILLING & UTILITIES
// =================================

model Bill {
  id                   String                 @id @default(cuid())
  agreementId          String
  tenantId             String
  billDate             DateTime
  dueDate              DateTime
  rentAmount           Decimal
  utilityBreakdown     Json?
  penaltyAmount        Decimal?
  totalAmount          Decimal
  status               BillStatus             @default(Pending)
  paymentDate          DateTime?
  paymentMethod        String?
  paymentReference     String?
  bankOrWalletName     String?
  paymentProofUrl      String?
  adminVerifiedPayment Boolean?
  tenantPaymentNotes   String?
  adminVerificationNotes String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime?              @updatedAt
  agreement            Agreement              @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  arifPayments         ArifPayment[]
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

model BuildingMonthlyUtilities {
  id           String                  @id @default(cuid())
  buildingId   String
  buildingName String // Denormalized name
  year         Int
  month        Int // 0-11 for Jan-Dec
  utilities    BuildingUtilityItem[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime?               @updatedAt
  building     Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String    @id @default(cuid())
  name                   String
  totalCost              Decimal
  appliesToScope         String // "Building", "Floor", "SpecificSpaces"
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String?
  monthlyUtilities       BuildingMonthlyUtilities? @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                     String   @id @default(cuid())
  fromDay                Int
  toDay                  Int?
  penaltyType            String // "Fixed" or "Percentage"
  feeValue               Decimal
  scope                  String // "Building", "Floor", "SpecificSpaces"
  applicableFloor        String?
  applicableSpaceIdNames String[]
  buildingId             String?
  frequency              String   @default("OneTime") // "OneTime" or "Daily"
  building               Building? @relation(fields: [buildingId], references: [id])
}

model ArifPayment {
  id             String    @id @default(cuid())
  billId         String
  sessionId      String    @unique
  status         String    // e.g., 'Pending', 'Success', 'Failed'
  amount         Decimal
  paymentUrl     String
  transactionId  String?
  paymentMethod  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bill           Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
}
