// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String              @id @default(cuid())
  userId                String              @unique
  name                  String?
  firstName             String?
  lastName              String?
  email                 String              @unique
  phoneNumber           String?             @unique
  password              String?
  tempPassword          String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  roles                 Role[]
  createdUsers          User[]              @relation("UserCreator")
  createdBy             User?               @relation("UserCreator", fields: [createdById], references: [id])
  createdById           String?
  managedBuildings      Building[]
  createdTenants        Tenant[]            @relation("TenantCreator")
  createdAgreement      AgreementTemplate[]
  disabledAgreements    DisabledAgreement[]
  tenants               Tenant[]
  createdRoles          Role[]              @relation("RoleCreator")

  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
  createdById String?
  createdBy   User?    @relation("RoleCreator", fields: [createdById], references: [id])
}

model Building {
  id                      String                     @id @default(cuid())
  name                    String                     @unique
  address                 String?
  accountNumber           String                     @unique
  status                  BuildingStatus             @default(Active)
  managers                User[]
  spaces                  Space[]
  penaltyPolicyTiers      PenaltyTier[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
}

model PenaltyTier {
  id                     String   @id @default(cuid())
  buildingId             String
  fromDay                Int
  toDay                  Int?
  penaltyType            String // "Fixed" or "Percentage"
  frequency              String // "OneTime" or "Daily"
  feeValue               Decimal  @db.Decimal(10, 2)
  scope                  String // "Building", "Floor", "SpecificSpaces"
  applicableFloor        String?
  applicableSpaceIdNames String[]
  building               Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model Space {
  id                    String        @id @default(cuid())
  buildingId            String
  buildingName          String
  spaceIdName           String
  area                  Decimal       @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal       @db.Decimal(5, 4) // e.g., 0.05 for 5%
  monthlyRentalPrice    Decimal       @db.Decimal(10, 2)
  isOccupied            Boolean       @default(false)
  tenantId              String?       @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  building              Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements            Agreement[]

  @@unique([buildingId, spaceIdName])
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String      @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  rentedSpaceId       String?     @unique
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  userId              String      @unique
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdById         String?
  createdBy           User?       @relation("TenantCreator", fields: [createdById], references: [id])
  rentedSpace         Space?
  agreements          Agreement[]
  bills               Bill[]
}

model Agreement {
  id                           String              @id @default(cuid())
  tenantId                     String
  spaceId                      String
  agreementText                String
  startDate                    DateTime
  monthlyRentalPrice           Decimal             @db.Decimal(10, 2)
  additionalTerms              String?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  paymentTermMonths          Int
  initialPaymentMonths       Int
  nextPaymentDueDate         DateTime
  initialPaymentAmount       Decimal?            @db.Decimal(12, 2)
  initialPaymentDate         DateTime?
  endDate                      DateTime?
  tenant                       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  space                        Space               @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  bills                        Bill[]
  disabledAgreements           DisabledAgreement[]
}

model DisabledAgreement {
    id String @id @default(cuid())
    agreementId String
    disabledById String
    
    agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
    disabledBy User @relation(fields: [disabledById], references: [id], onDelete: Cascade)

    @@unique([agreementId, disabledById])
}


model Bill {
  id                     String    @id @default(cuid())
  agreementId            String
  tenantId               String
  billDate               DateTime
  dueDate                DateTime
  rentAmount             Decimal   @db.Decimal(10, 2)
  utilityBreakdown       Json?
  penaltyAmount          Decimal?  @db.Decimal(10, 2)
  totalAmount            Decimal   @db.Decimal(12, 2)
  status                 BillStatus @default(Pending)
  paymentDate            DateTime?
  paymentMethod          String?
  paymentReference       String?
  paymentProofUrl        String?
  paymentProofDataUri    String?   @db.Text
  adminVerifiedPayment   Boolean?
  tenantPaymentNotes     String?
  adminVerificationNotes String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  agreement              Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ArifPayment            ArifPayment[]
}

model BuildingMonthlyUtilities {
  id           String                 @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int // 0-11 for Jan-Dec
  utilities    BuildingUtilityItem[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  building     Building               @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String                  @id @default(cuid())
  name                   String
  totalCost              Decimal                 @db.Decimal(12, 2)
  appliesToScope         String // "Building", "Floor", or "SpecificSpaces"
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model Secret {
  key   String @id
  value String @db.Text
}

model AgreementTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  content     String   @db.Text
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ArifPayment {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  billId        String
  status        String   // e.g., "Pending", "Success", "Failed"
  transactionId String?
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bill          Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

enum BuildingStatus {
  Active
  Inactive
}
