// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(cuid())
  userId           String      @unique // This is the external user ID from the identity provider
  email            String      @unique
  name             String?
  firstName        String?
  lastName         String?
  phoneNumber      String?     @unique
  password         String?
  tempPassword     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime?   @updatedAt
  roles            Role[]
  managedBuildings Building[]
  createdUsers     User[]      @relation("UserCreator")
  createdById      String?
  createdBy        User?       @relation("UserCreator", fields: [createdById], references: [id])
  createdTenants   Tenant[]    @relation("TenantCreator")
  createdTemplates AgreementTemplate[]
  disabledAgreements DisabledAgreement[]
  tenants          Tenant[] // Added missing inverse relation
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
}

model Building {
  id                       String                     @id @default(cuid())
  name                     String                     @unique
  address                  String?
  accountNumber            String                     @unique
  status                   BuildingStatus             @default(Active)
  penaltyPolicyTiers       PenaltyTier[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime?                  @updatedAt
  spaces                   Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                 User[]
}

model Space {
  id                    String                   @id @default(cuid())
  buildingId            String
  buildingName          String
  spaceIdName           String
  area                  Decimal                  @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal                  @db.Decimal(5, 4) // e.g., 0.05 for 5%
  monthlyRentalPrice    Decimal                  @db.Decimal(12, 2)
  isOccupied            Boolean                  @default(false)
  tenantId              String?                  @unique
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime?                @updatedAt
  building              Building                 @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements            Agreement[]

  @@unique([buildingId, spaceIdName])
}

model Tenant {
  id                  String      @id @default(cuid())
  userId              String      @unique
  name                String
  email               String      @unique
  phone               String?     @unique
  alternativePhone    String?
  nationalId          String?     @unique
  representativeName  String?
  representativePhone String?
  rentedSpaceId       String?     @unique
  createdAt           DateTime    @default(now())
  updatedAt           DateTime?   @updatedAt
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdById         String?
  createdBy           User?       @relation("TenantCreator", fields: [createdById], references: [id])
  rentedSpace         Space?
  agreements          Agreement[]
  bills               Bill[]
}

model Agreement {
  id                         String              @id @default(cuid())
  tenantId                   String
  spaceId                    String
  agreementText              String              @db.Text
  startDate                  DateTime
  monthlyRentalPrice         Decimal             @db.Decimal(12, 2)
  additionalTerms            String?             @db.Text
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime?           @updatedAt
  paymentTermMonths          Int
  initialPaymentMonths       Int
  nextPaymentDueDate         DateTime
  initialPaymentAmount       Decimal?            @db.Decimal(12, 2)
  initialPaymentDate         DateTime?
  endDate                    DateTime?
  tenant                     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space                      Space               @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  bills                      Bill[]
  disabledAgreements         DisabledAgreement[]
}

// This model tracks which admin has "soft deactivated" which agreement
model DisabledAgreement {
  id           String    @id @default(cuid())
  agreementId  String
  disabledById String
  disabledAt   DateTime  @default(now())
  agreement    Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  disabledBy   User      @relation(fields: [disabledById], references: [id], onDelete: Cascade)

  @@unique([agreementId, disabledById])
}

model Bill {
  id                       String      @id @default(cuid())
  agreementId              String
  tenantId                 String
  billDate                 DateTime
  dueDate                  DateTime
  rentAmount               Decimal     @db.Decimal(12, 2)
  utilityBreakdown         Json?
  penaltyAmount            Decimal?    @db.Decimal(12, 2)
  totalAmount              Decimal     @db.Decimal(12, 2)
  status                   BillStatus  @default(Pending)
  paymentDate              DateTime?
  paymentMethod            String?
  paymentReference         String?
  bankOrWalletName         String?
  paymentProofDataUri      String? // Changed from paymentProofUrl to store data URI directly
  adminVerifiedPayment     Boolean?
  tenantPaymentNotes       String?
  adminVerificationNotes   String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime?   @updatedAt
  agreement                Agreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  arifPayment              ArifPayment[]
}

model PenaltyTier {
  id                      String       @id @default(cuid())
  fromDay                 Int
  toDay                   Int?
  penaltyType             PenaltyType
  frequency               PenaltyFrequency
  feeValue                Decimal      @db.Decimal(10, 2)
  scope                   PenaltyScope
  applicableFloor         String?
  applicableSpaceIdNames  String[]
  buildingId              String
  building                Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model BuildingMonthlyUtilities {
  id           String                  @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int // 0 for January, 11 for December
  utilities    BuildingUtilityItem[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime?               @updatedAt
  building     Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                      String                   @id @default(cuid())
  name                    String
  totalCost               Decimal                  @db.Decimal(12, 2)
  appliesToScope          PenaltyScope
  applicableFloor         String?
  applicableSpaceIdNames  String[]
  monthlyUtilitiesId      String
  monthlyUtilities        BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model Secret {
  key   String @id
  value String
}

model AgreementTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  content     String   @db.Text
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ArifPayment {
  id             String    @id @default(cuid())
  billId         String
  sessionId      String    @unique
  transactionId  String?
  status         String
  amount         Decimal   @db.Decimal(12, 2)
  paymentMethod  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt
  bill           Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

enum BuildingStatus {
  Active
  Inactive
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyFrequency {
  OneTime
  Daily
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}
