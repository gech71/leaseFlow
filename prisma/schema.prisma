// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(cuid())
  userId           String      @unique // This would be the 'sub' from an external IdP
  email            String      @unique
  name             String?
  firstName        String?
  lastName         String?
  phoneNumber      String      @unique
  password         String?
  tempPassword     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  roles            Role[]
  createdUsers     User[]      @relation("UserCreator")
  createdBy        User?       @relation("UserCreator", fields: [createdById], references: [id])
  createdById      String?
  tenants          Tenant[]
  createdTenants   Tenant[]    @relation("TenantCreator")
  managedBuildings Building[]
  disabledAgreements DisabledAgreement[]
  createdAgreementTemplates AgreementTemplate[] @relation("TemplateCreator")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
  createdBy   User?    @relation("RoleCreator", fields: [createdById], references: [id])
  createdById String?
}

model Building {
  id                      String                    @id @default(cuid())
  name                    String                    @unique
  address                 String?
  accountNumber           String                    @unique
  status                  BuildingStatus            @default(Active)
  penaltyPolicyTiers      PenaltyTier[]
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime?                 @updatedAt
  managers                User[]
}

enum BuildingStatus {
  Active
  Inactive
}

model Space {
  id                    String   @id @default(cuid())
  buildingId            String
  buildingName          String // Denormalized for convenience
  spaceIdName           String   // e.g., "Office 201"
  area                  Decimal  @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal  @default(0) @db.Decimal(5, 4) // e.g. 0.05 for 5%
  monthlyRentalPrice    Decimal  @db.Decimal(12, 2)
  isOccupied            Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenantId              String?  @unique // A space can only have one tenant
  building              Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements            Agreement[]

  @@unique([buildingId, spaceIdName])
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String      @unique
  alternativePhone    String?
  nationalId          String?     @unique
  representativeName  String?
  representativePhone String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  userId              String      // This is the local User model's ID, not the external one
  createdById         String?
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy           User?       @relation("TenantCreator", fields: [createdById], references: [id])
  rentedSpace         Space?      
  agreements          Agreement[]
  bills               Bill[]
}

model Agreement {
  id                   String                @id @default(cuid())
  tenantId             String
  spaceId              String
  agreementText        String                @db.Text
  startDate            DateTime
  paymentTermMonths    Int
  monthlyRentalPrice   Decimal               @db.Decimal(12, 2)
  initialPaymentMonths Int
  nextPaymentDueDate   DateTime
  additionalTerms      String?               @db.Text
  initialPaymentAmount Decimal?              @db.Decimal(12, 2)
  initialPaymentDate   DateTime?
  endDate              DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime?             @updatedAt
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space                Space                 @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  bills                Bill[]
  disabledAgreements   DisabledAgreement[]
}

// Model to track which admin has disabled which agreement
model DisabledAgreement {
  agreementId  String
  disabledById String
  agreement    Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  disabledBy   User      @relation(fields: [disabledById], references: [id], onDelete: Cascade)

  @@id([agreementId, disabledById])
}


model Bill {
  id                      String      @id @default(cuid())
  agreementId             String
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal     @db.Decimal(12, 2)
  utilityBreakdown        Json?
  penaltyAmount           Decimal?    @db.Decimal(12, 2)
  totalAmount             Decimal     @db.Decimal(12, 2)
  status                  BillStatus  @default(Pending)
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  paymentProofDataUri     String?     @db.Text // New field for Base64 Data URI
  adminVerifiedPayment    Boolean?
  tenantPaymentNotes      String?
  adminVerificationNotes  String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime?   @updatedAt
  agreement               Agreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  arifPayments            ArifPayment[]

  @@index([agreementId])
  @@index([tenantId])
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

model PenaltyTier {
  id                     String        @id @default(cuid())
  buildingId             String
  fromDay                Int
  toDay                  Int?
  penaltyType            PenaltyType
  frequency              PenaltyFrequency
  feeValue               Decimal       @db.Decimal(12, 2) // Can be fixed amount or percentage
  scope                  PenaltyScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  building               Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyFrequency {
  Daily
  OneTime
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}

model BuildingMonthlyUtilities {
  id           String                  @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int // 0-11 for Jan-Dec
  utilities    BuildingUtilityItem[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime?               @updatedAt
  building     Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String                  @id @default(cuid())
  name                   String // e.g., "Electricity", "Water"
  totalCost              Decimal                 @db.Decimal(12, 2)
  appliesToScope         PenaltyScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model Secret {
  key   String @id
  value String
}

model AgreementTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("TemplateCreator", fields: [createdById], references: [id])
}

model ArifPayment {
  id             String    @id @default(cuid())
  billId         String
  sessionId      String    @unique // ArifPay's unique session ID
  transactionId  String?   // ArifPay's final transaction ID
  amount         Decimal   @db.Decimal(12, 2)
  status         String    @default("Pending") // Pending, Success, Failed
  paymentMethod  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bill           Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
}
