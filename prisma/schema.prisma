
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id                      String                     @id @default(cuid())
  name                    String
  address                 String?
  accountNumber           String                     @unique
  penaltyPolicyTiers      PenaltyTier[]
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                User[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime?                  @updatedAt
}

model Space {
  id                    String      @id @default(cuid())
  buildingId            String
  buildingName          String
  spaceIdName           String
  area                  Decimal
  floor                 String
  utilityProrationShare Decimal
  monthlyRentalPrice    Decimal
  isOccupied            Boolean     @default(false)
  tenantId              String?     @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime?   @updatedAt
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements            Agreement[]
}

model Tenant {
  id                  String       @id @default(cuid())
  name                String
  email               String       @unique
  phone               String?      @unique
  alternativePhone    String?
  nationalId          String?      @unique
  representativeName  String?
  representativePhone String?
  userId              String       @unique
  rentedSpaceId       String?      @unique
  createdAt           DateTime     @default(now())
  updatedAt           DateTime?    @updatedAt
  user                User         @relation("TenantProfile", fields: [userId], references: [id], onDelete: Cascade)
  rentedSpace         Space?
  agreements          Agreement[]
  bills               Bill[]
  createdById         String?
  createdBy           User?        @relation("TenantCreator", fields: [createdById], references: [id], onDelete: SetNull)
}

model Agreement {
  id                    String    @id @default(cuid())
  tenantId              String
  spaceId               String
  agreementText         String    @db.Text
  startDate             DateTime
  monthlyRentalPrice    Decimal
  additionalTerms       String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime? @updatedAt
  paymentTermMonths     Int
  initialPaymentMonths  Int
  nextPaymentDueDate    DateTime
  endDate               DateTime?

  initialPaymentAmount           Decimal?
  initialPaymentDate             DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space  Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  bills  Bill[]
}

model Bill {
  id                  String    @id @default(cuid())
  agreementId         String
  tenantId            String
  billDate            DateTime
  dueDate             DateTime
  rentAmount          Decimal
  utilityBreakdown    Json?
  penaltyAmount       Decimal?
  totalAmount         Decimal
  status              BillStatus @default(Pending)
  
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  bankOrWalletName        String?
  paymentProofUrl         String?
  adminVerifiedPayment    Boolean?
  tenantPaymentNotes      String?
  adminVerificationNotes  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  arifPayments ArifPayment[]

  @@index([status])
}

enum BillStatus {
  Pending
  Paid
  Overdue
}

model BuildingMonthlyUtilities {
  id           String                 @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int
  utilities    BuildingUtilityItem[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime?              @updatedAt
  building     Building               @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String   @id @default(cuid())
  name                   String
  totalCost              Decimal
  appliesToScope         String // "Building", "Floor", "SpecificSpaces"
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String?
  monthlyUtilities       BuildingMonthlyUtilities? @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                     String   @id @default(cuid())
  buildingId             String
  fromDay                Int
  toDay                  Int?
  penaltyType            String // "Fixed" or "Percentage"
  feeType                String
  feeValue               Decimal
  frequency              String   // "OneTime" or "Daily"
  scope                  String   // "Building", "Floor", "SpecificSpaces"
  applicableFloor        String?
  applicableSpaceIdNames String[]
  building               Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model User {
  id                        String              @id @default(cuid())
  userId                    String              @unique // External ID from identity provider
  email                     String              @unique
  name                      String?
  firstName                 String?
  lastName                  String?
  phoneNumber               String?             @unique
  tempPassword              String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime?           @updatedAt
  
  roles                     Role[]              @relation("UserRoles")
  managedBuildings          Building[]
  createdById               String?
  createdBy                 User?               @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers              User[]              @relation("UserCreator")
  createdTenants            Tenant[]            @relation("TenantCreator")
  createdRoles              Role[]              @relation("RoleCreator")
  createdAgreementTemplates AgreementTemplate[]
  tenantProfile             Tenant?             @relation("TenantProfile")
}

model Role {
  id          String    @id @default(cuid())
  name        String
  description String?
  permissions String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  users       User[]    @relation("UserRoles")
  createdById String?
  createdBy   User?     @relation("RoleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([name, createdById])
}

model Secret {
  key   String @id
  value String
}

model AgreementTemplate {
  id          String    @id @default(cuid())
  name        String    @unique
  content     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

model ArifPayment {
  id             String    @id @default(cuid())
  sessionId      String    @unique
  status         String // "Pending", "Success", "Failed"
  amount         Decimal
  paymentUrl     String    @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  billId         String
  transactionId  String?
  paymentMethod  String?
  bill           Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
}
