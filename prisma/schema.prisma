// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "preview-provider-outputs"
}

model Building {
  id                      String                    @id @default(uuid())
  name                    String
  address                 String?
  accountNumber           String?                   @unique
  spaces                  Space[]
  penaltyPolicyTiers      PenaltyTier[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                User[]                    @relation("BuildingManagers")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime?                 @updatedAt
}

model Space {
  id                    String      @id @default(uuid())
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId            String
  buildingName          String // Denormalized for easier access
  spaceIdName           String
  area                  Float
  floor                 String
  utilityProrationShare Float       @default(0)
  monthlyRentalPrice    Float
  isOccupied            Boolean     @default(false)
  tenantId              String?     @unique
  tenant                Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements            Agreement[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime?   @updatedAt
}

model Tenant {
  id                  String      @id @default(uuid())
  name                String
  email               String      @unique
  phone               String?     @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  userId              String?     @unique // Link to the User model
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  rentedSpaceId       String?     @unique
  rentedSpace         Space?
  agreements          Agreement[]
  bills               Bill[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime?   @updatedAt
}

model Agreement {
  id                             String    @id @default(uuid())
  tenant                         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId                       String
  space                          Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId                        String
  agreementText                  String    @db.Text
  startDate                      DateTime
  monthlyRentalPrice             Float
  additionalTerms                String?   @db.Text
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime? @updatedAt
  paymentTermMonths              Int       @default(12)
  initialPaymentMonths           Int       @default(1)
  nextPaymentDueDate             DateTime
  initialPaymentAmount           Float?
  initialPaymentMethod           String?
  initialPaymentReference        String?
  initialPaymentBankOrWalletName String?
  initialPaymentDate             DateTime?
  endDate                        DateTime?
  bills                          Bill[]
}

model Bill {
  id                      String                @id @default(uuid())
  agreement               Agreement             @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  agreementId             String
  tenant                  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Float
  utilityBreakdown        Json                  @default("[]")
  penaltyAmount           Float?
  totalAmount             Float
  status                  BillStatus            @default(Pending)
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  bankOrWalletName        String?
  paymentProofUrl         String?
  adminVerifiedPayment    Boolean?              @default(false)
  tenantPaymentNotes      String?
  adminVerificationNotes  String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime?             @updatedAt
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

model UtilityBreakdownItem {
  id        String @id @default(uuid())
  name      String
  amount    Float
}

model BuildingMonthlyUtilities {
  id           String                @id @default(uuid())
  building     Building              @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId   String
  buildingName String // Denormalized for easier access
  year         Int
  month        Int // 0-11 for Jan-Dec
  utilities    BuildingUtilityItem[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime?             @updatedAt

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String                    @id @default(uuid())
  name                   String
  totalCost              Float
  appliesToScope         UtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilities       BuildingMonthlyUtilities? @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
  monthlyUtilitiesId     String?
}

enum UtilityScope {
  Building
  Floor
  SpecificSpaces
}

model PenaltyTier {
  id                     String       @id @default(uuid())
  building               Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId             String
  fromDay                Int
  toDay                  Int?
  feeType                PenaltyFeeType
  feeValue               Float
  scope                  PenaltyScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
}

enum PenaltyFeeType {
  Fixed
  Percentage
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}

model User {
  id               String     @id @default(uuid())
  userId           String     @unique // External ID from identity provider
  email            String     @unique
  name             String?
  firstName        String?
  lastName         String?
  phoneNumber      String?    @unique
  tempPassword     String?
  roles            Role[]
  managedBuildings Building[] @relation("BuildingManagers")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime?  @updatedAt
  tenant           Tenant?
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
}

model Secret {
  key       String    @id
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}
