
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================================
//         Core Auth Models
// ==================================
model User {
  id               String      @id @default(uuid())
  email            String      @unique
  name             String?
  firstName        String?
  lastName         String?
  phoneNumber      String?     @unique
  password         String?
  tempPassword     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime?   @updatedAt
  roles            Role[]
  createdById      String?
  createdBy        User?       @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers     User[]      @relation("UserCreatedBy")
  managedBuildings Building[]  @relation("BuildingManagers")
  createdRoles     Role[]
  createdTenants   Tenant[]
  createdTemplates AgreementTemplate[]
  disabledAgreements DisabledAgreement[]
  sentArifPayments ArifPayment[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
  users       User[]
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
}

model Secret {
  key   String @id
  value String
}

model RateLimit {
  id             String   @id @default(uuid())
  identifier     String   @unique
  attempts       Int      @default(1)
  firstAttemptAt DateTime @default(now())

  @@index([identifier])
}

// ==================================
//     Building & Space Models
// ==================================
model Building {
  id                      String                    @id @default(uuid())
  name                    String                    @unique
  address                 String?
  accountNumber           String
  status                  BuildingStatus            @default(Active)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime?                 @updatedAt
  spaces                  Space[]
  penaltyPolicyTiers      PenaltyTier[]
  managers                User[]                    @relation("BuildingManagers")
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  createdById             String?
  createdBy               User?                     @relation(fields: [createdById], references: [id])
}

model Space {
  id                    String      @id @default(uuid())
  buildingId            String
  buildingName          String // Denormalized for convenience
  spaceIdName           String
  area                  Decimal
  floor                 String
  utilityProrationShare Decimal
  monthlyRentalPrice    Decimal
  isOccupied            Boolean     @default(false)
  tenantId              String?     @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime?   @updatedAt
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                Tenant?     @relation(fields: [tenantId], references: [id])
  agreements            Agreement[]

  @@unique([buildingId, spaceIdName])
}

// ==================================
//          Tenant Models
// ==================================
model Tenant {
  id                  String      @id @default(uuid())
  name                String
  email               String      @unique
  phone               String      @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  userId              String?     @unique
  rentedSpaceId       String?     @unique
  createdAt           DateTime    @default(now())
  updatedAt           DateTime?   @updatedAt
  rentedSpace         Space?      @relation(fields: [rentedSpaceId], references: [id])
  user                User?       @relation(fields: [userId], references: [id])
  agreements          Agreement[]
  bills               Bill[]
  createdById         String?
  createdBy           User?       @relation(fields: [createdById], references: [id])
}

// ==================================
//       Agreement & Bill Models
// ==================================
model Agreement {
  id                        String      @id @default(uuid())
  tenantId                  String
  spaceId                   String
  agreementText             String
  startDate                 DateTime
  monthlyRentalPrice        Decimal
  additionalTerms           String?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime?   @updatedAt
  paymentTermMonths         Int
  initialPaymentMonths      Int
  nextPaymentDueDate        DateTime
  initialPaymentAmount      Decimal?
  initialPaymentDate        DateTime?
  endDate                   DateTime?
  tenant                    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space                     Space       @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  bills                     Bill[]
  disabledAgreements        DisabledAgreement[]
  ArifPayment               ArifPayment[]
}

model Bill {
  id                      String             @id @default(uuid())
  agreementId             String
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal
  utilityBreakdown        Json?
  penaltyAmount           Decimal?
  totalAmount             Decimal
  status                  BillStatus         @default(Pending)
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  paymentProofDataUri     String?
  adminVerifiedPayment    Boolean?
  tenantPaymentNotes      String?
  adminVerificationNotes  String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime?          @updatedAt
  agreement               Agreement          @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ArifPayment             ArifPayment[]
}

// ==================================
//         Utility & Penalty Models
// ==================================
model BuildingMonthlyUtilities {
  id           String                @id @default(uuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int
  createdAt    DateTime              @default(now())
  updatedAt    DateTime?             @updatedAt
  building     Building              @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  utilities    BuildingUtilityItem[]

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String    @id @default(uuid())
  name                   String
  totalCost              Decimal
  appliesToScope         UtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  perSpaceAllocation     String?
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                     String      @id @default(uuid())
  fromDay                Int
  toDay                  Int?
  penaltyType            PenaltyType
  frequency              PenaltyFrequency
  feeValue               Decimal
  scope                  PenaltyScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  buildingId             String
  building               Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

// ==================================
//      Other Supporting Models
// ==================================
model DisabledAgreement {
  id            String   @id @default(uuid())
  agreementId   String
  disabledById  String
  disabledAt    DateTime @default(now())
  agreement     Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  disabledBy    User      @relation(fields: [disabledById], references: [id], onDelete: Cascade)

  @@unique([agreementId, disabledById])
}

model AgreementTemplate {
  id          String    @id @default(uuid())
  name        String    @unique
  content     String
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
}

model ArifPayment {
  id String @id @default(uuid())
  sessionId String @unique
  paymentId String
  status String @default("PENDING")
  amount Float
  userId String
  user User @relation(fields: [userId], references: [id])
  agreementId String
  agreement Agreement @relation(fields: [agreementId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  billId String @unique
  bill Bill @relation(fields: [billId], references: [id])
}

// ==================================
//               Enums
// ==================================
enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyFrequency {
    OneTime
    Daily
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}

enum UtilityScope {
  Building
  Floor
  SpecificSpaces
}

enum BuildingStatus {
  Active
  Inactive
}
