// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- User and Role Management ---
model User {
  id                      String        @id @default(cuid())
  userId                  String        @unique // External ID from auth provider (e.g., JWT sub)
  email                   String        @unique
  name                    String?
  firstName               String?
  lastName                String?
  phoneNumber             String?       @unique
  password                String?
  tempPassword            String?       @unique
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  roles                   Role[]
  createdUsers            User[]        @relation("UserCreator")
  createdBy               User?         @relation("UserCreator", fields: [createdById], references: [id])
  createdById             String?
  createdRoles            Role[]        @relation("RoleCreator")
  managedBuildings        Building[]    @relation("BuildingManager")
  createdTenants          Tenant[]      @relation("TenantCreator")
  createdAgreementTemplates AgreementTemplate[]
  disabledAgreements      DisabledAgreement[]
  tenants                 Tenant[]
}


model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
  createdBy   User?    @relation("RoleCreator", fields: [createdById], references: [id])
  createdById String?
}

// --- Core Rental Models ---

model Building {
  id                      String                    @id @default(cuid())
  name                    String                    @unique
  address                 String?
  accountNumber           String
  status                  BuildingStatus            @default(Active)
  penaltyPolicyTiers      PenaltyTier[]
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                User[]                    @relation("BuildingManager")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
}

model Space {
  id                    String    @id @default(cuid())
  buildingId            String
  buildingName          String // Denormalized for easy display
  spaceIdName           String
  area                  Decimal   @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal   @default(0) @db.Decimal(5, 4)
  monthlyRentalPrice    Decimal   @db.Decimal(12, 2)
  isOccupied            Boolean   @default(false)
  tenantId              String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  building              Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements            Agreement[]
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String?     @unique
  alternativePhone    String?
  nationalId          String?     @unique
  representativeName  String?
  representativePhone String?
  userId              String      @unique // Links to User model
  createdById         String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy           User?       @relation("TenantCreator", fields: [createdById], references: [id])
  rentedSpace         Space?
  agreements          Agreement[]
  bills               Bill[]
}

model Agreement {
  id                    String        @id @default(cuid())
  tenantId              String
  spaceId               String
  agreementText         String        @db.Text
  startDate             DateTime
  monthlyRentalPrice    Decimal       @db.Decimal(12, 2)
  additionalTerms       String?       @db.Text
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  paymentTermMonths     Int
  initialPaymentMonths  Int
  nextPaymentDueDate    DateTime
  initialPaymentAmount  Decimal?      @db.Decimal(12, 2)
  initialPaymentDate    DateTime?
  endDate               DateTime?
  disabledAgreements    DisabledAgreement[]
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space                 Space         @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  bills                 Bill[]
}

// Model to track which admin has disabled an agreement
model DisabledAgreement {
  id           String    @id @default(cuid())
  agreementId  String
  disabledById String
  disabledAt   DateTime  @default(now())
  agreement    Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  disabledBy   User      @relation(fields: [disabledById], references: [id], onDelete: Cascade)

  @@unique([agreementId, disabledById])
}


// --- Financial Models ---
model Bill {
  id                      String        @id @default(cuid())
  agreementId             String
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal       @db.Decimal(12, 2)
  utilityBreakdown        Json?
  penaltyAmount           Decimal?      @db.Decimal(12, 2)
  totalAmount             Decimal       @db.Decimal(12, 2)
  status                  BillStatus    @default(Pending)
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  paymentProofUrl         String?
  paymentProofDataUri     String?
  adminVerifiedPayment    Boolean?      @default(false)
  tenantPaymentNotes      String?
  adminVerificationNotes  String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  agreement               Agreement     @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ArifPayment             ArifPayment[]
}

model BuildingMonthlyUtilities {
  id           String                @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int // 0-11 for Jan-Dec
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  building     Building              @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  utilities    BuildingUtilityItem[]

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String                    @id @default(cuid())
  name                   String
  totalCost              Decimal                   @db.Decimal(12, 2)
  appliesToScope         UtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities  @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                     String       @id @default(cuid())
  buildingId             String
  fromDay                Int
  toDay                  Int?
  penaltyType            PenaltyType
  frequency              PenaltyFrequency
  feeValue               Decimal      @db.Decimal(10, 2) // Fixed amount or percentage
  scope                  RuleScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  building               Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

// --- Configuration & System Models ---
model Secret {
  key   String @id
  value String
}

model AgreementTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  content     String   @db.Text
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ArifPayment {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  billId        String
  amount        Float
  status        String   @default("Pending") // Pending, Success, Failed
  transactionId String?
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bill          Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
}

// --- ENUMS ---

enum BuildingStatus {
  Active
  Inactive
}

enum TenantStatus {
  Active
  Inactive
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

enum UtilityScope {
  Building
  Floor
  SpecificSpaces
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyFrequency {
  OneTime
  Daily
}

enum RuleScope {
  Building
  Floor
  SpecificSpaces
}
