
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Building {
  id                      String                    @id @default(cuid())
  name                    String                    @unique
  address                 String?
  accountNumber           String                    @unique
  penaltyPolicyTiers      PenaltyTier[]
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                User[]                    @relation("BuildingManagers")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime?                 @updatedAt
}

model PenaltyTier {
  id                     String    @id @default(cuid())
  building               Building  @relation(fields: [buildingId], references: [id])
  buildingId             String
  fromDay                Int
  toDay                  Int?
  penaltyType            String // "Fixed" or "Percentage"
  feeValue               Decimal   @db.Decimal(10, 2)
  frequency              String // "OneTime" or "Daily"
  scope                  String // "Building", "Floor", "SpecificSpaces"
  applicableFloor        String?
  applicableSpaceIdNames String[]
  createdAt              DateTime  @default(now())
  updatedAt              DateTime? @updatedAt
}

model Space {
  id                   String      @id @default(cuid())
  building             Building    @relation(fields: [buildingId], references: [id])
  buildingId           String
  buildingName         String
  spaceIdName          String
  area                 Decimal     @db.Decimal(10, 2)
  floor                String
  utilityProrationShare Decimal    @db.Decimal(5, 4)
  monthlyRentalPrice   Decimal     @db.Decimal(12, 2)
  isOccupied           Boolean     @default(false)
  tenantId             String?     @unique
  tenant               Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements           Agreement[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime?   @updatedAt

  @@unique([buildingId, spaceIdName])
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String      @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  rentedSpaceId       String?     @unique
  rentedSpace         Space?
  agreements          Agreement[]
  bills               Bill[]
  user                User?       @relation(fields: [userId], references: [id])
  userId              String?     @unique
  createdAt           DateTime    @default(now())
  updatedAt           DateTime?   @updatedAt
}

model Agreement {
  id                   String    @id @default(cuid())
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
  tenantId             String
  space                Space     @relation(fields: [spaceId], references: [id])
  spaceId              String
  agreementText        String    @db.Text
  startDate            DateTime
  monthlyRentalPrice   Decimal   @db.Decimal(12, 2)
  additionalTerms      String?   @db.Text
  paymentTermMonths    Int
  initialPaymentMonths Int
  nextPaymentDueDate   DateTime
  endDate              DateTime?
  initialPaymentAmount Decimal?  @db.Decimal(12, 2)
  initialPaymentDate   DateTime?
  bills                Bill[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime? @updatedAt
}

enum BillStatus {
  Pending
  Paid
  Overdue
}

model Bill {
  id                      String      @id @default(cuid())
  agreement               Agreement   @relation(fields: [agreementId], references: [id])
  agreementId             String
  tenant                  Tenant      @relation(fields: [tenantId], references: [id])
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal     @db.Decimal(12, 2)
  utilityBreakdown        Json?
  penaltyAmount           Decimal?    @db.Decimal(12, 2)
  totalAmount             Decimal     @db.Decimal(12, 2)
  status                  BillStatus  @default(Pending)
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  bankOrWalletName        String?
  paymentProofUrl         String?
  tenantPaymentNotes      String?
  adminVerifiedPayment    Boolean?
  adminVerificationNotes  String?
  arifPayments            ArifPayment[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime?   @updatedAt
}

model BuildingMonthlyUtilities {
  id           String                  @id @default(cuid())
  building     Building                @relation(fields: [buildingId], references: [id])
  buildingId   String
  buildingName String
  year         Int
  month        Int
  utilities    BuildingUtilityItem[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime?               @updatedAt

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String                    @id @default(cuid())
  monthlyUtilities       BuildingMonthlyUtilities  @relation(fields: [monthlyUtilitiesId], references: [id])
  monthlyUtilitiesId     String
  name                   String
  totalCost              Decimal                   @db.Decimal(12, 2)
  appliesToScope         String // "Building", "Floor", "SpecificSpaces"
  applicableFloor        String?
  applicableSpaceIdNames String[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime?                 @updatedAt
}

model User {
  id               String      @id @default(cuid())
  userId           String      @unique // External ID from authentication provider
  email            String      @unique
  name             String
  firstName        String?
  lastName         String?
  phoneNumber      String?     @unique
  tempPassword     String?
  roles            Role[]      @relation("UserRoles")
  managedBuildings Building[]  @relation("BuildingManagers")
  tenantProfile    Tenant?
  createdBy        User?       @relation("CreatedUsers", fields: [createdById], references: [id])
  createdById      String?
  createdUsers     User[]      @relation("CreatedUsers")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime?   @updatedAt
}

model Role {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  permissions String[]
  users       User[]    @relation("UserRoles")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
}

model Secret {
  key       String    @id
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model AgreementTemplate {
  id        String    @id @default(cuid())
  name      String    @unique
  content   String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model ArifPayment {
  id            String    @id @default(cuid())
  sessionId     String    @unique
  status        String
  amount        Float
  paymentUrl    String    @db.Text
  transactionId String?
  paymentMethod String?
  bill          Bill      @relation(fields: [billId], references: [id])
  billId        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
