// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User and Role models
model User {
  id               String      @id @default(uuid())
  email            String      @unique
  name             String
  firstName        String
  lastName         String
  phoneNumber      String      @unique
  password         String?
  tempPassword     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime?   @updatedAt
  roles            Role[]      @relation("UserRoles")
  createdById      String?
  createdBy        User?       @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers     User[]      @relation("UserCreator")
  createdTenants   Tenant[]
  createdRoles     Role[]      @relation("CreatedRoles")
  managedBuildings Building[]  @relation("BuildingManagers")
  disabledAgreements DisabledAgreement[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  users       User[]   @relation("UserRoles")
  createdById String?
  createdBy   User?    @relation("CreatedRoles", fields: [createdById], references: [id], onDelete: SetNull)
}

// Core business models
model Building {
  id                      String                     @id @default(uuid())
  name                    String                     @unique
  address                 String
  accountNumber           String
  status                  BuildingStatus             @default(Active)
  spaces                  Space[]
  penaltyPolicyTiers      PenaltyTier[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                User[]                     @relation("BuildingManagers")
  createdById             String
  createdBy               User                       @relation(fields: [createdById], references: [id])
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime?                  @updatedAt
}

enum BuildingStatus {
  Active
  Inactive
}

model Space {
  id                   String     @id @default(uuid())
  buildingId           String
  building             Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingName         String
  spaceIdName          String
  area                 Decimal    @db.Decimal(10, 2)
  floor                String
  utilityProrationShare Decimal    @db.Decimal(5, 4) // e.g. 0.05 for 5%
  monthlyRentalPrice   Decimal    @db.Decimal(12, 2)
  isOccupied           Boolean    @default(false)
  tenantId             String?    @unique
  tenant               Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements           Agreement[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime?  @updatedAt

  @@unique([buildingId, spaceIdName])
}

model Tenant {
  id                 String       @id @default(uuid())
  name               String
  email              String       @unique
  phone              String       @unique
  alternativePhone   String?
  nationalId         String?
  representativeName String?
  representativePhone String?
  rentedSpaceId      String?      @unique
  rentedSpace        Space?
  userId             String?      @unique
  user               User?        @relation(fields: [userId], references: [id])
  agreements         Agreement[]
  bills              Bill[]
  createdById        String?
  createdBy          User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime?    @updatedAt
}

model Agreement {
  id                    String      @id @default(uuid())
  tenantId              String
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaceId               String
  space                 Space       @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  agreementText         String
  startDate             DateTime
  monthlyRentalPrice    Decimal     @db.Decimal(12, 2)
  additionalTerms       String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime?   @updatedAt
  paymentTermMonths     Int
  initialPaymentMonths  Int
  nextPaymentDueDate    DateTime
  initialPaymentAmount  Decimal?    @db.Decimal(12, 2)
  initialPaymentDate    DateTime?
  bills                 Bill[]
  disabledAgreements    DisabledAgreement[]
  arifPayments          ArifPayment[]
  endDate               DateTime?
}

// This model implements "soft deactivation" of agreements on a per-admin basis.
model DisabledAgreement {
  agreementId  String
  agreement    Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  disabledById String
  disabledBy   User      @relation(fields: [disabledById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@id([agreementId, disabledById])
}


enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

model Bill {
  id                      String                @id @default(uuid())
  agreementId             String
  agreement               Agreement             @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenantId                String
  tenant                  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal               @db.Decimal(12, 2)
  utilityBreakdown        Json?
  penaltyAmount           Decimal?              @db.Decimal(12, 2)
  totalAmount             Decimal               @db.Decimal(12, 2)
  status                  BillStatus
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  bankOrWalletName        String?
  paymentProofUrl         String?
  adminVerifiedPayment    Boolean?
  tenantPaymentNotes      String?
  adminVerificationNotes  String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime?             @updatedAt
  arifPayments            ArifPayment[]
  paymentProofDataUri     String?
}

model BuildingMonthlyUtilities {
  id           String                @id @default(uuid())
  buildingId   String
  building     Building              @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingName String
  year         Int
  month        Int // 0-11 for Jan-Dec
  utilities    BuildingUtilityItem[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime?             @updatedAt

  @@unique([buildingId, year, month])
}

enum UtilityScope {
  Building
  Floor
  SpecificSpaces
}

model BuildingUtilityItem {
  id                     String                    @id @default(uuid())
  name                   String
  totalCost              Decimal                   @db.Decimal(12, 2)
  appliesToScope         UtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  perSpaceAllocation     String?
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities  @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyFrequency {
  OneTime
  Daily
}

model PenaltyTier {
  id                     String           @id @default(uuid())
  fromDay                Int
  toDay                  Int?
  penaltyType            PenaltyType
  feeValue               Decimal          @db.Decimal(10, 2)
  scope                  UtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  buildingId             String
  building               Building         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  frequency              PenaltyFrequency @default(OneTime)
}

model AgreementTemplate {
  id          String    @id @default(uuid())
  name        String    @unique
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
}

model ArifPayment {
  id          String    @id @default(uuid())
  sessionId   String    @unique
  billIds     String[]
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id])
  billId      String
  bill        Bill      @relation(fields: [billId], references: [id])
  status      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
}

model RateLimit {
  id             String   @id @default(uuid())
  identifier     String   @unique
  attempts       Int      @default(1)
  firstAttemptAt DateTime @default(now())

  @@index([identifier])
}
