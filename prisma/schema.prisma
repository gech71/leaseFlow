
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String     @id @default(cuid())
  userId           String     @unique @map("user_id") // User ID from external identity provider
  email            String     @unique
  name             String?
  firstName        String?
  lastName         String?
  phoneNumber      String?    @unique
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime?  @updatedAt @map("updated_at")
  roles            Role[]     @relation("UserRoles")
  managedBuildings Building[] @relation("UserManagedBuildings") // Buildings this user manages

  @@map("users")
}

model Role {
  id          String    @id @default(cuid())
  name        String    @unique // e.g., SUPER_ADMIN, PROPERTY_MANAGER, ACCOUNTANT, SUPPORT_STAFF
  description String?
  permissions String[] // List of permission strings
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  users       User[]    @relation("UserRoles")

  @@map("roles")
}

model Building {
  id                      String                      @id @default(cuid())
  name                    String                      @unique
  address                 String?
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime?                   @updatedAt @map("updated_at")
  spaces                  Space[]
  penaltyPolicyTiers      PenaltyTier[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]

  managedByUserId         String?                      @map("managed_by_user_id")
  manager                 User?                        @relation("UserManagedBuildings", fields: [managedByUserId], references: [userId], onDelete: SetNull, onUpdate: Cascade)


  @@map("buildings")
}

model Space {
  id                    String     @id @default(cuid())
  buildingId            String     @map("building_id")
  buildingName          String     @map("building_name") // Denormalized for easier queries/display
  spaceIdName           String     @map("space_id_name") // User-friendly ID like "Unit 10A" or "Office 202"
  area                  Float      // Square footage or meters
  floor                 String?
  utilityProrationShare Float      @default(0) // e.g., 0.15 for 15%
  monthlyRentalPrice    Float
  isOccupied            Boolean    @default(false) @map("is_occupied")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime?  @updatedAt @map("updated_at")
  building              Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenantId              String?    @unique @map("tenant_id") // If space is occupied, link to tenant
  tenant                Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements            Agreement[]

  @@unique([buildingId, spaceIdName]) // Ensure spaceIdName is unique within a building
  @@map("spaces")
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String?
  alternativePhone    String?     @map("alternative_phone")
  nationalId          String?     @unique @map("national_id")
  representativeName  String?     @map("representative_name")
  representativePhone String?     @map("representative_phone")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime?   @updatedAt @map("updated_at")
  rentedSpaceId       String?     @unique @map("rented_space_id") // Link to the currently rented space
  rentedSpace         Space?      // This is the other side of the 1-to-1 with Space.tenantId
  agreements          Agreement[]
  bills               Bill[]

  @@map("tenants")
}

model Agreement {
  id                             String    @id @default(cuid())
  tenantId                       String    @map("tenant_id")
  spaceId                        String    @map("space_id")
  agreementText                  String    @map("agreement_text")
  startDate                      DateTime  @map("start_date")
  monthlyRentalPrice             Float     @map("monthly_rental_price")
  paymentTermMonths              Int       @map("payment_term_months") // e.g., 12 months, 24 months
  initialPaymentMonths           Int       @map("initial_payment_months") // e.g., 2 months rent upfront
  nextPaymentDueDate             DateTime  @map("next_payment_due_date")
  additionalTerms                String?   @map("additional_terms")
  initialPaymentAmount           Float?    @map("initial_payment_amount")
  initialPaymentMethod           String?   @map("initial_payment_method") // e.g., "Cash", "Bank Transfer", "Card", "Wallet"
  initialPaymentReference        String?   @map("initial_payment_reference")
  initialPaymentBankOrWalletName String?   @map("initial_payment_bank_or_wallet_name")
  initialPaymentDate             DateTime? @map("initial_payment_date")
  endDate                        DateTime? @map("end_date") // Calculated: startDate + paymentTermMonths

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space  Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  bills  Bill[]

  @@map("agreements")
}

// For bills issued to tenants
model Bill {
  id                      String                 @id @default(cuid())
  agreementId             String                 @map("agreement_id")
  tenantId                String                 @map("tenant_id") // Denormalized for easier querying by tenant
  billDate                DateTime               @map("bill_date") // Date the bill was issued
  dueDate                 DateTime               @map("due_date") // Date the payment is due
  rentAmount              Float                  @map("rent_amount")
  utilityBreakdown        Json?                  @map("utility_breakdown") // Store as JSON: [{name: "Electricity", amount: 50.00}, {name: "Water", amount: 20.00}]
  penaltyAmount           Float?                 @map("penalty_amount")
  totalAmount             Float                  @map("total_amount") // rentAmount + sum(utilityBreakdown.amount) + penaltyAmount
  status                  BillStatus             @default(Pending)
  paymentDate             DateTime?              @map("payment_date")
  paymentMethod           String?                @map("payment_method") // e.g., "Cash", "Bank Transfer", "Card", "Wallet"
  paymentReference        String?                @map("payment_reference")
  bankOrWalletName        String?                @map("bank_or_wallet_name")
  paymentProofUrl         String?                @map("payment_proof_url")
  adminVerifiedPayment    Boolean?               @map("admin_verified_payment")
  tenantPaymentNotes      String?                @map("tenant_payment_notes")
  adminVerificationNotes  String?                @map("admin_verification_notes")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime?              @updatedAt @map("updated_at")
  agreement               Agreement              @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade) // Added tenant relation for Bill

  @@map("bills")
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification // When tenant submits proof, admin needs to verify
}

// For tracking monthly utility costs for an entire building
model BuildingMonthlyUtilities {
  id           String                  @id @default(cuid())
  buildingId   String                  @map("building_id")
  buildingName String                  @map("building_name") // Denormalized name
  year         Int
  month        Int // 0 (Jan) to 11 (Dec)
  utilities    BuildingUtilityItem[]
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime?               @updatedAt @map("updated_at")
  building     Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
  @@map("building_monthly_utilities")
}

// Represents a single utility cost item for a building for a month
model BuildingUtilityItem {
  id                      String                    @id @default(cuid())
  name                    String // e.g., "Communal Electricity", "Water Treatment", "Security Services for 5th Floor"
  totalCost               Float                     @map("total_cost")
  appliesToScope          UtilityApplicationScope   @map("applies_to_scope") // e.g., "Building", "Floor", "SpecificSpaces"
  applicableFloor         String?                   @map("applicable_floor") // e.g., "5th Floor", "Penthouse" - if scope is "Floor"
  applicableSpaceIdNames  String[]                  @map("applicable_space_id_names") // List of Space.spaceIdName - if scope is "SpecificSpaces"
  monthlyUtilitiesId      String                    @map("monthly_utilities_id")
  monthlyUtilities        BuildingMonthlyUtilities  @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)

  @@map("building_utility_items")
}

enum UtilityApplicationScope {
  Building // Applies to all spaces in the building, prorated by Space.utilityProrationShare
  Floor // Applies to all spaces on a specific floor, divided equally or by area
  SpecificSpaces // Applies only to a list of specific spaces, divided equally or by area
}

model PenaltyTier {
  id                      String                 @id @default(cuid())
  buildingId              String                 @map("building_id")
  fromDay                 Int                    @map("from_day") // e.g., 1 (penalty starts from 1 day overdue)
  toDay                   Int?                   @map("to_day") // e.g., 5 (penalty applies from day 1 to 5). null means indefinite from fromDay.
  feeType                 PenaltyFeeType         @map("fee_type") // "Fixed" or "Percentage"
  feeValue                Float                  @map("fee_value") // Actual amount if Fixed, or percentage value (e.g., 2.5 for 2.5%)
  scope                   PenaltyScope           @default(Building) @map("scope") // "Building", "Floor", "SpecificSpaces"
  applicableFloor         String?                @map("applicable_floor") // if scope is "Floor"
  applicableSpaceIdNames  String[]               @map("applicable_space_id_names") // List of Space.spaceIdName - if scope is "SpecificSpaces"

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@map("penalty_tiers")
}

enum PenaltyFeeType {
  Fixed
  Percentage // Percentage of the bill's rentAmount or totalAmount (to be decided in logic)
}

enum PenaltyScope {
  Building // Default policy for the entire building
  Floor // Specific policy for a floor
  SpecificSpaces // Specific policy for one or more spaces
}
