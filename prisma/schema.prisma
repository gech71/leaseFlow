// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================
// Models
// ==============================================================

enum BuildingStatus {
  Pending
  Active
  Rejected
  Inactive
}

model Building {
  id                      String                     @id @default(cuid())
  name                    String                     @unique
  address                 String?
  accountNumber           String
  status                  BuildingStatus             @default(Pending)
  rejectionReason         String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  penaltyPolicyTiers      PenaltyTier[]
  createdById             String?
  createdBy               User?                      @relation("CreatedBuildings", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedById            String?
  approvedBy              User?                      @relation("ApprovedBuildings", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  managers                User[]                     @relation("ManagedBuildings")
}


model Space {
  id                    String      @id @default(cuid())
  buildingId            String
  buildingName          String
  spaceIdName           String
  area                  Decimal     @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal     @db.Decimal(5, 4) // e.g., 0.05 for 5%
  monthlyRentalPrice    Decimal     @db.Decimal(12, 2)
  isOccupied            Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  agreements            Agreement[]
  tenantId              String?     @unique
  tenant                Tenant?

  @@unique([buildingId, spaceIdName])
}

enum TenantStatus {
  Active
  Inactive
}

model Tenant {
  id                  String       @id @default(cuid())
  name                String
  email               String       @unique
  phone               String       @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  status              TenantStatus @default(Active)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  userId              String?      @unique
  user                User?        @relation("TenantProfile", fields: [userId], references: [id], onDelete: SetNull)
  agreements          Agreement[]
  bills               Bill[]
  rentedSpaceId       String?      @unique
  rentedSpace         Space?       @relation(fields: [rentedSpaceId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdById         String?
  createdBy           User?        @relation("CreatedTenants", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum AgreementStatus {
  Active
  Canceled
}

model Agreement {
  id                   String            @id @default(cuid())
  tenantId             String
  spaceId              String
  agreementTemplateId  String
  agreementText        String            @db.Text
  startDate            DateTime
  monthlyRentalPrice   Decimal           @db.Decimal(12, 2)
  additionalTerms      String?           @db.Text
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  paymentTermMonths    Int
  initialPaymentMonths Int
  nextPaymentDueDate   DateTime
  status               AgreementStatus   @default(Active)
  initialPaymentAmount Decimal?          @db.Decimal(12, 2)
  initialPaymentDate   DateTime?
  endDate              DateTime?
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space                Space             @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  agreementTemplate    AgreementTemplate @relation(fields: [agreementTemplateId], references: [id], onDelete: Restrict)
  bills                Bill[]
  arifPayments         ArifPayment[]
}


model AgreementTemplate {
  id          String      @id @default(cuid())
  name        String      @unique
  content     String      @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String?
  createdBy   User?       @relation("CreatedTemplates", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  Agreement   Agreement[]
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

model Bill {
  id                      String      @id @default(cuid())
  agreementId             String
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal     @db.Decimal(12, 2)
  utilityBreakdown        Json?
  penaltyAmount           Decimal?    @db.Decimal(12, 2)
  totalAmount             Decimal     @db.Decimal(12, 2)
  status                  BillStatus  @default(Pending)
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  paymentProofDataUri     String?
  tenantPaymentNotes      String?
  adminVerifiedPayment    Boolean?    @default(false)
  adminVerificationNotes  String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  arifPaymentId           String?
  agreement               Agreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ArifPayment             ArifPayment? @relation(fields: [arifPaymentId], references: [id])

  @@index([agreementId])
  @@index([tenantId])
}

model BuildingMonthlyUtilities {
  id           String                @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int // 0-11 for Jan-Dec
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  building     Building              @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  utilities    BuildingUtilityItem[]

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                      String                    @id @default(cuid())
  name                    String
  totalCost               Decimal                   @db.Decimal(12, 2)
  appliesToScope          String // Building, Floor, SpecificSpaces
  applicableFloor         String?
  applicableSpaceIdNames  String[]
  perSpaceAllocation      String?
  monthlyUtilitiesId      String?
  monthlyUtilities        BuildingMonthlyUtilities? @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

enum PenaltyFrequency {
  OneTime
  Daily
}

model PenaltyTier {
  id                   String           @id @default(cuid())
  fromDay              Int
  toDay                Int?
  penaltyType          String // Fixed, Percentage
  feeValue             Decimal          @db.Decimal(12, 2)
  scope                String // Building, Floor, SpecificSpaces
  applicableFloor      String?
  applicableSpaceIdNames String[]
  buildingId           String?
  building             Building?        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  frequency            PenaltyFrequency @default(OneTime)
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  name             String?
  firstName        String?
  lastName         String?
  phoneNumber      String              @unique
  password         String?
  tempPassword     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  createdById      String?
  createdBy        User?               @relation("CreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdUsers     User[]              @relation("CreatedBy")
  roles            Role[]
  managedBuildings Building[]          @relation("ManagedBuildings")
  createdBuildings Building[]          @relation("CreatedBuildings")
  approvedBuildings Building[]          @relation("ApprovedBuildings")
  createdTenants   Tenant[]            @relation("CreatedTenants")
  tenantProfile    Tenant?             @relation("TenantProfile")
  createdRoles     Role[]              @relation("CreatedRoles")
  createdTemplates AgreementTemplate[] @relation("CreatedTemplates")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  createdById String?
  createdBy   User?    @relation("CreatedRoles", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model RateLimit {
  identifier     String   @id
  attempts       Int      @default(1)
  firstAttemptAt DateTime @default(now())
}


model ArifPayment {
  id               String    @id @default(cuid())
  sessionId        String    @unique
  checkoutUrl      String
  totalAmount      Decimal
  status           String    @default("PENDING")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  agreementId      String
  billIds          String[]
  arifTransactionId String?
  agreement        Agreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  bills            Bill[]

  @@index([sessionId])
}
