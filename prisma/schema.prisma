// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- AUTHENTICATION & AUTHORIZATION ---
model User {
  id               String      @id @default(cuid())
  userId           String      @unique // This is the external ID from the identity provider
  email            String      @unique
  name             String
  firstName        String?
  lastName         String?
  phoneNumber      String?     @unique
  tempPassword     String?
  roles            Role[]      @relation(fields: [roleIds], references: [id])
  roleIds          String[]
  managedBuildings Building[]  @relation("ManagedByUser")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime?   @updatedAt
  tenant           Tenant?
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation(fields: [userIds], references: [id])
  userIds     String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- CORE BUSINESS MODELS ---
model Building {
  id                      String                    @id @default(cuid())
  name                    String                    @unique
  address                 String?
  penaltyPolicyTiers      PenaltyTier[]
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managedByUserId         String?
  manager                 User?                     @relation("ManagedByUser", fields: [managedByUserId], references: [userId])
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime?                 @updatedAt
}

model Space {
  id                    String      @id @default(cuid())
  buildingId            String
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingName          String      // Denormalized for easier display
  spaceIdName           String      // e.g., "Unit 10A"
  area                  Float       // in square meters
  floor                 String
  utilityProrationShare Float       // e.g., 0.1 for 10%
  monthlyRentalPrice    Float
  isOccupied            Boolean     @default(false)
  tenantId              String?     @unique
  tenant                Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements            Agreement[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime?   @updatedAt

  @@unique([buildingId, spaceIdName])
}

model Tenant {
  id                  String       @id @default(cuid())
  name                String
  email               String       @unique
  phone               String       @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  rentedSpaceId       String?      @unique
  rentedSpace         Space?
  agreements          Agreement[]
  bills               Bill[]
  userId              String?      @unique
  user                User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime?    @updatedAt
}


model Agreement {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaceId             String
  space               Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  agreementText       String
  startDate           DateTime
  endDate             DateTime?
  monthlyRentalPrice  Float
  paymentTermMonths   Int       // e.g. 12 for a year
  initialPaymentMonths Int      // e.g., 2 for two months upfront
  nextPaymentDueDate  DateTime
  additionalTerms     String?
  bills               Bill[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime? @updatedAt

  initialPaymentAmount         Float?
  initialPaymentMethod         String?
  initialPaymentReference      String?
  initialPaymentBankOrWalletName String?
  initialPaymentDate           DateTime?
}

model Bill {
  id                   String                 @id @default(cuid())
  agreementId          String
  agreement            Agreement              @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenantId             String
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billDate             DateTime
  dueDate              DateTime
  rentAmount           Float
  utilityBreakdown     Json?
  penaltyAmount        Float?
  totalAmount          Float
  status               BillStatus             @default(Pending)
  paymentDate          DateTime?
  paymentMethod        String?
  paymentReference     String?                // e.g. transaction ID, check number
  bankOrWalletName     String?                // e.g. CBE, Telebirr
  paymentProofUrl      String?
  adminVerifiedPayment Boolean?
  tenantPaymentNotes   String?
  adminVerificationNotes String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime?              @updatedAt
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification // When tenant has submitted payment proof, awaiting admin confirmation
}


// --- UTILITY & PENALTY MODELS ---
model BuildingMonthlyUtilities {
  id           String                  @id @default(cuid())
  buildingId   String
  building     Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingName String
  year         Int
  month        Int // 0-11 for Jan-Dec
  utilities    BuildingUtilityItem[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime?               @updatedAt

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                   String   @id @default(cuid())
  monthlyUtilitiesId   String
  monthlyUtilities     BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
  name                 String   // e.g., "Electricity", "Water", "Generator Fuel"
  totalCost            Float
  appliesToScope       UtilityScope @default(Building)
  applicableFloor      String?
  applicableSpaceIdNames String[]
}

enum UtilityScope {
  Building
  Floor
  SpecificSpaces
}

model PenaltyTier {
  id                     String   @id @default(cuid())
  buildingId             String
  building               Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  fromDay                Int
  toDay                  Int?
  feeType                PenaltyFeeType
  feeValue               Float
  scope                  PenaltyScope @default(Building)
  applicableFloor        String?
  applicableSpaceIdNames String[]
}

enum PenaltyFeeType {
  Fixed
  Percentage
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}
