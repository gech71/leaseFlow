// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                @id @default(cuid())
  userId              String                @unique
  email               String                @unique
  name                String?
  firstName           String?
  lastName            String?
  phoneNumber         String?               @unique
  password            String?
  tempPassword        String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  roles               Role[]                @relation("UserRoles")
  managedBuildings    Building[]
  createdById         String?
  createdBy           User?                 @relation("UserCreations", fields: [createdById], references: [id])
  createdUsers        User[]                @relation("UserCreations")
  createdAgreements   AgreementTemplate[]   @relation("CreatedTemplates")
  tenant              Tenant?               @relation("TenantProfile")
  disabledAgreements  DisabledAgreement[]
  failedLoginAttempts Int                   @default(0)
  lockedUntil         DateTime?
}

model Role {
  id           String    @id @default(cuid())
  name         String    @unique
  description  String?
  permissions  String[]
  users        User[]    @relation("UserRoles")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?
  createdBy    User?     @relation("CreatedRoles", fields: [createdById], references: [id])
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String      @unique
  alternativePhone    String?
  nationalId          String?     @unique
  representativeName  String?
  representativePhone String?
  rentedSpaceId       String?     @unique
  rentedSpace         Space?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User?       @relation("TenantProfile", fields: [userId], references: [id])
  userId              String?     @unique
  agreements          Agreement[]
  bills               Bill[]
  createdById         String?
  createdBy           User?       @relation("CreatedTenants", fields: [createdById], references: [id])
}

model Building {
  id                      String                     @id @default(cuid())
  name                    String                     @unique
  address                 String?
  accountNumber           String
  status                  BuildingStatus             @default(Active)
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  penaltyPolicyTiers      PenaltyTier[]
  managers                User[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
}

model Space {
  id                      String      @id @default(cuid())
  buildingId              String
  buildingName            String
  spaceIdName             String
  area                    Decimal
  floor                   String
  utilityProrationShare   Decimal
  monthlyRentalPrice      Decimal
  isOccupied              Boolean     @default(false)
  tenantId                String?     @unique
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  building                Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                  Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements              Agreement[]

  @@unique([buildingId, spaceIdName])
}

model Agreement {
  id                        String                @id @default(cuid())
  tenantId                  String
  spaceId                   String
  agreementText             String                @db.Text
  startDate                 DateTime
  monthlyRentalPrice        Decimal
  additionalTerms           String?               @db.Text
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  paymentTermMonths         Int
  initialPaymentMonths      Int
  nextPaymentDueDate        DateTime
  initialPaymentAmount      Decimal?
  initialPaymentMethod      String?
  initialPaymentReference   String?
  initialPaymentBankOrWalletName String?
  initialPaymentDate        DateTime?
  endDate                   DateTime?
  bills                     Bill[]
  tenant                    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space                     Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  disabledAgreements        DisabledAgreement[]
}

model Bill {
  id                      String      @id @default(cuid())
  agreementId             String
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal
  utilityBreakdown        Json?
  penaltyAmount           Decimal?
  totalAmount             Decimal
  status                  BillStatus  @default(Pending)
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  paymentProofUrl         String?
  paymentProofDataUri     String?
  adminVerifiedPayment    Boolean?    @default(false)
  tenantPaymentNotes      String?
  adminVerificationNotes  String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  agreement               Agreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict) // A bill should remain even if tenant is deleted for history
  arifPayments            ArifPayment[]
}

model BuildingMonthlyUtilities {
  id           String                  @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int
  utilities    BuildingUtilityItem[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  building     Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String                    @id @default(cuid())
  name                   String
  totalCost              Decimal
  appliesToScope         UtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilities       BuildingMonthlyUtilities  @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
  monthlyUtilitiesId     String
}

model PenaltyTier {
  id                     String       @id @default(cuid())
  buildingId             String
  fromDay                Int
  toDay                  Int?
  penaltyType            PenaltyType
  feeValue               Decimal
  frequency              PenaltyFrequency
  scope                  PenaltyScope @default(Building)
  applicableFloor        String?
  applicableSpaceIdNames String[]
  building               Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model Secret {
  key       String @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DisabledAgreement {
  agreementId   String
  disabledById  String
  disabledAt    DateTime  @default(now())
  agreement     Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  disabledBy    User      @relation(fields: [disabledById], references: [id], onDelete: Cascade)

  @@id([agreementId, disabledById])
}

model AgreementTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("CreatedTemplates", fields: [createdById], references: [id])
}

model ArifPayment {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  billId        String
  amount        Decimal
  status        String   @default("Pending")
  transactionId String?
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bill          Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
}

enum BuildingStatus {
  Active
  Inactive
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

enum PenaltyType {
  Fixed
  Percentage
}

enum UtilityScope {
  Building
  Floor
  SpecificSpaces
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}

enum PenaltyFrequency {
  OneTime
  Daily
}

enum TenantStatus {
  Active
  Inactive
}
