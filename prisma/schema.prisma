// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id                        String                     @id @default(uuid())
  name                      String                     @unique
  address                   String?
  accountNumber             String
  status                    BuildingStatus             @default(Active)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime?                  @updatedAt
  spaces                    Space[]
  penaltyPolicyTiers        PenaltyTier[]
  buildingMonthlyUtilities  BuildingMonthlyUtilities[]
  managers                  User[]                     @relation("ManagedBuildings")
  createdById               String?
  createdBy                 User?                      @relation(name: "CreatedBuildings", fields: [createdById], references: [id])

  @@index([name])
}

model Space {
  id                      String                 @id @default(uuid())
  buildingId              String
  buildingName            String
  spaceIdName             String
  area                    Decimal                @db.Decimal(10, 2)
  floor                   String
  utilityProrationShare   Decimal                @db.Decimal(5, 4) // e.g., 0.05 for 5%
  monthlyRentalPrice      Decimal                @db.Decimal(12, 2)
  isOccupied              Boolean                @default(false)
  tenantId                String?                @unique
  createdAt               DateTime               @default(now())
  updatedAt               DateTime?              @updatedAt
  building                Building               @relation(fields: [buildingId], references: [id], onDelete: Restrict) // Can't delete building with spaces
  tenant                  Tenant?                @relation(fields: [tenantId], references: [id])
  agreements              Agreement[]

  @@unique([buildingId, spaceIdName])
  @@index([buildingId])
  @@index([tenantId])
}

model Tenant {
  id                    String        @id @default(uuid())
  name                  String
  email                 String        @unique
  phone                 String        @unique
  alternativePhone      String?
  nationalId            String?       @unique
  representativeName    String?
  representativePhone   String?
  userId                String?       @unique
  rentedSpaceId         String?       @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime?     @updatedAt
  user                  User?         @relation(fields: [userId], references: [id])
  rentedSpace           Space?
  agreements            Agreement[]
  bills                 Bill[]
  createdById           String?
  createdBy             User?         @relation("CreatedTenants", fields: [createdById], references: [id])

  @@index([name])
  @@index([email])
  @@index([phone])
}

model Agreement {
  id                          String                @id @default(uuid())
  tenantId                    String
  spaceId                     String
  agreementText               String                @db.Text
  startDate                   DateTime
  monthlyRentalPrice          Decimal               @db.Decimal(12, 2)
  additionalTerms             String?               @db.Text
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime?             @updatedAt
  paymentTermMonths           Int
  initialPaymentMonths        Int
  nextPaymentDueDate          DateTime
  initialPaymentAmount        Decimal?              @db.Decimal(12, 2)
  initialPaymentDate          DateTime?
  endDate                     DateTime?
  tenant                      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space                       Space                 @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  bills                       Bill[]
  disabledAgreements          DisabledAgreement[]

  @@index([tenantId])
  @@index([spaceId])
}

model DisabledAgreement {
  id           String    @id @default(uuid())
  agreementId  String
  disabledById String
  disabledAt   DateTime  @default(now())
  agreement    Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  disabledBy   User      @relation(fields: [disabledById], references: [id], onDelete: Cascade)

  @@unique([agreementId, disabledById])
}

model Bill {
  id                      String                  @id @default(uuid())
  agreementId             String
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal                 @db.Decimal(12, 2)
  utilityBreakdown        Json?
  penaltyAmount           Decimal?                @db.Decimal(12, 2)
  totalAmount             Decimal                 @db.Decimal(12, 2)
  status                  BillStatus              @default(Pending)
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  paymentProofUrl         String?
  paymentProofDataUri     String?                 @db.Text
  adminVerifiedPayment    Boolean?                @default(false)
  tenantPaymentNotes      String?                 @db.Text
  adminVerificationNotes  String?                 @db.Text
  createdAt               DateTime                @default(now())
  updatedAt               DateTime?               @updatedAt
  arifPayment             ArifPayment?
  agreement               Agreement               @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([agreementId])
  @@index([tenantId])
  @@index([status])
}

model BuildingMonthlyUtilities {
  id          String                  @id @default(uuid())
  buildingId  String
  buildingName String
  year        Int
  month       Int
  createdAt   DateTime                @default(now())
  updatedAt   DateTime?               @updatedAt
  building    Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  utilities   BuildingUtilityItem[]

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                      String                    @id @default(uuid())
  name                    String
  totalCost               Decimal                   @db.Decimal(12, 2)
  appliesToScope          UtilityScope
  applicableFloor         String?
  applicableSpaceIdNames  String[]
  perSpacePercentages     String?                   @db.Text
  monthlyUtilitiesId      String
  monthlyUtilities        BuildingMonthlyUtilities  @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                      String       @id @default(uuid())
  buildingId              String
  fromDay                 Int
  toDay                   Int?
  penaltyType             PenaltyType
  feeValue                Decimal      @db.Decimal(10, 2)
  scope                   PenaltyScope
  applicableFloor         String?
  applicableSpaceIdNames  String[]
  frequency               PenaltyFrequency
  building                Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model User {
  id               String                @id @default(uuid())
  email            String                @unique
  name             String?
  firstName        String?
  lastName         String?
  password         String?
  tempPassword     String?
  phoneNumber      String                @unique
  createdAt        DateTime              @default(now())
  updatedAt        DateTime?             @updatedAt
  roles            Role[]                @relation("UserRoles")
  createdById      String?
  createdBy        User?                 @relation("CreatedUsers", fields: [createdById], references: [id], onDelete: SetNull)
  usersCreated     User[]                @relation("CreatedUsers")
  createdRoles     Role[]                @relation("CreatedRoles")
  createdBuildings Building[]            @relation("CreatedBuildings")
  createdTenants   Tenant[]              @relation("CreatedTenants")
  managedBuildings Building[]            @relation("ManagedBuildings")
  tenantProfile    Tenant?
  disabledAgreements DisabledAgreement[]
}

model Role {
  id              String      @id @default(uuid())
  name            String      @unique
  description     String?
  permissions     String[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime?   @updatedAt
  users           User[]      @relation("UserRoles")
  createdById     String?
  createdBy       User?       @relation("CreatedRoles", fields: [createdById], references: [id], onDelete: SetNull)
}

model AgreementTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
}


model Secret {
  key   String @id
  value String @db.Text
}

model RateLimit {
  id             String   @id @default(uuid())
  identifier     String   @unique
  attempts       Int      @default(1)
  firstAttemptAt DateTime @default(now())

  @@index([identifier])
}

model ArifPayment {
  id            String   @id @default(uuid())
  billId        String   @unique
  sessionId     String   @unique
  totalAmount   Decimal  @db.Decimal(12, 2)
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bill          Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}

enum UtilityScope {
  Building
  Floor
  SpecificSpaces
}

enum TenantStatus {
  Active
  Inactive
}

enum BuildingStatus {
  Active
  Inactive
}

enum PenaltyFrequency {
  Daily
  OneTime
}
