// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String              @id @default(cuid())
  userId                String              @unique // This will hold the ID from the external provider
  email                 String              @unique
  name                  String?
  firstName             String
  lastName              String
  phoneNumber           String              @unique
  password              String?
  tempPassword          String?
  failedLoginAttempts   Int                 @default(0)
  lockedUntil           DateTime?
  roles                 Role[]              @relation("UserRoles") // Explicitly named relation for many-to-many
  tenant                Tenant?             @relation("TenantProfile")
  managedBuildings      Building[]
  createdById           String?
  createdBy             User?               @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers          User[]              @relation("CreatedUsers")
  createdRoles          Role[]              @relation("CreatedRoles") // Opposite field for createdBy on Role
  createdTenants        Tenant[]            @relation("CreatedTenants") // Opposite field for createdBy on Tenant
  createdAgreementTemplates AgreementTemplate[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
  createdById String?
  createdBy   User?    @relation("CreatedRoles", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String      @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  rentedSpace         Space?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User?       @relation("TenantProfile", fields: [userId], references: [id])
  userId              String?     @unique
  agreements          Agreement[]
  bills               Bill[]
  createdById         String?
  createdBy           User?       @relation("CreatedTenants", fields: [createdById], references: [id])
}

model Building {
  id                 String                    @id @default(cuid())
  name               String                    @unique
  address            String?
  accountNumber      String
  status             BuildingStatus            @default(Active)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  spaces             Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  penaltyPolicyTiers PenaltyTier[]
  managers           User[]
}

model Space {
  id                    String     @id @default(cuid())
  spaceIdName           String
  area                  Decimal    @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal    @db.Decimal(5, 4)
  monthlyRentalPrice    Decimal    @db.Decimal(12, 2)
  isOccupied            Boolean    @default(false)
  buildingId            String
  buildingName          String
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  building              Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenantId              String?    @unique
  tenant                Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements            Agreement[]
}

model Agreement {
  id                          String      @id @default(cuid())
  tenantId                    String
  spaceId                     String
  agreementText               String      @db.Text
  startDate                   DateTime
  monthlyRentalPrice          Decimal     @db.Decimal(12, 2)
  additionalTerms             String?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime?   @updatedAt
  paymentTermMonths           Int
  initialPaymentMonths        Int
  nextPaymentDueDate          DateTime
  initialPaymentAmount        Decimal?    @db.Decimal(12, 2)
  initialPaymentMethod        String?
  initialPaymentReference     String?
  initialPaymentBankOrWalletName String?
  initialPaymentDate          DateTime?
  endDate                     DateTime?
  tenant                      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space                       Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  bills                       Bill[]
  disabledAgreements          DisabledAgreement[]

  @@index([tenantId])
  @@index([spaceId])
}

model Bill {
  id                       String      @id @default(cuid())
  agreementId              String
  tenantId                 String
  billDate                 DateTime
  dueDate                  DateTime
  rentAmount               Decimal     @db.Decimal(12, 2)
  utilityBreakdown         Json
  penaltyAmount            Decimal?    @db.Decimal(12, 2)
  totalAmount              Decimal     @db.Decimal(12, 2)
  status                   BillStatus  @default(Pending)
  paymentDate              DateTime?
  paymentMethod            String?
  paymentReference         String?
  paymentProofUrl          String?
  adminVerifiedPayment     Boolean?    @default(false)
  tenantPaymentNotes       String?
  adminVerificationNotes   String?
  arifPayments             ArifPayment[]
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  tenant                   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agreement                Agreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([agreementId])
  @@index([tenantId])
}

model BuildingMonthlyUtilities {
  id           String                  @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  utilities    BuildingUtilityItem[]
  building     Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                   String                  @id @default(cuid())
  name                 String
  totalCost            Decimal                 @db.Decimal(12, 2)
  appliesToScope       UtilityScope
  applicableFloor      String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId   String
  monthlyUtilities     BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                     String       @id @default(cuid())
  fromDay                Int
  toDay                  Int?
  penaltyType            PenaltyType
  feeValue               Decimal      @db.Decimal(12, 2)
  buildingId             String
  scope                  PenaltyScope
  frequency              PenaltyFrequency
  applicableFloor        String?
  applicableSpaceIdNames String[]
  building               Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model DisabledAgreement {
    agreementId   String
    disabledById  String
    disabledAt    DateTime   @default(now())
    agreement     Agreement  @relation(fields: [agreementId], references: [id], onDelete: Cascade)

    @@id([agreementId, disabledById])
}

model Secret {
  key   String @id
  value String
}

model AgreementTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  content     String   @db.Text
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ArifPayment {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  transactionId   String?
  status          ArifPaymentStatus
  billId          String
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bill            Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}


enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

enum BuildingStatus {
  Active
  Inactive
}

enum TenantStatus {
  Active
  Inactive
}

enum UtilityScope {
  Building
  Floor
  SpecificSpaces
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}

enum PenaltyFrequency {
  OneTime
  Daily
}

enum ArifPaymentStatus {
  Pending
  Success
  Failed
}
