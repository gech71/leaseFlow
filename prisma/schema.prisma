datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Building {
  id                 String    @id @default(cuid())
  name               String    @unique
  address            String?
  penaltyPolicyTiers PenaltyTier[]
  spaces             Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  createdAt          DateTime  @default(now())
}

model PenaltyTier {
  id                  String   @id @default(cuid())
  fromDay             Int
  toDay               Int?
  feeType             String // "Fixed" or "Percentage"
  feeValue            Float
  scope               String // "Building", "Floor", "SpecificSpaces"
  applicableFloor     String?
  applicableSpaceIdNames String[] @default([])

  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId String
}

model Space {
  id                    String    @id @default(cuid())
  buildingName          String    // Denormalized for easier display
  spaceIdName           String    // e.g., "Unit 10A", "Office 201"
  area                  Float
  floor                 String
  utilityProrationShare Float     // e.g., 0.1 for 10%
  monthlyRentalPrice    Float
  isOccupied            Boolean   @default(false)
  createdAt             DateTime  @default(now())

  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId String

  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantId String? @unique // A space can only have one tenant

  agreements Agreement[]
}

model Tenant {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  phone               String?
  alternativePhone    String?
  nationalId          String?   @unique
  representativeName  String?
  representativePhone String?
  createdAt           DateTime  @default(now())

  rentedSpace   Space? // Relation field for the space this tenant rents
  agreements    Agreement[]
  bills         Bill[]
}

model Agreement {
  id                  String    @id @default(cuid())
  agreementText       String    @db.Text
  startDate           DateTime
  monthlyRentalPrice  Float
  additionalTerms     String?
  createdAt           DateTime  @default(now())
  paymentTermMonths   Int
  initialPaymentMonths Int
  nextPaymentDueDate  DateTime

  initialPaymentAmount           Float?
  initialPaymentMethod           String?
  initialPaymentReference        String?
  initialPaymentBankOrWalletName String?
  initialPaymentDate             DateTime?

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String // Foreign key
  space    Space  @relation(fields: [spaceId], references: [id], onDelete:Restrict) // Prevent deleting space if active agreement exists
  spaceId  String // Foreign key

  bills Bill[]

  @@unique([tenantId, spaceId, startDate], name: "unique_agreement_tenant_space_start")
}

model BuildingUtilityItem {
  id                  String   @id @default(cuid())
  name                String
  totalCost           Float
  appliesToScope      String   // "Building", "Floor", "SpecificSpaces"
  applicableFloor     String?
  applicableSpaceIdNames String[] @default([])

  monthlyUtilities   BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
  monthlyUtilitiesId String
}

model BuildingMonthlyUtilities {
  id           String    @id @default(cuid())
  buildingName String    // Denormalized for easier lookup
  year         Int
  month        Int       // 0-11 for Jan-Dec
  utilities    BuildingUtilityItem[]
  createdAt    DateTime  @default(now())

  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId String

  @@unique([buildingId, year, month])
}

model Bill {
  id                  String    @id @default(cuid())
  billDate            DateTime
  dueDate             DateTime
  rentAmount          Float
  penaltyAmount       Float?
  totalAmount         Float
  status              String    // "Pending", "Paid", "Overdue", "Pending Verification"
  paymentDate         DateTime?
  paymentMethod       String?
  paymentReference    String?
  bankOrWalletName    String?
  paymentProofUrl     String?
  adminVerifiedPayment Boolean?
  tenantPaymentNotes  String?
  adminVerificationNotes String?

  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  agreementId String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String

  utilityBreakdown UtilityBreakdownItem[]
}

model UtilityBreakdownItem {
  id       String @id @default(cuid())
  name     String
  amount   Float
  bill     Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId   String
}