// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id                      String                     @id @default(cuid())
  name                    String
  address                 String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  penaltyPolicyTiers      PenaltyTier[]
  managers                User[]                     @relation("BuildingManagers")

  @@map("buildings")
}

model Space {
  id                   String      @id @default(cuid())
  buildingId           String
  buildingName         String
  spaceIdName          String
  area                 Float
  floor                String
  utilityProrationShare Float
  monthlyRentalPrice   Float
  isOccupied           Boolean     @default(false)
  tenantId             String?     @unique
  createdAt            DateTime    @default(now())
  updatedAt            DateTime?   @updatedAt
  tenant               Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  building             Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  agreements           Agreement[]

  @@unique([buildingId, spaceIdName])
  @@map("spaces")
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String      @unique
  alternativePhone    String?
  nationalId          String?     @unique
  representativeName  String?
  representativePhone String?
  userId              String?     @unique // Link to the User model
  user                User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rentedSpaceId       String?     @unique
  rentedSpace         Space?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime?   @updatedAt
  agreements          Agreement[]
  bills               Bill[]

  @@map("tenants")
}

model Agreement {
  id                           String     @id @default(cuid())
  tenantId                     String
  spaceId                      String
  agreementText                String
  startDate                    DateTime
  monthlyRentalPrice           Float
  paymentTermMonths          Int
  initialPaymentMonths         Int
  nextPaymentDueDate           DateTime
  endDate                      DateTime?
  additionalTerms              String?
  initialPaymentAmount         Float?
  initialPaymentMethod         String?
  initialPaymentReference      String?
  initialPaymentBankOrWalletName String?
  initialPaymentDate           DateTime?
  createdAt                    DateTime   @default(now())
  updatedAt                    DateTime?  @updatedAt
  tenant                       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space                        Space      @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  bills                        Bill[]

  @@map("agreements")
}

model Bill {
  id                       String                 @id @default(cuid())
  agreementId              String
  tenantId                 String
  billDate                 DateTime
  dueDate                  DateTime
  rentAmount               Float
  utilityBreakdown         Json?
  penaltyAmount            Float?
  totalAmount              Float
  status                   BillStatus             @default(Pending)
  paymentDate              DateTime?
  paymentMethod            String?
  paymentReference         String?
  bankOrWalletName         String?
  paymentProofUrl          String?
  adminVerifiedPayment     Boolean?
  tenantPaymentNotes       String?
  adminVerificationNotes   String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime?              @updatedAt
  agreement                Agreement              @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant                   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("bills")
}

model BuildingMonthlyUtilities {
  id             String                 @id @default(cuid())
  buildingId     String
  buildingName   String
  year           Int
  month          Int
  createdAt      DateTime               @default(now())
  updatedAt      DateTime?              @updatedAt
  utilities      BuildingUtilityItem[]
  building       Building               @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
  @@map("building_monthly_utilities")
}

model BuildingUtilityItem {
  id                      String                  @id @default(cuid())
  name                    String
  totalCost               Float
  appliesToScope          UtilityScope
  applicableFloor         String?
  applicableSpaceIdNames  String[]
  monthlyUtilitiesId      String
  monthlyUtilities        BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
  
  @@map("building_utility_items")
}

model PenaltyTier {
  id                      String      @id @default(cuid())
  buildingId              String
  fromDay                 Int
  toDay                   Int?
  feeType                 FeeType
  feeValue                Float
  scope                   PenaltyScope
  applicableFloor         String?
  applicableSpaceIdNames  String[]
  building                Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  
  @@map("penalty_tiers")
}

model User {
  id               String     @id @default(cuid())
  userId           String     @unique // From external auth provider (e.g., JWT sub)
  email            String     @unique
  name             String?
  firstName        String?
  lastName         String?
  phoneNumber      String?    @unique
  tempPassword     String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime?  @updatedAt
  roles            Role[]     @relation("UserRoles")
  managedBuildings Building[] @relation("BuildingManagers")
  tenant           Tenant?

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")

  @@map("roles")
}


enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

enum UtilityScope {
  Building
  Floor
  SpecificSpaces
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}

enum FeeType {
  Fixed
  Percentage
}
