// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id                      String                    @id @default(uuid())
  name                    String                    @unique
  address                 String?
  accountNumber           String                    @unique
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime?                 @updatedAt
  spaces                  Space[]
  penaltyPolicyTiers      PenaltyTier[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                User[]                    @relation("BuildingManagers")
}

model Space {
  id                    String      @id @default(uuid())
  buildingId            String
  buildingName          String
  spaceIdName           String // e.g., "Unit 101", "Office 2B"
  area                  Decimal     @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal     @db.Decimal(5, 4) // e.g., 0.05 for 5%
  monthlyRentalPrice    Decimal     @db.Decimal(12, 2)
  isOccupied            Boolean     @default(false)
  tenantId              String?     @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime?   @updatedAt
  tenant                Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  agreements            Agreement[]
}

model Tenant {
  id                  String      @id @default(uuid())
  name                String
  email               String      @unique
  phone               String      @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  userId              String      
  rentedSpaceId       String?     @unique
  createdAt           DateTime    @default(now())
  updatedAt           DateTime?   @updatedAt
  user                User        @relation(fields: [userId], references: [userId], onDelete: Cascade)
  rentedSpace         Space?      
  agreements          Agreement[]
  bills               Bill[]
}

model Agreement {
  id                    String    @id @default(uuid())
  tenantId              String
  spaceId               String
  agreementText         String    @db.Text
  startDate             DateTime
  monthlyRentalPrice    Decimal   @db.Decimal(12, 2)
  additionalTerms       String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime? @updatedAt
  paymentTermMonths     Int
  initialPaymentMonths  Int
  nextPaymentDueDate    DateTime
  initialPaymentAmount  Decimal?  @db.Decimal(12, 2)
  initialPaymentDate    DateTime?
  endDate               DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space  Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  bills  Bill[]
}

model Bill {
  id                    String    @id @default(uuid())
  agreementId           String
  tenantId              String
  billDate              DateTime
  dueDate               DateTime
  rentAmount            Decimal   @db.Decimal(12, 2)
  utilityBreakdown      Json?
  penaltyAmount         Decimal?  @db.Decimal(12, 2)
  totalAmount           Decimal   @db.Decimal(12, 2)
  status                BillStatus
  paymentDate           DateTime?
  paymentMethod         String?
  paymentReference      String?
  bankOrWalletName      String?
  paymentProofUrl       String?
  tenantPaymentNotes    String?
  adminVerifiedPayment  Boolean?
  adminVerificationNotes String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime? @updatedAt

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum BillStatus {
  Pending
  Paid
  Overdue
}

model BuildingMonthlyUtilities {
  id            String                  @id @default(uuid())
  buildingId    String
  buildingName  String
  year          Int
  month         Int // 0-11 for Jan-Dec
  utilities     BuildingUtilityItem[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime?               @updatedAt
  building      Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String    @id @default(uuid())
  name                   String
  totalCost              Decimal   @db.Decimal(12, 2)
  appliesToScope         String // Building, Floor, SpecificSpaces
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String?
  monthlyUtilities       BuildingMonthlyUtilities? @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                     String    @id @default(uuid())
  buildingId             String
  fromDay                Int
  toDay                  Int?
  penaltyType            String // Fixed, Percentage
  feeValue               Decimal   @db.Decimal(12, 2)
  scope                  String // Building, Floor, SpecificSpaces
  applicableFloor        String?
  applicableSpaceIdNames String[]
  frequency              String // OneTime, Daily

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model User {
  id               String      @id @default(uuid())
  userId           String      @unique // This is the external ID from the identity provider
  email            String      @unique
  name             String?
  firstName        String?
  lastName         String?
  phoneNumber      String?     @unique
  createdAt        DateTime    @default(now())
  updatedAt        DateTime?   @updatedAt
  tempPassword     String?
  roles            Role[]      @relation("UserRoles")
  createdById      String?
  createdBy        User?       @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers     User[]      @relation("UserCreator")
  createdRoles     Role[]      @relation("RoleCreator")
  managedBuildings Building[]  @relation("BuildingManagers")
  tenants          Tenant[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
  users       User[]   @relation("UserRoles")
  createdById String?
  createdBy   User?    @relation("RoleCreator", fields: [createdById], references: [id], onDelete: SetNull)
}

model Secret {
  key       String    @id
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model AgreementTemplate {
    id        String   @id @default(uuid())
    name      String   @unique
    content   String   @db.Text
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model ArifPayment {
  id              String    @id @default(uuid())
  sessionId       String    @unique
  status          String // Pending, Success, Failed, Canceled, Expired
  amount          Decimal   @db.Decimal(12, 2)
  paymentUrl      String?
  transactionId   String?
  paymentMethod   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime? @updatedAt
  
  billId          String    @unique
  bill            Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
}