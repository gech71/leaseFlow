// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- CORE MODELS ---
model Building {
  id                       String                     @id @default(cuid())
  name                     String                     @unique
  address                  String?
  accountNumber            String
  status                   BuildingStatus             @default(Active)
  penaltyPolicyTiers       PenaltyTier[]
  spaces                   Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                 User[]                     @relation(name: "BuildingManagers")

  // Creator relationship
  createdById              String?
  createdBy                User?                      @relation("BuildingCreatedBy", fields: [createdById], references: [id])

  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@index([createdById])
}

model Space {
  id                    String    @id @default(cuid())
  buildingId            String
  buildingName          String
  spaceIdName           String
  area                  Decimal   @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal   @db.Decimal(5, 4)
  monthlyRentalPrice    Decimal   @db.Decimal(12, 2)
  isOccupied            Boolean   @default(false)
  tenantId              String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime? @updatedAt

  building   Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant     Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements Agreement[]

  @@unique([buildingId, spaceIdName])
  @@index([tenantId])
}

model Tenant {
  id                  String       @id @default(cuid())
  name                String
  email               String       @unique
  phone               String       @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  rentedSpaceId       String?      @unique
  userId              String?      @unique
  createdAt           DateTime     @default(now())
  updatedAt           DateTime?    @updatedAt
  status              TenantStatus @default(Active)

  rentedSpace Space?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  agreements  Agreement[]
  bills       Bill[]

  createdById String?
  createdBy   User?   @relation(name: "TenantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdById])
}

model Agreement {
  id                 String       @id @default(cuid())
  tenantId           String
  spaceId            String
  agreementText      String       @db.Text
  startDate          DateTime
  monthlyRentalPrice Decimal      @db.Decimal(12, 2)
  additionalTerms    String?      @db.Text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime?    @updatedAt
  paymentTermMonths  Int
  initialPaymentMonths Int
  nextPaymentDueDate DateTime
  
  initialPaymentAmount Decimal? @db.Decimal(12, 2)
  initialPaymentDate   DateTime?

  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  space              Space                @relation(fields: [spaceId], references: [id])
  bills              Bill[]
  disabledAgreements DisabledAgreement[]

  @@index([tenantId])
  @@index([spaceId])
}


model Bill {
  id                  String      @id @default(cuid())
  agreementId         String
  tenantId            String
  billDate            DateTime
  dueDate             DateTime
  rentAmount          Decimal     @db.Decimal(12, 2)
  utilityBreakdown    Json
  penaltyAmount       Decimal?    @db.Decimal(12, 2)
  totalAmount         Decimal     @db.Decimal(12, 2)
  status              BillStatus  @default(Pending)
  paymentDate         DateTime?
  paymentMethod       String?
  paymentReference    String?
  paymentProofUrl     String? // For file-based proofs
  paymentProofDataUri String? @db.Text // For direct data URI proofs
  adminVerifiedPayment Boolean    @default(false)
  tenantPaymentNotes   String?    @db.Text
  adminVerificationNotes String?  @db.Text
  createdAt           DateTime    @default(now())
  updatedAt           DateTime?   @updatedAt

  agreement Agreement @relation(fields: [agreementId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  ArifPayment ArifPayment[]

  @@index([agreementId])
  @@index([tenantId])
}

enum TenantStatus {
  Active
  Inactive
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}


// --- UTILITY & CONFIGURATION MODELS ---

model BuildingMonthlyUtilities {
  id           String                 @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int
  createdAt    DateTime               @default(now())
  updatedAt    DateTime?              @updatedAt
  building     Building               @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  utilities    BuildingUtilityItem[]

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String                  @id @default(cuid())
  name                   String
  totalCost              Decimal                 @db.Decimal(12, 2)
  appliesToScope         BuildingUtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

enum BuildingUtilityScope {
  Building
  Floor
  SpecificSpaces
}

model PenaltyTier {
  id                     String         @id @default(cuid())
  fromDay                Int
  toDay                  Int?
  penaltyType            PenaltyType
  frequency              PenaltyFrequency
  feeValue               Decimal        @db.Decimal(10, 2) // Either a fixed amount or a percentage
  scope                  PenaltyScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  buildingId             String
  building               Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId])
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}

enum PenaltyFrequency {
    OneTime
    Daily
}

// --- AUTH & RBAC MODELS ---

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  name                  String?
  firstName             String?
  lastName              String?
  phoneNumber           String?               @unique
  password              String?
  tempPassword          String?
  failedLoginAttempts   Int                   @default(0)
  lockedUntil           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime?             @updatedAt

  roles                 Role[]
  createdUsers          User[]                @relation("UserCreatedBy")
  createdBy             User?                 @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById           String?

  createdRoles          Role[]                @relation(name: "RoleCreatedBy")
  createdTenants        Tenant[]              @relation(name: "TenantCreatedBy")
  createdAgreements     AgreementTemplate[]
  createdBuildings      Building[]            @relation("BuildingCreatedBy")
  
  managedBuildings      Building[]            @relation(name: "BuildingManagers")
  
  DisabledAgreement     DisabledAgreement[]

  @@index([createdById])
}


model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]

  users       User[]

  createdById String?
  createdBy   User?   @relation(name: "RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}


model Secret {
  key   String @id
  value String @db.Text
}

model AgreementTemplate {
    id        String   @id @default(cuid())
    name      String   @unique
    content   String   @db.Text
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    
    createdById String
    createdBy   User     @relation(fields: [createdById], references: [id])

    @@index([createdById])
}

// Model for soft-deactivating agreements per user
model DisabledAgreement {
  agreementId  String
  disabledById String
  
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  disabledBy  User      @relation(fields: [disabledById], references: [id], onDelete: Cascade)

  @@id([agreementId, disabledById])
  @@index([agreementId])
  @@index([disabledById])
}

model ArifPayment {
  id           String      @id @default(cuid())
  billId       String      
  sessionId    String      @unique
  amount       Decimal     @db.Decimal(12, 2)
  status       String      @default("Pending") // Pending, Success, Failed
  transactionId String?
  paymentMethod String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime?   @updatedAt

  bill         Bill        @relation(fields: [billId], references: [id])

  @@index([billId])
}
