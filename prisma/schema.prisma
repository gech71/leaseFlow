// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User and authentication models
model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  name                String?
  firstName           String?
  lastName            String?
  phoneNumber         String?               @unique
  password            String?
  tempPassword        String?
  failedLoginAttempts Int                   @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime?             @updatedAt
  roles               Role[]
  createdById         String?
  createdBy           User?                 @relation("UserCreations", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers        User[]                @relation("UserCreations")
  createdRoles        Role[]                @relation("RoleCreations")
  createdTenants      Tenant[]              @relation("TenantCreations")
  tenant              Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId            String?               @unique
  createdAgreements   AgreementTemplate[]
  managedBuildings    Building[]            @relation("BuildingManagers")
  DisabledAgreement   DisabledAgreement[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
  createdById String?
  createdBy   User?    @relation("RoleCreations", fields: [createdById], references: [id], onDelete: SetNull)
}

// Core business models
model Building {
  id                      String                     @id @default(cuid())
  name                    String                     @unique
  address                 String?
  accountNumber           String
  status                  BuildingStatus             @default(Active)
  penaltyPolicyTiers      PenaltyTier[]
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime?                  @updatedAt
  managers                User[]                     @relation("BuildingManagers")
}

model Space {
  id                    String      @id @default(cuid())
  buildingId            String
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingName          String
  spaceIdName           String
  area                  Decimal     @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal     @default(0) @db.Decimal(5, 4) // e.g., 0.05 for 5%
  monthlyRentalPrice    Decimal     @db.Decimal(12, 2)
  isOccupied            Boolean     @default(false)
  tenantId              String?     @unique
  tenant                Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements            Agreement[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime?   @updatedAt

  @@unique([buildingId, spaceIdName])
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String      @unique
  alternativePhone    String?
  nationalId          String?     @unique
  representativeName  String?
  representativePhone String?
  userId              String?     @unique
  user                User?
  rentedSpaceId       String?     @unique
  rentedSpace         Space?      @relation(fields: [rentedSpaceId], references: [id], onDelete: SetNull)
  agreements          Agreement[]
  bills               Bill[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime?   @updatedAt
  createdById         String?
  createdBy           User?       @relation("TenantCreations", fields: [createdById], references: [id], onDelete: SetNull)
}

model Agreement {
  id                       String               @id @default(cuid())
  tenantId                 String
  tenant                   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaceId                  String
  space                    Space                @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  agreementText            String
  startDate                DateTime
  paymentTermMonths        Int
  initialPaymentMonths     Int                  @default(1)
  nextPaymentDueDate       DateTime
  monthlyRentalPrice       Decimal              @db.Decimal(12, 2)
  additionalTerms          String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime?            @updatedAt
  endDate                  DateTime?
  initialPaymentAmount     Decimal?             @db.Decimal(12, 2)
  initialPaymentDate       DateTime?
  bills                    Bill[]
  disabledAgreements       DisabledAgreement[]
}

model DisabledAgreement {
  agreementId  String
  disabledById String
  agreement    Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  disabledBy   User      @relation(fields: [disabledById], references: [id], onDelete: Cascade)

  @@id([agreementId, disabledById])
}

model Bill {
  id                     String                 @id @default(cuid())
  agreementId            String
  agreement              Agreement              @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenantId               String
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billDate               DateTime
  dueDate                DateTime
  rentAmount             Decimal                @db.Decimal(12, 2)
  utilityBreakdown       Json?
  penaltyAmount          Decimal?               @db.Decimal(12, 2)
  totalAmount            Decimal                @db.Decimal(12, 2)
  status                 BillStatus             @default(Pending)
  paymentDate            DateTime?
  paymentMethod          String?
  paymentReference       String?
  paymentProofUrl        String?
  paymentProofDataUri    String?
  adminVerifiedPayment   Boolean?
  tenantPaymentNotes     String?
  adminVerificationNotes String?
  arifPayments           ArifPayment[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime?              @updatedAt

  @@index([status])
  @@index([dueDate])
}

model BuildingMonthlyUtilities {
  id           String                  @id @default(cuid())
  buildingId   String
  building     Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingName String
  year         Int
  month        Int // 0-11 for Jan-Dec
  utilities    BuildingUtilityItem[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime?               @updatedAt

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String                   @id @default(cuid())
  name                   String // e.g., "Electricity", "Water"
  totalCost              Decimal                  @db.Decimal(12, 2)
  appliesToScope         UtilityScope
  applicableFloor        String? // Used if scope is 'Floor'
  applicableSpaceIdNames String[] // Used if scope is 'SpecificSpaces'
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                     String       @id @default(cuid())
  buildingId             String
  building               Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  fromDay                Int // Penalty starts from this day
  toDay                  Int? // Penalty ends on this day (inclusive). Null means indefinitely.
  penaltyType            PenaltyType
  frequency              PenaltyFrequency
  feeValue               Decimal      @db.Decimal(12, 2) // Either a fixed amount or a percentage
  scope                  PenaltyScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
}

model Secret {
  key   String @id
  value String
}

model AgreementTemplate {
  id          String    @id @default(cuid())
  name        String    @unique
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
}

model ArifPayment {
  id              String     @id @default(cuid())
  billId          String
  bill            Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  sessionId       String     @unique // The unique ID for the ArifPay checkout session
  transactionId   String? // The final transaction ID from ArifPay after completion
  status          ArifPayStatus @default(Pending)
  amount          Decimal    @db.Decimal(12, 2)
  paymentMethod   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// Enums
enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

enum BuildingStatus {
  Active
  Inactive
}

enum TenantStatus {
  Active
  Inactive
}

enum UtilityScope {
  Building
  Floor
  SpecificSpaces
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyFrequency {
  OneTime
  Daily
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}

enum ArifPayStatus {
  Pending
  Success
  Failed
  Cancelled
  Expired
}
