// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id                      String                    @id @default(cuid())
  name                    String
  address                 String?
  accountNumber           String                    @unique
  penaltyPolicyTiers      PenaltyTier[]
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                User[]                    @relation("ManagedBuildings")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime?                 @updatedAt
}

model Space {
  id                    String      @id @default(cuid())
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId            String
  buildingName          String
  spaceIdName           String
  area                  Decimal     @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal     @db.Decimal(5, 4)
  monthlyRentalPrice    Decimal     @db.Decimal(12, 2)
  isOccupied            Boolean     @default(false)
  tenant                Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantId              String?     @unique
  agreements            Agreement[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime?   @updatedAt
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String?     @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  userId              String?     @unique
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  rentedSpace         Space?
  agreements          Agreement[]
  bills               Bill[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime?   @updatedAt
}

model Agreement {
  id                                String    @id @default(cuid())
  tenant                              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId                            String
  space                               Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId                             String
  agreementText                       String
  startDate                           DateTime
  endDate                             DateTime?
  monthlyRentalPrice                  Decimal   @db.Decimal(12, 2)
  additionalTerms                     String?
  paymentTermMonths                 Int       @default(12)
  initialPaymentMonths              Int       @default(1)
  nextPaymentDueDate                  DateTime
  initialPaymentAmount                Decimal?  @db.Decimal(12, 2)
  initialPaymentMethod              String?
  initialPaymentReference           String?
  initialPaymentBankOrWalletName    String?
  initialPaymentDate                  DateTime?
  createdAt                           DateTime  @default(now())
  updatedAt                           DateTime? @updatedAt
  bills                               Bill[]
}

model Bill {
  id                      String      @id @default(cuid())
  agreement               Agreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  agreementId             String
  tenant                  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal     @db.Decimal(12, 2)
  utilityBreakdown        Json?
  penaltyAmount           Decimal?    @db.Decimal(12, 2)
  totalAmount             Decimal     @db.Decimal(12, 2)
  status                  BillStatus
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  bankOrWalletName        String?
  paymentProofUrl         String?
  adminVerifiedPayment    Boolean?    @default(false)
  tenantPaymentNotes      String?
  adminVerificationNotes  String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime?   @updatedAt
  arifPayments            ArifPayment[]
}

model BuildingMonthlyUtilities {
  id            String                  @id @default(cuid())
  building      Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId    String
  buildingName  String
  year          Int
  month         Int
  utilities     BuildingUtilityItem[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime?               @updatedAt

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String                    @id @default(cuid())
  name                   String
  totalCost              Decimal                   @db.Decimal(12, 2)
  appliesToScope         UtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilities       BuildingMonthlyUtilities? @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
  monthlyUtilitiesId     String?
}

model PenaltyTier {
  id                     String       @id @default(cuid())
  building               Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId             String
  fromDay                Int
  toDay                  Int?
  feeType                PenaltyType
  feeValue               Decimal      @db.Decimal(12, 2)
  scope                  PenaltyScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
}

model User {
  id               String     @id @default(cuid())
  userId           String     @unique // External ID from identity provider
  email            String     @unique
  name             String
  firstName        String?
  lastName         String?
  phoneNumber      String?    @unique
  tempPassword     String?
  roles            Role[]     @relation("UserRoles")
  managedBuildings Building[] @relation("ManagedBuildings")
  tenants          Tenant[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime?  @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
}

model Secret {
  key   String @id
  value String
}

model AgreementTemplate {
  id      String   @id @default(cuid())
  name    String   @unique
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArifPayment {
  id              String    @id @default(cuid())
  sessionId       String    @unique
  transactionId   String?
  status          String    // e.g., 'Pending', 'Success', 'Failed'
  amount          Decimal   @db.Decimal(12, 2)
  paymentUrl      String
  paymentMethod   String?
  bill            Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}


enum UtilityScope {
  Building
  Floor
  SpecificSpaces
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}
