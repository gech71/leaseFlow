datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum FeeType {
  Fixed
  Percentage
}

enum ScopeType {
  Building
  Floor
  SpecificSpaces
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

model User {
  id               String      @id @default(cuid())
  userId           String      @unique
  email            String      @unique
  name             String
  firstName        String?
  lastName         String?
  phoneNumber      String?
  roles            Role[]      @relation("UserRoles")
  managedBuildings Building[]  @relation("ManagedBuildings")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime?   @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
}

model Building {
  id                       String                     @id @default(cuid())
  name                     String
  address                  String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime?                  @updatedAt
  spaces                   Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  penaltyPolicyTiers       PenaltyTier[]

  managedByUserId String?
  manager         User?   @relation("ManagedBuildings", fields: [managedByUserId], references: [userId])
}

model Space {
  id                    String      @id @default(cuid())
  buildingId            String
  buildingName          String
  spaceIdName           String
  area                  Float
  floor                 String
  utilityProrationShare Float       @default(0)
  monthlyRentalPrice    Float
  isOccupied            Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime?   @updatedAt

  building   Building    @relation(fields: [buildingId], references: [id])
  tenantId   String?     @unique
  tenant     Tenant?     @relation(name: "TenantRentedSpace", fields: [tenantId], references: [id])
  agreements Agreement[]
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String
  phone               String?
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime?   @updatedAt

  rentedSpaceId String?     @unique
  rentedSpace   Space?      @relation(name: "TenantRentedSpace")
  agreements    Agreement[]
  bills         Bill[]
}

model Agreement {
  id                           String    @id @default(cuid())
  agreementText                String    @db.Text
  startDate                    DateTime
  monthlyRentalPrice           Float
  paymentTermMonths            Int
  initialPaymentMonths         Int
  nextPaymentDueDate           DateTime
  additionalTerms              String?   @db.Text
  endDate                      DateTime?
  initialPaymentAmount         Float?
  initialPaymentMethod         String?
  initialPaymentReference      String?
  initialPaymentBankOrWalletName String?
  initialPaymentDate           DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id])

  bills Bill[]
}

model Bill {
  id                     String     @id @default(cuid())
  billDate               DateTime
  dueDate                DateTime
  rentAmount             Float
  utilityBreakdown       Json?
  penaltyAmount          Float?
  totalAmount            Float
  status                 BillStatus
  paymentDate            DateTime?
  paymentMethod          String?
  paymentReference       String?
  bankOrWalletName       String?
  paymentProofUrl        String?
  adminVerifiedPayment   Boolean?   @default(false)
  tenantPaymentNotes     String?
  adminVerificationNotes String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime?  @updatedAt

  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id])

  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
}

model BuildingMonthlyUtilities {
  id           String                @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int
  createdAt    DateTime              @default(now())
  updatedAt    DateTime?             @updatedAt
  building     Building              @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  utilities    BuildingUtilityItem[]

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String                   @id @default(cuid())
  name                   String
  totalCost              Float
  appliesToScope         ScopeType
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

model PenaltyTier {
  id                     String    @id @default(cuid())
  fromDay                Int
  toDay                  Int?
  feeType                FeeType
  feeValue               Float
  scope                  ScopeType
  applicableFloor        String?
  applicableSpaceIdNames String[]

  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}
