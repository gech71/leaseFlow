
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  name                 String
  firstName            String
  lastName             String
  phoneNumber          String     @unique
  password             String?
  tempPassword         String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime?  @updatedAt
  roles                Role[]     @relation("UserRoles")
  managedBuildings     Building[] @relation("BuildingManagers")
  createdById          String?
  createdBy            User?      @relation("UserCreations", fields: [createdById], references: [id])
  createdUsers         User[]     @relation("UserCreations")
  createdRoles         Role[]
  createdTenants       Tenant[]   @relation("CreatedTenants")
  createdAgreementTemp AgreementTemplate[]
  tenantProfile        Tenant?    @relation("TenantProfile")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model Building {
  id                      String                     @id @default(cuid())
  name                    String                     @unique
  address                 String?
  accountNumber           String
  status                  BuildingStatus             @default(Active)
  penaltyPolicyTiers      PenaltyTier[]
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                User[]                     @relation("BuildingManagers")
  createdBy               User                       @relation(fields: [createdById], references: [id])
  createdById             String
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime?                  @updatedAt
}

enum BuildingStatus {
  Active
  Inactive
}

model Space {
  id                    String      @id @default(cuid())
  buildingId            String
  buildingName          String
  spaceIdName           String
  area                  Decimal     @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal     @db.Decimal(5, 4)
  monthlyRentalPrice    Decimal     @db.Decimal(12, 2)
  isOccupied            Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime?   @updatedAt
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenantId              String?     @unique
  tenant                Tenant?     @relation(fields: [tenantId], references: [id])
  agreements            Agreement[]

  @@unique([buildingId, spaceIdName])
}

model Tenant {
  id                  String       @id @default(cuid())
  name                String
  email               String       @unique
  phone               String       @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  rentedSpaceId       String?      @unique
  rentedSpace         Space?       @relation(fields: [rentedSpaceId], references: [id])
  createdAt           DateTime     @default(now())
  updatedAt           DateTime?    @updatedAt
  userId              String?      @unique
  user                User?        @relation("TenantProfile", fields: [userId], references: [id])
  agreements          Agreement[]
  bills               Bill[]
  createdById         String?
  createdBy           User?        @relation("CreatedTenants", fields: [createdById], references: [id])
  arifPayments        ArifPayment[]
}

model Agreement {
  id                     String                @id @default(cuid())
  tenantId               String
  spaceId                String
  agreementText          String                @db.Text
  startDate              DateTime
  monthlyRentalPrice     Decimal               @db.Decimal(12, 2)
  additionalTerms        String?               @db.Text
  createdAt              DateTime              @default(now())
  updatedAt              DateTime?             @updatedAt
  paymentTermMonths      Int
  initialPaymentMonths   Int
  nextPaymentDueDate     DateTime
  initialPaymentAmount   Decimal?              @db.Decimal(12, 2)
  initialPaymentDate     DateTime?
  endDate                DateTime?
  tenant                 Tenant                @relation(fields: [tenantId], references: [id])
  space                  Space                 @relation(fields: [spaceId], references: [id])
  bills                  Bill[]
  disabledAgreements     DisabledAgreement[]
  ArifPayment            ArifPayment[]
}

model Bill {
  id                      String        @id @default(cuid())
  agreementId             String
  tenantId                String
  billDate                DateTime
  dueDate                 DateTime
  rentAmount              Decimal       @db.Decimal(12, 2)
  utilityBreakdown        Json?
  penaltyAmount           Decimal?      @db.Decimal(12, 2)
  totalAmount             Decimal       @db.Decimal(12, 2)
  status                  BillStatus    @default(Pending)
  paymentDate             DateTime?
  paymentMethod           String?
  paymentReference        String?
  paymentProofUrl         String?
  adminVerifiedPayment    Boolean?      @default(false)
  tenantPaymentNotes      String?
  adminVerificationNotes  String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime?     @updatedAt
  agreement               Agreement     @relation(fields: [agreementId], references: [id])
  tenant                  Tenant        @relation(fields: [tenantId], references: [id])
  paymentProofDataUri     String?       @db.Text
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

model BuildingMonthlyUtilities {
  id           String                @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int
  utilities    BuildingUtilityItem[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime?             @updatedAt
  building     Building              @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String                   @id @default(cuid())
  name                   String
  totalCost              Decimal                  @db.Decimal(12, 2)
  appliesToScope         UtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  perSpaceAllocation     String?
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

enum UtilityScope {
  Building
  Floor
  SpecificSpaces
}

model PenaltyTier {
  id                     String       @id @default(cuid())
  fromDay                Int
  toDay                  Int?
  penaltyType            PenaltyType
  feeValue               Decimal      @db.Decimal(10, 2)
  scope                  PenaltyScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  frequency              PenaltyFrequency @default(OneTime)
  buildingId             String
  building               Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}

enum PenaltyFrequency {
  Daily
  OneTime
}

model DisabledAgreement {
    id String @id @default(cuid())
    agreementId String
    disabledById String
    agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
    
    @@unique([agreementId, disabledById])
}

model RateLimit {
  identifier String @unique
  attempts Int
  firstAttemptAt DateTime
}

model AgreementTemplate {
  id String @id @default(cuid())
  name String @unique
  content String @db.Text
  createdById String
  createdBy User @relation(fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArifPayment {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  paymentId   String?  @unique
  status      String   @default("Pending")
  amount      Float
  billId      String?
  agreementId String?
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agreement   Agreement? @relation(fields: [agreementId], references: [id])
  tenant      Tenant?    @relation(fields: [tenantId], references: [id])
}
