// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(cuid())
  userId             String     @unique
  email              String     @unique
  name               String?
  firstName          String?
  lastName           String?
  phoneNumber        String?    @unique
  password           String?
  tempPassword       String?    @map("temp_password")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil        DateTime?  @map("locked_until")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime?  @updatedAt
  roles              Role[]
  managedBuildings   Building[] @relation("BuildingManagers")
  createdUsers       User[]     @relation("UserCreations")
  creator            User?      @relation("UserCreations", fields: [createdById], references: [id])
  createdById        String?
  createdTenants     Tenant[]   @relation("TenantCreations")
  createdTemplates   AgreementTemplate[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdById String?
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String?     @unique
  alternativePhone    String?
  nationalId          String?     @unique
  representativeName  String?
  representativePhone String?
  userId              String?     @unique
  user                User?       @relation(fields: [userId], references: [id])
  rentedSpaceId       String?     @unique
  rentedSpace         Space?      @relation(fields: [rentedSpaceId], references: [id])
  agreements          Agreement[]
  bills               Bill[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime?   @updatedAt
  createdBy           User?       @relation("TenantCreations", fields: [createdById], references: [id])
  createdById         String?
}

enum BuildingStatus {
  Active
  Inactive
}

model Building {
  id                      String                     @id @default(cuid())
  name                    String                     @unique
  address                 String?
  accountNumber           String
  status                  BuildingStatus             @default(Active)
  penaltyPolicyTiers      PenaltyTier[]
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                User[]                     @relation("BuildingManagers")
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime?                  @updatedAt
}

model Space {
  id                    String      @id @default(cuid())
  buildingId            String
  buildingName          String
  spaceIdName           String
  area                  Decimal     @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal     @db.Decimal(5, 4) // e.g. 0.05 for 5%
  monthlyRentalPrice    Decimal     @db.Decimal(12, 2)
  isOccupied            Boolean     @default(false)
  tenantId              String?
  tenant                Tenant?
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  agreements            Agreement[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime?   @updatedAt

  @@unique([buildingId, spaceIdName])
}

model Agreement {
  id                   String        @id @default(cuid())
  tenantId             String
  spaceId              String
  agreementText        String        @db.Text
  startDate            DateTime
  monthlyRentalPrice   Decimal       @db.Decimal(12, 2)
  additionalTerms      String?       @db.Text
  createdAt            DateTime      @default(now())
  updatedAt            DateTime?     @updatedAt
  paymentTermMonths    Int
  initialPaymentMonths Int
  nextPaymentDueDate   DateTime
  bills                Bill[]
  tenant               Tenant        @relation(fields: [tenantId], references: [id])
  space                Space         @relation(fields: [spaceId], references: [id])
  disabledAgreements   DisabledAgreement[]
  initialPaymentAmount Decimal?      @db.Decimal(12, 2)
  initialPaymentDate   DateTime?
  endDate              DateTime?
}

// Model to track which admin has disabled which agreement
model DisabledAgreement {
  id           String    @id @default(cuid())
  agreementId  String
  disabledById String
  agreement    Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  disabledBy   User      @relation(fields: [disabledById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@unique([agreementId, disabledById])
}

enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

model Bill {
  id                     String      @id @default(cuid())
  agreementId            String
  tenantId               String
  billDate               DateTime
  dueDate                DateTime
  rentAmount             Decimal     @db.Decimal(12, 2)
  utilityBreakdown       Json?
  penaltyAmount          Decimal?    @db.Decimal(12, 2)
  totalAmount            Decimal     @db.Decimal(12, 2)
  status                 BillStatus  @default(Pending)
  paymentDate            DateTime?
  paymentMethod          String?
  paymentReference       String?
  bankOrWalletName       String?
  paymentProofDataUri    String?     @db.Text
  adminVerifiedPayment   Boolean?    @default(false)
  tenantPaymentNotes     String?
  adminVerificationNotes String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime?   @updatedAt
  agreement              Agreement   @relation(fields: [agreementId], references: [id])
  tenant                 Tenant      @relation(fields: [tenantId], references: [id])
  arifPayments           ArifPayment[]

  @@index([status])
}

model BuildingMonthlyUtilities {
  id           String                 @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int // 0-11 for Jan-Dec
  utilities    BuildingUtilityItem[]
  building     Building               @relation(fields: [buildingId], references: [id])
  createdAt    DateTime               @default(now())
  updatedAt    DateTime?              @updatedAt

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String    @id @default(cuid())
  name                   String
  totalCost              Decimal   @db.Decimal(12, 2)
  appliesToScope         String    // "Building", "Floor", "SpecificSpaces"
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String
  monthlyUtilities       BuildingMonthlyUtilities @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)

  @@index([monthlyUtilitiesId])
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyFrequency {
  OneTime
  Daily
}

model PenaltyTier {
  id                     String           @id @default(cuid())
  buildingId             String
  building               Building         @relation(fields: [buildingId], references: [id])
  fromDay                Int
  toDay                  Int?
  penaltyType            PenaltyType
  feeValue               Decimal          @db.Decimal(10, 2)
  scope                  String           // "Building", "Floor", "SpecificSpaces"
  applicableFloor        String?
  applicableSpaceIdNames String[]
  frequency              PenaltyFrequency @default(OneTime)
}

model ArifPayment {
  id            String    @id @default(cuid())
  sessionId     String    @unique
  transactionId String?
  status        String // e.g., 'Pending', 'Success', 'Failed'
  billId        String
  paymentMethod String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bill          Bill      @relation(fields: [billId], references: [id])
}

model Secret {
  key   String @id
  value String
}

model AgreementTemplate {
  id          String    @id @default(cuid())
  name        String    @unique
  content     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
}
