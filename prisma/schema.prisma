
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id                      String                    @id @default(cuid())
  name                    String
  address                 String?
  accountNumber           String                    
  penaltyPolicyTiers      PenaltyTier[]
  spaces                  Space[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                User[]                    @relation("BuildingManagers")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime?                 @updatedAt
}

model Space {
  id                    String      @id @default(cuid())
  building              Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId            String
  buildingName          String // Denormalized for easier access
  spaceIdName           String
  area                  Decimal     @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal     @db.Decimal(5, 4) // e.g., 0.05 for 5%
  monthlyRentalPrice    Decimal     @db.Decimal(12, 2)
  isOccupied            Boolean     @default(false)
  tenant                Tenant?     @relation("TenantSpaces", fields: [tenantId], references: [id])
  tenantId              String?     @unique
  agreements            Agreement[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime?   @updatedAt

  @@unique([buildingId, spaceIdName])
}

model Tenant {
  id                  String       @id @default(cuid())
  name                String
  email               String       @unique
  phone               String?      @unique
  alternativePhone    String?
  nationalId          String?
  representativeName  String?
  representativePhone String?
  user                User?        @relation(fields: [userId], references: [id])
  userId              String?      @unique
  rentedSpace         Space?       @relation("TenantSpaces")
  agreements          Agreement[]
  bills               Bill[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime?    @updatedAt
  createdBy           User?        @relation("UserCreatedTenants", fields: [createdById], references: [id])
  createdById         String?
}


model Agreement {
  id                   String    @id @default(cuid())
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId             String
  space                Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId              String
  agreementText        String    @db.Text
  startDate            DateTime
  monthlyRentalPrice   Decimal   @db.Decimal(12, 2)
  additionalTerms      String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime? @updatedAt
  paymentTermMonths    Int
  initialPaymentMonths Int
  nextPaymentDueDate   DateTime
  endDate              DateTime?

  initialPaymentAmount           Decimal?  @db.Decimal(12, 2)
  initialPaymentMethod           String?
  initialPaymentReference        String?
  initialPaymentBankOrWalletName String?
  initialPaymentDate             DateTime?

  bills Bill[]
}

model Bill {
  id                   String    @id @default(cuid())
  agreement            Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  agreementId          String
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId             String
  billDate             DateTime
  dueDate              DateTime
  rentAmount           Decimal   @db.Decimal(12, 2)
  utilityBreakdown     Json?
  penaltyAmount        Decimal?  @db.Decimal(12, 2)
  totalAmount          Decimal   @db.Decimal(12, 2)
  status               BillStatus
  paymentDate          DateTime?
  paymentMethod        String?
  paymentReference     String?
  bankOrWalletName     String?
  paymentProofUrl      String?   @db.Text
  adminVerifiedPayment Boolean?  @default(false)
  tenantPaymentNotes   String?   @db.Text
  adminVerificationNotes String? @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime? @updatedAt
  ArifPayment          ArifPayment[]
}

model ArifPayment {
  id              String      @id @default(cuid())
  sessionId       String      @unique
  transactionId   String?
  status          String
  amount          Decimal     @db.Decimal(12, 2)
  paymentUrl      String
  bill            Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId          String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime?   @updatedAt
}

enum BillStatus {
  Pending
  Paid
  Overdue
}

model BuildingMonthlyUtilities {
  id           String                 @id @default(cuid())
  building     Building               @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId   String
  buildingName String // Denormalized name
  year         Int
  month        Int // 0-11 for Jan-Dec
  utilities    BuildingUtilityItem[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime?              @updatedAt

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String                    @id @default(cuid())
  name                   String
  totalCost              Decimal                   @db.Decimal(12, 2)
  appliesToScope         UtilityScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilities       BuildingMonthlyUtilities? @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
  monthlyUtilitiesId     String?
}

enum UtilityScope {
  Building
  Floor
  SpecificSpaces
}

model PenaltyTier {
  id                     String       @id @default(cuid())
  building               Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId             String
  fromDay                Int
  toDay                  Int?
  penaltyType            PenaltyType
  frequency              PenaltyFrequency
  feeValue               Decimal      @db.Decimal(12, 2)
  scope                  PenaltyScope
  applicableFloor        String?
  applicableSpaceIdNames String[]
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyFrequency {
  OneTime
  Daily
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}

model User {
  id                       String              @id @default(cuid())
  userId                   String              @unique
  email                    String              @unique
  name                     String?
  firstName                String?
  lastName                 String?
  phoneNumber              String?             @unique
  tempPassword             String?
  roles                    Role[]
  managedBuildings         Building[]          @relation("BuildingManagers")
  createdAt                DateTime            @default(now())
  updatedAt                DateTime?           @updatedAt
  createdAgreementTemplates AgreementTemplate[] @relation("UserCreatedTemplates")
  createdBy                User?               @relation("UserCreator", fields: [createdById], references: [id])
  createdById              String?
  createdUsers             User[]              @relation("UserCreator")
  createdTenants           Tenant[]            @relation("UserCreatedTenants")
}


model Role {
  id          String    @id @default(cuid())
  name        String
  description String?
  permissions String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  users       User[]
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdById String?

  @@unique([name, createdById])
}


model Secret {
  key       String    @id
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model AgreementTemplate {
  id          String    @id @default(cuid())
  name        String    @unique
  content     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   User?     @relation("UserCreatedTemplates", fields: [createdById], references: [id])
  createdById String?
}
