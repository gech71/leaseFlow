// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(cuid())
  userId           String       @unique
  email            String       @unique
  name             String?
  firstName        String?
  lastName         String?
  phoneNumber      String?      @unique
  password         String?
  tempPassword     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime?    @updatedAt
  roles            Role[]
  managedBuildings Building[]
  createdUsers     User[]       @relation("UserCreator")
  createdBy        User?        @relation("UserCreator", fields: [createdById], references: [id])
  createdById      String?
  createdRoles     Role[]       @relation("RoleCreator")
  createdTenants   Tenant[]     @relation("TenantCreator")
  disabledAgreements DisabledAgreement[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
  createdById String?
  createdBy   User?    @relation("RoleCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Secret {
  key   String @id
  value String
}

enum BuildingStatus {
  Active
  Inactive
}

model Building {
  id                      String                    @id @default(cuid())
  name                    String                    @unique
  address                 String?
  accountNumber           String                    @unique
  status                  BuildingStatus            @default(Active)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime?                 @updatedAt
  spaces                  Space[]
  penaltyPolicyTiers      PenaltyTier[]
  buildingMonthlyUtilities BuildingMonthlyUtilities[]
  managers                User[]
}

model Space {
  id                    String                   @id @default(cuid())
  buildingId            String
  buildingName          String
  spaceIdName           String
  area                  Decimal                  @db.Decimal(10, 2)
  floor                 String
  utilityProrationShare Decimal                  @db.Decimal(5, 4)
  monthlyRentalPrice    Decimal                  @db.Decimal(12, 2)
  isOccupied            Boolean                  @default(false)
  tenantId              String?                  @unique
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime?                @updatedAt
  building              Building                 @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant                Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agreements            Agreement[]
  utilityAllocations    UtilityAllocationRule[]

  @@unique([buildingId, spaceIdName])
}

model Tenant {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phone               String?     @unique
  alternativePhone    String?
  nationalId          String?     @unique
  representativeName  String?
  representativePhone String?
  userId              String      @unique
  rentedSpaceId       String?     @unique
  createdAt           DateTime    @default(now())
  updatedAt           DateTime?   @updatedAt
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdById         String?
  createdBy           User?       @relation("TenantCreator", fields: [createdById], references: [id])
  rentedSpace         Space?
  agreements          Agreement[]
  bills               Bill[]
}

model Agreement {
  id                       String    @id @default(cuid())
  tenantId                 String
  spaceId                  String
  agreementText            String
  startDate                DateTime
  monthlyRentalPrice       Decimal   @db.Decimal(12, 2)
  additionalTerms          String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime? @updatedAt
  paymentTermMonths        Int
  initialPaymentMonths     Int
  nextPaymentDueDate       DateTime
  initialPaymentAmount     Decimal?  @db.Decimal(12, 2)
  initialPaymentMethod     String?
  initialPaymentReference  String?
  initialPaymentBankOrWalletName String?
  initialPaymentDate       DateTime?
  endDate                  DateTime?
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space                    Space     @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  bills                    Bill[]
  disabledAgreements       DisabledAgreement[]
}

// Model to track which admin has disabled which agreement
model DisabledAgreement {
    id String @id @default(cuid())
    agreementId String
    disabledById String

    agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
    disabledBy User @relation(fields: [disabledById], references: [id], onDelete: Cascade)

    @@unique([agreementId, disabledById])
}


enum BillStatus {
  Pending
  Paid
  Overdue
  PendingVerification
}

model Bill {
  id                String      @id @default(cuid())
  agreementId       String
  tenantId          String
  billDate          DateTime
  dueDate           DateTime
  rentAmount        Decimal     @db.Decimal(12, 2)
  utilityBreakdown  Json
  penaltyAmount     Decimal?    @db.Decimal(12, 2)
  totalAmount       Decimal     @db.Decimal(12, 2)
  status            BillStatus
  paymentDate       DateTime?
  paymentMethod     String?
  paymentReference  String?
  bankOrWalletName  String?
  paymentProofUrl   String?
  paymentProofDataUri String?
  adminVerifiedPayment Boolean? @default(false)
  tenantPaymentNotes String?
  adminVerificationNotes String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime?   @updatedAt
  agreement         Agreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  arifPayments      ArifPayment[]
}

model BuildingMonthlyUtilities {
  id           String    @id @default(cuid())
  buildingId   String
  buildingName String
  year         Int
  month        Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt
  building     Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  utilities    BuildingUtilityItem[]

  @@unique([buildingId, year, month])
}

model BuildingUtilityItem {
  id                     String    @id @default(cuid())
  name                   String
  totalCost              Decimal   @db.Decimal(12, 2)
  appliesToScope         String // e.g., 'Building', 'Floor', 'SpecificSpaces'
  applicableFloor        String?
  applicableSpaceIdNames String[]
  monthlyUtilitiesId     String?
  monthlyUtilities       BuildingMonthlyUtilities? @relation(fields: [monthlyUtilitiesId], references: [id], onDelete: Cascade)
}

enum PenaltyScope {
  Building
  Floor
  SpecificSpaces
}

enum PenaltyType {
  Fixed
  Percentage
}

enum PenaltyFrequency {
    OneTime
    Daily
}

model PenaltyTier {
  id                     String           @id @default(cuid())
  buildingId             String
  fromDay                Int
  toDay                  Int?
  penaltyType            PenaltyType
  frequency              PenaltyFrequency @default(OneTime)
  feeValue               Decimal          @db.Decimal(10, 2)
  scope                  PenaltyScope     @default(Building)
  applicableFloor        String?
  applicableSpaceIdNames String[]
  building               Building         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model UtilityAllocationRule {
  id             String @id @default(cuid())
  spaceId        String
  utilityName    String
  percentage     Decimal @db.Decimal(5, 4)
  space          Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, utilityName])
}

model AgreementTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String
  createdBy User @relation(fields: [createdById], references: [id])
}

model ArifPayment {
  id             String    @id @default(cuid())
  billId         String
  sessionId      String    @unique
  transactionId  String?
  amount         Decimal   @db.Decimal(12, 2)
  status         String    @default("Pending") // Pending, Success, Failed, Canceled, Expired
  paymentMethod  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bill           Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
}
